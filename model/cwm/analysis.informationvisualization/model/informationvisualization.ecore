      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&quot;Composite&quot; RenderedObjects referencing &quot;component&quot; RenderedObjects." />
      </eAnnotations>
    </eStructuralFeatures>
