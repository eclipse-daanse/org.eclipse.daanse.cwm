        <details key="documentation" value="RenderedObjects referencing this RenderedObject as its &quot;neighbor&quot;." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="renderedObjectSet" ordered="false" lowerBound="1" eType="#//RenderedObjectSet" transient="true" eOpposite="#//RenderedObjectSet/renderedObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="RenderedObjectSet owning this RenderedObject. CWM 1.1 association RenderedObjectSetOwnsRenderedObjects." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rendering" ordered="false" upperBound="-1" eType="#//Rendering" eOpposite="#//Rendering/renderedObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Renderings available for this RenderedObject. CWM 1.1 association RenderedObjectsReferenceRenderings." />
