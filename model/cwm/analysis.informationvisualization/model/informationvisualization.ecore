  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RenderedObjectSet" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="RenderedObjectSet is a container of RenderedObjects and available Renderings." />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rendering" ordered="false" upperBound="-1" eType="#//Rendering" containment="true" eOpposite="#//Rendering/renderedObjectSet">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Renderings owned by a RenderedObjectSet." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="renderedObject" ordered="false" upperBound="-1" eType="#//RenderedObject" containment="true" eOpposite="#//RenderedObject/renderedObjectSet">
