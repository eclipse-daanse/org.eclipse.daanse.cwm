          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="parentAttribute" lowerBound="1" eType="ecore:EClass http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute">
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
