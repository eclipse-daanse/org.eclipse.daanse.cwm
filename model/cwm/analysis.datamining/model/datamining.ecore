      <eClassifiers xsi:type="ecore:EClass" name="CategoryMatrixObject" eSuperTypes="#//miningcore/miningdata/CategoryMatrix">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The object representation of CategoryMatrix. Each object references a set of CategoryMatrixEntry objects." />
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EReference" name="entry" ordered="false" upperBound="-1" eType="#//miningcore/miningdata/CategoryMatrixEntry" containment="true">
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
            <details key="Property.oppositeRoleName" value="categoryMatrix" />
          </eAnnotations>
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
