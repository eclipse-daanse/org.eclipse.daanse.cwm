      <eClassifiers xsi:type="ecore:EClass" name="CategoryMatrix" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A CategoryMatrix assigns numeric values to pairs of categories.&#10;It is either represented as a set of CategoryMatrixEntries or as a table." />
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="diagonalDefault" lowerBound="1" eType="#//miningcore/miningdata/Double" defaultValueLiteral="1.0">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="If a matrix cell in the diagonal is not specified use this value." />
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="offDiagonalDefault" lowerBound="1" eType="#//miningcore/miningdata/Double" defaultValueLiteral="0.0">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="If a matrix cell not in the diagonal is not specified use this value." />
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//miningcore/miningdata/MatrixProperty" defaultValueLiteral="mp_any">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Type of matrix, 'diagonal', 'symmetric', or 'any'.&#10;If diagonal, then all values outside the diagonal are 0.&#10;If symmetric then value(i,j)=value(j,i)." />
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="category" ordered="false" lowerBound="2" upperBound="-1" eType="#//miningcore/miningdata/Category">
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
            <details key="Property.oppositeRoleName" value="categoryMatrix" />
          </eAnnotations>
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
            <details key="body" value="categoryMatrix" />
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="CategoryMatrixEntry" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Defines the value of a single cell in a CategoryMatrix." />
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="#//miningcore/miningdata/Double">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Value of a cell. It overwrites any default value in CategoryMatrix.&#10;For Cost matrix, value is intended to be a double. For ConfusionMatrix, the value can be either a &quot;count&quot; which is an integer value, or a &quot;percentage&quot; which is a double value. This is up to the implementation." />
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="columnIndex" lowerBound="1" eType="#//miningcore/miningdata/Category">
