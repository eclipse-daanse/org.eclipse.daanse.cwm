            <details key="Property.oppositeRoleName" value="categoryEntry" />
          </eAnnotations>
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
            <details key="body" value="categoryEntry" />
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="rowIndex" lowerBound="1" eType="#//miningcore/miningdata/Category">
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
            <details key="Property.oppositeRoleName" value="categoryEntry" />
          </eAnnotations>
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
            <details key="body" value="categoryEntry" />
          </eAnnotations>
        </eStructuralFeatures>
