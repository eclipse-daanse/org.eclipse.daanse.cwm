      <eClassifiers xsi:type="ecore:EClass" name="CategoryMapObjectEntry" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Object representation of an edge in the categorization graph. This is analogous to a record in the CategoryMapTable. Each entry consists of child, parent, level and graphId attributes. If isItemMap is TRUE then the child attribute corresponds to item values." />
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="graphId" lowerBound="1" eType="ecore:EDataType http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Any">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="The graphId attribute identifies the graph to which this entry belongs and enables representing multiple categorization graphs in the same table. " />
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="child" lowerBound="1" eType="#//miningcore/miningdata/Category">
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
            <details key="Property.oppositeRoleName" value="entry" />
          </eAnnotations>
          <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
            <details key="body" value="entry" />
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="parent" ordered="false" lowerBound="1" upperBound="-1" eType="#//miningcore/miningdata/Category">
