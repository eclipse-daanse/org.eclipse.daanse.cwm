# The standard set of the SQL types needs emf/standard and typemapping only when it is built or loaded: the model
# resolves without them.
Import-Package: org.eclipse.daanse.cwm.emf.standard*;resolution:=optional,\
    org.eclipse.daanse.cwm.model.cwm.foundation.typemapping*;resolution:=optional,\
    *
