  <eClassifiers xsi:type="ecore:EClass" name="Concept" eSuperTypes="#//VocabularyElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ConceptSelfReference" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="ConceptSelfReference" value="self.relatedConcept-&gt;forAll ( p | p &lt;&gt; self )" />
    </eAnnotations>
    <eAnnotations source="http://www.omg.org/spec/CWM/1.1/constraints">
      <details key="ConceptSelfReference.shortName" value="C-1" />
      <details key="ConceptSelfReference.name" value="Concept Self-Reference" />
      <details key="ConceptSelfReference.description" value="A Concept may not relate to itself." />
      <details key="ConceptSelfReference.level" value="error" />
      <details key="ConceptSelfReference.specSource" value="self.relatedConcept-&gt;forAll ( p | p &lt;&gt; self )" />
      <details key="RelatedConceptsDerivation.shortName" value="C-8" />
      <details key="RelatedConceptsDerivation.name" value="RelatedConcepts Derivation" />
      <details key="RelatedConceptsDerivation.description" value="The RelatedConcepts association is derived from the RelatedVocabularyElements association. All ends of the RelatedConcepts association must be Concepts." />
      <details key="RelatedConceptsDerivation.level" value="error" />
      <details key="RelatedConceptsDerivation.specSource" value="RelatedVocabularyElements.allInstances.select( element.oclIsKindOf(&#10;Concept ) and relatedElement.oclIsKindOf( Concept ) )" />
      <details key="RelatedConceptsDerivation.postDescription" value="Not executable. The specification states this derivation in terms of the base association RelatedVocabularyElements, whose end &quot;relatedElement&quot; carries no Model:Reference on either side and is therefore absent from the MOF API and from Ecore alike - see the note on C-7. The restriction the constraint expresses (all ends must be Concepts) is already guaranteed structurally: Concept::relatedConcept is typed Concept, so a non-Concept cannot be linked through it." />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This represents a business idea or notion. &#10;&#10;Concepts are represented by Terms. Users use Terms that are familiar to them in their business environment to refer to Concepts." />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedConcept" ordered="false" upperBound="-1" eType="#//Concept">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="concept" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="concept" />
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the related Concepts." />
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Term" eSuperTypes="#//VocabularyElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TermSelfReference" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="TermSelfReference" value="self.relatedTerm-&gt;forAll ( p | p &lt;&gt; self )" />
    </eAnnotations>
    <eAnnotations source="http://www.omg.org/spec/CWM/1.1/constraints">
      <details key="TermSelfReference.shortName" value="C-6" />
      <details key="TermSelfReference.name" value="Term Self-Reference" />
      <details key="TermSelfReference.description" value="A Term may not relate to itself." />
      <details key="TermSelfReference.level" value="error" />
      <details key="TermSelfReference.specSource" value="self.relatedTerm-&gt;forAll ( p | p &lt;&gt; self )" />
      <details key="RelatedTermsDerivation.shortName" value="C-9" />
      <details key="RelatedTermsDerivation.name" value="RelatedTerms Derivation" />
      <details key="RelatedTermsDerivation.description" value="The RelatedTerms association is derived from the RelatedVocabularyElements association. All ends of the RelatedTerms association must be Terms." />
      <details key="RelatedTermsDerivation.level" value="error" />
      <details key="RelatedTermsDerivation.specSource" value="RelatedVocabularyElements.allInstances.select( element.oclIsKindOf( Term&#10;) and relatedElement.oclIsKindOf( Term ) )" />
      <details key="RelatedTermsDerivation.postDescription" value="Not executable. The specification states this derivation in terms of the base association RelatedVocabularyElements, whose end &quot;relatedElement&quot; carries no Model:Reference on either side and is therefore absent from the MOF API and from Ecore alike - see the note on C-7. The restriction the constraint expresses (all ends must be Terms) is already guaranteed structurally: Term::relatedTerm is typed Term, so a non-Term cannot be linked through it." />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This represents words or phrases used by business users to refer to Concepts.&#10;&#10;A Term has a definition in a specific context. The context is provided by the referenced Concept that describes the underlying semantics." />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="concept" ordered="false" upperBound="-1" eType="#//Concept">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="term" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="term" />
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the Concepts from which the Term is derived." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedTerm" ordered="false" upperBound="-1" eType="#//Term">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="term" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="term" />
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the related Terms." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="preferredTerm" eType="#//Term">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="synonym" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="synonym" />
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the preferred term for the synonym." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="narrowerTerm" ordered="false" upperBound="-1" eType="#//Term">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="widerTerm" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
