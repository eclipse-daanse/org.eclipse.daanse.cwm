    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="schema" lowerBound="1" eType="#//Schema" transient="true" eOpposite="#//Schema/dimensionedObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Schema owning DimensionedObjects." />
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
