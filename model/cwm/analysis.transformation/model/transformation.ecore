    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="body" lowerBound="1" eType="ecore:EClass http://www.omg.org/spec/CWM/1.1/foundation/expressions#//ExpressionNode" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the expression tree that embodies the TransformationTree." />
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ClassifierMap" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Namespace">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This represents a mapping of source Classifiers to target Classifiers. A ClassifierMap may consists of a group of ClassifierFeatureMaps and/or FeatureMaps." />
    </eAnnotations>
    <eAnnotations source="http://www.omg.org/spec/CWM/1.1/constraints">
      <details key="ClassifierFeatureMapDerivation.shortName" value="C-4" />
      <details key="ClassifierFeatureMapDerivation.name" value="ClassifierFeatureMap Derivation" />
      <details key="ClassifierFeatureMapDerivation.description" value="The ClassifierMapToCFMap association is derived from the Namespace-ModelElement association. All ownedElement ends of the association must be ClassifierFeatureMaps." />
      <details key="ClassifierFeatureMapDerivation.level" value="error" />
      <details key="ClassifierFeatureMapDerivation.specSource" value="Namespace-ModelElement.allInstances.select( ownedElement.oclIsKindOf( ClassifierFeatureMap ) )" />
      <details key="ClassifierFeatureMapDerivation.postDescription" value="-- in Ecore strukturell garantiert: cfMap ist eine eigene, typisierte Containment-Referenz. Die Spec formuliert dies als Ableitung der Assoziation ClassifierMapToCFMap von Namespace-ModelElement (ElementOwnership); diese Ableitung existiert in Ecore nicht, da ein Element nur in einer Containment-Referenz liegen kann." />
      <details key="FeatureMapDerivation.shortName" value="C-5" />
      <details key="FeatureMapDerivation.name" value="FeatureMap Derivation" />
      <details key="FeatureMapDerivation.description" value="The ClassifierMapToFeatureMap association is derived from the Namespace-ModelElement association. All ownedElement ends of the association must be FeatureMaps." />
      <details key="FeatureMapDerivation.level" value="error" />
      <details key="FeatureMapDerivation.specSource" value="Namespace-ModelElement.allInstances.select( ownedElement.oclIsKindOf( FeatureMap ) )" />
      <details key="FeatureMapDerivation.postDescription" value="-- in Ecore strukturell garantiert: featureMap ist eine eigene, typisierte Containment-Referenz. Die Spec formuliert dies als Ableitung der Assoziation ClassifierMapToFeatureMap von Namespace-ModelElement (ElementOwnership); diese Ableitung existiert in Ecore nicht, da ein Element nur in einer Containment-Referenz liegen kann." />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="function" lowerBound="1" eType="ecore:EClass http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ProcedureExpression" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Any code or script for the ClassifierMap." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="functionDescription" lowerBound="1" eType="ecore:EDataType http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A short description for any code or script performed by the ClassifierMap." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="featureMap" ordered="false" upperBound="-1" eType="#//FeatureMap" containment="true" eOpposite="#//FeatureMap/classifierMap">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the owned FeatureMaps" />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cfMap" ordered="false" upperBound="-1" eType="#//ClassifierFeatureMap" containment="true" eOpposite="#//ClassifierFeatureMap/classifierMap">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the owned ClassifierFeatureMaps" />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" ordered="false" lowerBound="1" upperBound="-1" eType="ecore:EClass http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Classifier">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="classifierMap" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="classifierMap" />
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the source Classifiers of the ClassifierMap" />
