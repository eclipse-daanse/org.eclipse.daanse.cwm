  <eClassifiers xsi:type="ecore:EClass" name="StepPrecedence" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Dependency">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="DifferentPrecedingAndSucceedingSteps" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="DifferentPrecedingAndSucceedingSteps" value="self.supplier-&gt;forAll( p | self.client-&gt;forAll( q | p &lt;&gt; q ) )" />
    </eAnnotations>
    <eAnnotations source="http://www.omg.org/spec/CWM/1.1/constraints">
      <details key="DifferentPrecedingAndSucceedingSteps.shortName" value="C-1" />
      <details key="DifferentPrecedingAndSucceedingSteps.name" value="Different Preceding And Succeeding Steps" />
      <details key="DifferentPrecedingAndSucceedingSteps.description" value="The preceding step and succeeding step of StepPrecedence must not be the same." />
      <details key="DifferentPrecedingAndSucceedingSteps.level" value="error" />
      <details key="DifferentPrecedingAndSucceedingSteps.postDescription" value="The spec body reads self.precedingStep / self.succeedingStep. MOF declares both as References on StepPrecedence that alias ends of the inherited Core associations: precedingStep -&gt; DependencySupplier::supplier, succeedingStep -&gt; DependencyClient::client. Ecore cannot carry the aliases as separate features (they would collide with the inherited ones), so the body uses the inherited names. Same navigation, resolved instead of renamed." />
      <details key="DifferentPrecedingAndSucceedingSteps.specSource" value="self.precedingStep-&gt;forAll( p | self.succeedingStep-&gt;forAll( q | p &lt;&gt; q ) )" />
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This is used to define explicit order-of-execution relationships among TransformationSteps. It may be used independent of or in conjunction with PrecedenceConstraint" />
    </eAnnotations>
  </eClassifiers>
