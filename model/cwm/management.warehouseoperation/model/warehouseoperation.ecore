    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A StepExecution is used to record details of a specific execution of a TransformationStep." />
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="transformationStep" lowerBound="1" eType="ecore:EClass http://www.omg.org/spec/CWM/1.1/analysis/transformation#//TransformationStep">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="execution" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="execution" />
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the TransformationStep." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="activityExecution" eType="#//ActivityExecution" transient="true" eOpposite="#//ActivityExecution/stepExecution">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the ActivityExecution of which the StepExecution is a part." />
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="callAction" eType="ecore:EClass http://www.omg.org/spec/CWM/1.1/objectmodel/behavioral#//CallAction">
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="stepExecution" />
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="stepExecution" />
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Identifies the CallAction for a StepExecution." />
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
  