<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.daanse</groupId>
    <artifactId>org.eclipse.daanse.cwm.model.daanse</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>org.eclipse.daanse.cwm.model.daanse.semantictype.xmla</artifactId>
  <name>Daanse CWM — semantic types of an Analysis Services server</name>
  <description>The attribute, dimension and account types of an Analysis Services server as a library of semantic
    types, each with its name and number there, narrower than a group of its kind; the XMLA codes of a type
    (LEVEL_TYPE, PROPERTY_CONTENT_TYPE, DIMENSION_TYPE), also for a type of another library that is the same as or
    narrower than one of the server's; and the rules for typings that name the server's types. Plain Java on the
    model of semantictype.base, no model of its own.</description>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.model.daanse.semantictype.base</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.model.cwm.objectmodel.core</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.model.daanse.validation</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>
    <!-- the four libraries as a standard set of instances -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.emf.standard</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the tests type columns and rows of a relational catalog -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.model.cwm.resource.relational</artifactId>
      <version>0.0.1-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Classic Eclipse OCL as EMF validation delegate, so that the tests evaluate the OCL
      constraints of the ecore (same setup as model/cwm); the 2013-era poms declare version ranges
      against coordinates that no longer exist, so their transitive dependencies are excluded. -->
    <dependency>
      <groupId>org.eclipse.ocl</groupId>
      <artifactId>ecore</artifactId>
      <version>3.3.0-v20130520-1222</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse</groupId>
      <artifactId>ocl</artifactId>
      <version>3.4.0-v20140524-1358</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.ocl</groupId>
      <artifactId>common</artifactId>
      <version>1.2.0-v20140528-1458</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>lpg.runtime</groupId>
      <artifactId>java</artifactId>
      <version>2.0.17-v201004271640</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
