<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="sensinact" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.mapping.sensinact"
    nsPrefix="sensinactmapping">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="The mapping of a CWM class model onto Eclipse sensiNact providers (resource.sensinact). A ProviderMapping says which source classes become instances of a provider and where the instance id comes from; a ServiceMapping per mapped service may pick the element the service reads from; a ResourceMapping per resource names the source of its value. Every value is read through a ValueSource, and its subclass says how: a PathSource is a typed feature path into the source class (an element picked from a collection by index or filter, a fallback where the path yields nothing), a LiteralSource a fixed value, an ArrivalTimeSource the time a source instance arrives. Nothing is implicit: what a mapping omits is checked by SensinactMappingModelValidator, not filled in. Non-containment references into CWM and resource.sensinact are hidden association ends (Property.oppositeRoleName, prefix sensinact)."/>
    <details key="modelName" value="SensinactMapping"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse.mapping"/>
    <details key="resource" value="XMI"/>
    <details key="prefix" value="SensinactMapping"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="invocationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="settingDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
    <details key="hiddenOpposites" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="ProviderMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Makes instances of the source classes instances of the provider: the id of a provider instance, its timestamp, its admin values, and one ServiceMapping per mapped service (owned in ownedElement). The name is the mapping id."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Namespace"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="provider" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The provider the source instances become instances of."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="sensinactProviderMapping"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="sensinactProviderMapping"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.resource.sensinact#//Provider"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceClass" ordered="false" lowerBound="1"
        upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The source classes: an instance of any of them becomes a provider instance."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="sensinactSourceOfMapping"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="sensinactSourceOfMapping"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="id" lowerBound="1" eType="//ValueSource"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The id of a provider instance: read along a path (a literal as its fallback where the path yields nothing), or a literal."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="timestamp" eType="//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The time of the values of a source instance: read along a path, a literal instant, or the arrival time; unset: the arrival time."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="admin" eType="//AdminMapping" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The values of the admin service."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ServiceMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Maps one service: optionally the element of the source instance the service reads from (selector), the timestamp of its values, and one ResourceMapping per mapped resource. The name is the service name. The ResourceMappings are owned in ownedElement."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Namespace"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="service" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mapped service, a service of the provider of the ProviderMapping."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="sensinactServiceMapping"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="sensinactServiceMapping"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.resource.sensinact#//Service"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="selector" eType="//PathSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The element of the source instance the service reads from, e.g. one element of a collection; the paths of the service then start at its type. Unset: the source instance itself."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="timestamp" eType="//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The time of the values of the service; unset: the time of the ProviderMapping."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ResourceMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Maps one resource: where its value comes from. The name is the resource name."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="resource" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mapped resource, a resource of the service of the ServiceMapping."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="sensinactResourceMapping"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="sensinactResourceMapping"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.resource.sensinact#//Resource"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="value" lowerBound="1" eType="//ValueSource"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Where the value of the resource comes from."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AdminMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The values of the admin service of a provider instance: friendly name, description and location; each read from the source instance or given as a literal. A location needs both latitude and longitude."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friendlyName" eType="//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The friendly name of the provider instance."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="description" eType="//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The description of the provider instance."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="latitude" eType="//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The latitude of the provider instance."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="longitude" eType="//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The longitude of the provider instance."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ValueSource" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Where a value comes from; the subclass says how: a PathSource reads it from the source instance, a LiteralSource gives it, an ArrivalTimeSource is the time a source instance arrives."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PathSource" eSuperTypes="//ValueSource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A value read along a feature path into the context class (the source class, or the element a service selector picks), each step a feature of the type of the step before; at the one step that holds many values the element is picked by index or by filter. Where the path yields nothing, the fallback gives the value."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="path" lowerBound="1" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The feature path, in order: the first step a feature of the context class, every further step a feature of the type of the step before (an attribute of the class, or a navigable association end seen from the other end)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="sensinactValueSource"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="sensinactValueSource"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="index" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The position of the element picked at the step that holds many values, from 0."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="filter" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Picks the element at the step that holds many values by its content, in the language event.atlas.collectionFilter: a dotted path of feature names, '=', a literal (key=line_5). Wins over index."/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//BooleanExpression"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="format">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A DateTimeFormatter pattern for a timestamp read as text; read as UTC unless the pattern carries a zone."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="fallback" eType="//ValueSource" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value where the path yields none."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LiteralSource" eSuperTypes="//ValueSource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A fixed value, given as text."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="literal" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ArrivalTimeSource" eSuperTypes="//ValueSource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The time a source instance arrives; a timestamp only."/>
    </eAnnotations>
  </eClassifiers>
</ecore:EPackage>
