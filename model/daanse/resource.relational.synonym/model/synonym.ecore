<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="synonym" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.resource.relational.synonym"
    nsPrefix="synonym">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Synonyms (Oracle, SQL Server, H2) and aliases (DB2, Derby) as a Daanse extension — CWM 1.1 has no class for them. A synonym is a named object of its relational::Schema (ownedElement, schema = namespace) and points to another schema object. The target is always kept raw on the synonym (catalog, schema, name, type, DB link) as the database catalog reports it; target is set in addition when the target is part of the loaded model."/>
    <details key="caption.de" value="Synonym"/>
    <details key="caption.en" value="Synonym"/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse.resource.relational"/>
    <details key="prefix" value="Synonym"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="fileExtensions" value="cwmsynonym"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
    <details key="hiddenOpposites" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Synonym">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One synonym as the catalog keeps it (ALL_SYNONYMS, sys.synonyms, INFORMATION_SCHEMA.SYNONYMS): name and schema of the synonym, the target raw and — when in the model — as a reference. Oracle PUBLIC synonyms live in the schema PUBLIC and have isPublic = true."/>
      <details key="caption.de" value="Synonym"/>
      <details key="caption.en" value="Synonym"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ownerIsSchema targetNameIsSet"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="ownerIsSchema" value="not self.namespace.oclIsUndefined() and self.namespace.oclIsKindOf(relational::Schema)"/>
      <details key="targetNameIsSet" value="not self.targetName.oclIsUndefined() and self.targetName.size() > 0"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The target in the model: relational::NamedColumnSet, relational::Procedure or another synonym (chain). Empty when the target is not part of the model (DB link, other database, package, schema outside the filter)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="synonym"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="synonym"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetCatalogName">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Catalog (database) of the target as the database catalog reports it; empty = the same catalog."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetSchemaName">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Schema of the target as the database catalog reports it; empty when the catalog records none."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetName" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Name of the target as the database catalog reports it."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetObjectType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Type of the target in the database's own terms (TABLE, VIEW, USER_TABLE, BASE TABLE, SYNONYM, FUNCTION, ...); empty when unknown (remote or missing target)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dbLink">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Oracle database link or SQL Server linked server the target lives behind; empty = local."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isPublic" lowerBound="1" defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Oracle PUBLIC synonym: visible to every user."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
