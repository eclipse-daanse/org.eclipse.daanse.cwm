# A model's provider (emf/standalone.api) serves plain Java only: under OSGi the generated configurator registers the
# package, so a model bundle imports the API optionally and resolves without it.
Import-Package: org.eclipse.daanse.cwm.emf.standalone.api*;resolution:=optional,*
