<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="dcat" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat"
    nsPrefix="dcat">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="W3C DCAT 3 (Data Catalog Vocabulary, REC 2024) as a CWM-anchored Daanse extension: catalogs describe datasets whose content already exists as a CWM model — Dataset.subject references arbitrary core::ModelElements (relational::Schema, json::ObjectType, single tables), distributions describe the physical access forms, data services the APIs. Agents are businessinformation::ResponsibleParty, themes point at businessnomenclature::Concept and/or EU vocabulary IRIs. Controlled vocabularies (data-theme, frequency, access-right, ...) are deliberately flattened to IRI strings (suffix Iri). DCAT inverses (seriesMember, inCatalog, nextVersion, ...) are the Property.oppositeRoleName annotations of the hidden reverse directions — backward navigation via InverseReferences."/>
    <details key="documentation.de" value="W3C DCAT 3 (Data Catalog Vocabulary, REC 2024) als CWM-verankerte Daanse-Erweiterung: Kataloge beschreiben Datensaetze, deren Inhalt bereits als CWM-Modell vorliegt — Dataset.subject referenziert beliebige core::ModelElements (relational::Schema, json::ObjectType, einzelne Tabellen), Distributionen beschreiben die physischen Zugriffsformen, DataServices die APIs. Agenten sind businessinformation::ResponsibleParty, Themen verweisen auf businessnomenclature::Concept und/oder EU-Vokabular-IRIs. Kontrollierte Vokabulare (data-theme, frequency, access-right, ...) sind bewusst als IRI-Strings verflacht (Suffix Iri). DCAT-Inverse (seriesMember, inCatalog, nextVersion, ...) sind die Property.oppositeRoleName-Annotationen der versteckten Gegenrichtungen — Rueckwaertsnavigation ueber InverseReferences."/>
    <details key="caption.de" value="Datenkatalog (DCAT)"/>
    <details key="caption.en" value="Data Catalog (DCAT)"/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse"/>
    <details key="prefix" value="Dcat"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="literalsInterface" value="true"/>
    <details key="loadInitialization" value="false"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="invocationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="settingDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
    <details key="hiddenOpposites" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="AgentRole">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Role of a ResponsibleParty towards a cataloged resource. Covers dcterms:publisher/creator/contributor, dcat:contactPoint, dcterms:rightsHolder and prov:qualifiedAttribution+dcat:hadRole; ORIGINATOR/CUSTODIAN (geodcatap) and MAINTAINER are already in the base enum for future profiles (EEnums cannot be extended later). OTHER + Attribution.roleIri is the open end for arbitrary prov roles."/>
      <details key="documentation.de" value="Rolle einer ResponsibleParty gegenueber einer katalogisierten Ressource. Deckt dcterms:publisher/creator/contributor, dcat:contactPoint, dcterms:rightsHolder sowie prov:qualifiedAttribution+dcat:hadRole ab; ORIGINATOR/CUSTODIAN (geodcatap) und MAINTAINER liegen fuer kommende Profile bereits im Basis-Enum (EEnums sind nicht nachtraeglich erweiterbar). OTHER + Attribution.roleIri ist das offene Ende fuer beliebige prov-Rollen."/>
      <details key="caption.de" value="Agentenrolle"/>
      <details key="caption.en" value="Agent Role"/>
    </eAnnotations>
    <eLiterals name="PUBLISHER" literal="PUBLISHER"/>
    <eLiterals name="CREATOR" value="1" literal="CREATOR"/>
    <eLiterals name="CONTRIBUTOR" value="2" literal="CONTRIBUTOR"/>
    <eLiterals name="CONTACT_POINT" value="3" literal="CONTACT_POINT"/>
    <eLiterals name="RIGHTS_HOLDER" value="4" literal="RIGHTS_HOLDER"/>
    <eLiterals name="ORIGINATOR" value="5" literal="ORIGINATOR"/>
    <eLiterals name="CUSTODIAN" value="6" literal="CUSTODIAN"/>
    <eLiterals name="MAINTAINER" value="7" literal="MAINTAINER"/>
    <eLiterals name="OTHER" value="8" literal="OTHER"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ChecksumAlgorithm">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Checksum algorithm per SPDX (spdx:ChecksumAlgorithm) as referenced by DCAT 3 for spdx:Checksum."/>
      <details key="documentation.de" value="Pruefsummen-Algorithmus nach SPDX (spdx:ChecksumAlgorithm), wie von DCAT 3 fuer spdx:Checksum referenziert."/>
      <details key="caption.de" value="Pruefsummen-Algorithmus"/>
      <details key="caption.en" value="Checksum Algorithm"/>
    </eAnnotations>
    <eLiterals name="SHA1" literal="SHA1"/>
    <eLiterals name="SHA224" value="1" literal="SHA224"/>
    <eLiterals name="SHA256" value="2" literal="SHA256"/>
    <eLiterals name="SHA384" value="3" literal="SHA384"/>
    <eLiterals name="SHA512" value="4" literal="SHA512"/>
    <eLiterals name="SHA3_256" value="5" literal="SHA3_256"/>
    <eLiterals name="SHA3_384" value="6" literal="SHA3_384"/>
    <eLiterals name="SHA3_512" value="7" literal="SHA3_512"/>
    <eLiterals name="MD5" value="8" literal="MD5"/>
    <eLiterals name="BLAKE2B_256" value="9" literal="BLAKE2B_256"/>
    <eLiterals name="BLAKE2B_384" value="10" literal="BLAKE2B_384"/>
    <eLiterals name="BLAKE2B_512" value="11" literal="BLAKE2B_512"/>
    <eLiterals name="BLAKE3" value="12" literal="BLAKE3"/>
    <eLiterals name="ADLER32" value="13" literal="ADLER32"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DcatElement" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Abstract local root of the catalog world (SqlElement pattern): the metadata shared by CatalogedResource, Distribution and CatalogRecord — description, lifecycle dates, license and rights. The title (dcterms:title) is the inherited name (core::ModelElement.name); description carries the primary language; further language versions attach as businessinformation::Description (type=title|description, language set), further documentation pages as businessinformation::Document."/>
      <details key="documentation.de" value="Abstrakte lokale Wurzel der Katalogwelt (Muster SqlElement): die von CatalogedResource, Distribution und CatalogRecord geteilten Metadaten — Beschreibung, Lebenszyklusdaten, Lizenz und Rechte. Der Titel (dcterms:title) ist der geerbte name (core::ModelElement.name); description traegt die Primaersprache; weitere Sprachfassungen haengen als businessinformation::Description (type=title|description, language gesetzt) am Element, weitere Dokumentationsseiten als businessinformation::Document."/>
      <details key="caption.de" value="DCAT-Element"/>
      <details key="caption.en" value="DCAT Element"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:description in the primary language; further languages as businessinformation::Description (type=description)."/>
        <details key="documentation.de" value="dcterms:description in der Primaersprache; weitere Sprachen als businessinformation::Description (type=description)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="issued">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:issued — release date (ISO 8601); for a CatalogRecord the listing date."/>
        <details key="documentation.de" value="dcterms:issued — Veroeffentlichungsdatum (ISO 8601); beim CatalogRecord das Listungsdatum."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Time"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modified">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:modified — date of last change (ISO 8601)."/>
        <details key="documentation.de" value="dcterms:modified — Datum der letzten Aenderung (ISO 8601)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Time"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="licenseIri">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:license as IRI (e.g. EU license vocabulary, dcat-ap.de/def/licenses). CWM has no licensing anchor; full texts attach as businessinformation::Document."/>
        <details key="documentation.de" value="dcterms:license als IRI (z. B. EU-Lizenzvokabular, dcat-ap.de/def/licenses). CWM kennt keine Lizenzverankerung; Volltexte haengen als businessinformation::Document am Element."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accessRightsIri">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:accessRights as IRI (EU access-right: PUBLIC/RESTRICTED/NON_PUBLIC)."/>
        <details key="documentation.de" value="dcterms:accessRights als IRI (EU access-right: PUBLIC/RESTRICTED/NON_PUBLIC)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rights">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:rights — rights statement as free text or IRI of a RightsStatement."/>
        <details key="documentation.de" value="dcterms:rights — Rechtehinweis als Freitext oder IRI eines RightsStatement."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="policyIri" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="odrl:hasPolicy — IRIs of ODRL usage policies."/>
        <details key="documentation.de" value="odrl:hasPolicy — IRIs von ODRL-Nutzungsrichtlinien."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="conformsToIri" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:conformsTo — IRIs of the standards/schemata/profiles the content follows; for a CatalogRecord the metadata profile of the entry."/>
        <details key="documentation.de" value="dcterms:conformsTo — IRIs der Standards/Schemata/Profile, denen der Inhalt folgt; beim CatalogRecord das Metadatenprofil des Eintrags."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CatalogedResource" abstract="true" eSuperTypes="//DcatElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:Resource — a cataloged resource (dataset, data service, catalog). Carries identification, vocabulary IRIs, keywords/themes, attributions, qualified relations and the DCAT 3 versioning and ordering links. Reverse directions (inCatalog, nextVersion, seriesMember, ...) are hidden roles — navigate via InverseReferences."/>
      <details key="documentation.de" value="dcat:Resource — eine katalogisierte Ressource (Dataset, DataService, Katalog). Traegt Identifikation, Vokabular-IRIs, Schlagworte/Themen, Attributionen, qualifizierte Relationen sowie die DCAT-3-Versions- und Ordnungsbezuege. Die Gegenrichtungen (inCatalog, nextVersion, seriesMember, ...) sind versteckte Rollen — Navigation ueber InverseReferences."/>
      <details key="caption.de" value="Katalogisierte Ressource"/>
      <details key="caption.en" value="Cataloged Resource"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SinglePublisher"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SinglePublisher" value="self.attribution->select(a | a.role = AgentRole::PUBLISHER)->size() &lt;= 1"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="SinglePublisher.name" value="SinglePublisher"/>
      <details key="SinglePublisher.description" value="A resource has at most one publisher attribution."/>
      <details key="SinglePublisher.level" value="error"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identifier" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:identifier — primary identifiers (URN, DOI, portal id, ...)."/>
        <details key="documentation.de" value="dcterms:identifier — Hauptbezeichner (URN, DOI, Portal-ID, ...)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="otherIdentifier" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="adms:identifier flattened to the notation — further identifiers from other systems."/>
        <details key="documentation.de" value="adms:identifier, verflacht auf die Notation — weitere Bezeichner aus anderen Systemen."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="language" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:language — EU language IRI or ISO 639 code of the content."/>
        <details key="documentation.de" value="dcterms:language — EU-Sprach-IRI oder ISO-639-Code des Inhalts."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="typeIri" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:type — genre/kind of the resource as IRI (e.g. EU dataset-type)."/>
        <details key="documentation.de" value="dcterms:type — Genre/Art der Ressource als IRI (z. B. EU dataset-type)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="statusIri">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="adms:status as IRI (EU distribution-status or ADMS status list)."/>
        <details key="documentation.de" value="adms:status als IRI (EU distribution-status bzw. ADMS-Statusliste)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:version (new in DCAT 3) — version designator of this resource."/>
        <details key="documentation.de" value="dcat:version (neu in DCAT 3) — Versionsbezeichner dieser Ressource."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="versionNotes" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="adms:versionNotes — change notes for this version."/>
        <details key="documentation.de" value="adms:versionNotes — Aenderungsnotizen zu dieser Version."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keyword" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:keyword — free-text keywords."/>
        <details key="documentation.de" value="dcat:keyword — freie Schlagworte."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="landingPage" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:landingPage — web page(s) giving access to the resource; further foaf:pages as businessinformation::Document."/>
        <details key="documentation.de" value="dcat:landingPage — Webseite(n) mit Zugang zur Ressource; weitere foaf:pages als businessinformation::Document."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="themeIri" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:theme as IRI of the EU data-theme vocabulary (or another skos:ConceptScheme) — the form exporters and portals need."/>
        <details key="documentation.de" value="dcat:theme als IRI des EU-data-theme-Vokabulars (bzw. eines anderen skos:ConceptScheme) — die Form, die Exporter und Portale brauchen."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="theme" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:theme as in-repo SKOS anchor: businessnomenclature::Concept of a local taxonomy."/>
        <details key="documentation.de" value="dcat:theme als repo-interne SKOS-Verankerung: businessnomenclature::Concept einer lokalen Taxonomie."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="themedResource"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="themedResource"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Concept"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attribution" ordered="false" upperBound="-1"
        eType="//Attribution" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Responsibilities: publisher/creator/contactPoint/... as (agent, role) pairs."/>
        <details key="documentation.de" value="Zustaendigkeiten: publisher/creator/contactPoint/... als (agent, role)-Paare."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="qualifiedRelation" ordered="false" upperBound="-1"
        eType="//Relationship" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:qualifiedRelation — qualified relations to other resources."/>
        <details key="documentation.de" value="dcat:qualifiedRelation — qualifizierte Beziehungen zu anderen Ressourcen."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relation" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:relation — generic link to related elements."/>
        <details key="documentation.de" value="dcterms:relation — generischer Bezug auf verwandte Elemente."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="relatedResource"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="relatedResource"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasPart" ordered="false" upperBound="-1"
        eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:hasPart — contained part resources (loose collection, no containment)."/>
        <details key="documentation.de" value="dcterms:hasPart — enthaltene Teilressourcen (lose Kollektion, kein Containment)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="isPartOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="isPartOf"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="isReferencedBy" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:isReferencedBy — publications/elements citing this resource (data citation)."/>
        <details key="documentation.de" value="dcterms:isReferencedBy — Publikationen/Elemente, die diese Ressource zitieren (Datenzitation)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="references"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="references"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="previousVersion" eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:previousVersion (new in DCAT 3) — the immediate predecessor in the version lineage (not the series position, that is prev)."/>
        <details key="documentation.de" value="dcat:previousVersion (neu in DCAT 3) — der unmittelbare Vorgaenger in der Versionslinie (nicht die Serienposition, das ist prev)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="nextVersion"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="nextVersion"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasVersion" ordered="false" upperBound="-1"
        eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:hasVersion (new in DCAT 3) — versions of this resource."/>
        <details key="documentation.de" value="dcat:hasVersion (neu in DCAT 3) — Versionen dieser Ressource."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="isVersionOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="isVersionOf"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasCurrentVersion" eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:hasCurrentVersion (new in DCAT 3) — the current version."/>
        <details key="documentation.de" value="dcat:hasCurrentVersion (neu in DCAT 3) — die aktuelle Version."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="isCurrentVersionOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="isCurrentVersionOf"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="replaces" ordered="false" upperBound="-1"
        eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:replaces — resources this one supersedes."/>
        <details key="documentation.de" value="dcterms:replaces — Ressourcen, die diese abloest."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="isReplacedBy"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="isReplacedBy"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="first" eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:first — first member of the ordered collection/series."/>
        <details key="documentation.de" value="dcat:first — erstes Mitglied der geordneten Kollektion/Serie."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="isFirstOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="isFirstOf"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="last" eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:last — last member of the ordered collection/series."/>
        <details key="documentation.de" value="dcat:last — letztes Mitglied der geordneten Kollektion/Serie."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="isLastOf"/>
