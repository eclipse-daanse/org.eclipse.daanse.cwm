    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Dataset" eSuperTypes="//CatalogedResource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:Dataset — a collection of data published as a unit. The core of the CWM anchoring: subject references the already-modeled CWM elements (relational::Schema, a single Table, json::ObjectType, calc::Sheet, ...) this dataset publishes — &quot;I publish this class as a dataset with this description&quot;. Physical access forms are owned Distribution children."/>
      <details key="documentation.de" value="dcat:Dataset — eine als Einheit publizierte Datensammlung. Der Kern der CWM-Verankerung: subject referenziert die bereits modellierten CWM-Elemente (relational::Schema, eine einzelne Table, json::ObjectType, calc::Sheet, ...), die dieser Datensatz publiziert — &quot;diese Klasse publiziere ich als Datensatz mit dieser Beschreibung&quot;. Physische Zugriffsformen sind eigene Distribution-Kinder."/>
      <details key="caption.de" value="Datensatz"/>
      <details key="caption.en" value="Dataset"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SpatialResolutionPositive SourceNotCircular GeneratedHasSource DistributionServiceServesDataset"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SpatialResolutionPositive" value="self.spatialResolutionInMeters &lt;> null implies self.spatialResolutionInMeters.toReal() > 0"/>
      <details key="SourceNotCircular" value="self.source->excludes(self) and self.source->closure(d | d.source)->excludes(self)"/>
      <details key="GeneratedHasSource" value="self.wasGeneratedBy->notEmpty() implies self.source->notEmpty()"/>
      <details key="DistributionServiceServesDataset" value="self.distribution->forAll(x | x.accessService &lt;> null implies x.accessService.servesDataset->includes(self))"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="SpatialResolutionPositive.name" value="SpatialResolutionPositive"/>
      <details key="SpatialResolutionPositive.description" value="The spatial resolution, when given, is positive (core::Float is a decimal literal)."/>
      <details key="SpatialResolutionPositive.description.de" value="Die raeumliche Aufloesung ist, wenn angegeben, positiv (core::Float ist ein Dezimal-Literal)."/>
      <details key="SpatialResolutionPositive.level" value="error"/>
      <details key="SourceNotCircular.name" value="SourceNotCircular"/>
      <details key="SourceNotCircular.description" value="A dataset is not its own source, neither directly nor over other datasets."/>
      <details key="SourceNotCircular.description.de" value="Ein Datensatz ist nicht seine eigene Quelle, weder direkt noch ueber andere Datensaetze."/>
      <details key="SourceNotCircular.level" value="error"/>
      <details key="GeneratedHasSource.name" value="GeneratedHasSource"/>
      <details key="GeneratedHasSource.description" value="A dataset with wasGeneratedBy names the datasets it was generated from in source."/>
      <details key="GeneratedHasSource.description.de" value="Ein Datensatz mit wasGeneratedBy nennt in source die Datensaetze, aus denen er erzeugt wurde."/>
      <details key="GeneratedHasSource.level" value="warning"/>
      <details key="DistributionServiceServesDataset.name" value="DistributionServiceServesDataset"/>
      <details key="DistributionServiceServesDataset.description" value="The access service of every distribution of a dataset names the dataset in servesDataset."/>
      <details key="DistributionServiceServesDataset.description.de" value="Der Zugangsdienst jeder Distribution eines Datensatzes nennt den Datensatz in servesDataset."/>
      <details key="DistributionServiceServesDataset.level" value="warning"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subject" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The CWM anchor: the already-modeled elements this dataset publishes (relational::Schema, a Table, json::ObjectType, calc::Sheet, ...). Reverse role dataset via InverseReferences: &quot;as which datasets is this element published?&quot;."/>
        <details key="documentation.de" value="Der CWM-Anker: die bereits modellierten Elemente, die dieser Datensatz publiziert (relational::Schema, eine Table, json::ObjectType, calc::Sheet, ...). Rueckrichtung dataset via InverseReferences: &quot;als welche Datensaetze ist dieses Element publiziert?&quot;."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="dataset"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="dataset"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="distribution" ordered="false" upperBound="-1"
        eType="//Distribution" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:distribution — the physical access forms; dcat:isDistributionOf is the container."/>
        <details key="documentation.de" value="dcat:distribution — die physischen Zugriffsformen; dcat:isDistributionOf ist der Container."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accrualPeriodicityIri">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:accrualPeriodicity — update frequency as IRI of the EU frequency vocabulary."/>
        <details key="documentation.de" value="dcterms:accrualPeriodicity — Aktualisierungsfrequenz als IRI des EU-frequency-Vokabulars."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="inSeries" ordered="false" upperBound="-1"
        eType="//DatasetSeries">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:inSeries (new in DCAT 3) — series this dataset belongs to; reverse role seriesMember."/>
        <details key="documentation.de" value="dcat:inSeries (neu in DCAT 3) — Serien, zu denen dieser Datensatz gehoert; Gegenrolle seriesMember."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="seriesMember"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="seriesMember"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="spatial" ordered="false" upperBound="-1"
        eType="//Location" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:spatial — spatial coverage."/>
        <details key="documentation.de" value="dcterms:spatial — raeumliche Abdeckung."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="spatialResolutionInMeters">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:spatialResolutionInMeters — minimum resolvable distance in meters."/>
        <details key="documentation.de" value="dcat:spatialResolutionInMeters — kleinster aufgeloester Abstand in Metern."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="temporal" ordered="false" upperBound="-1"
        eType="//PeriodOfTime" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:temporal — temporal coverage."/>
        <details key="documentation.de" value="dcterms:temporal — zeitliche Abdeckung."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="temporalResolution">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:temporalResolution — minimum resolvable time period as an xsd:duration literal (core::Time is an instant, not a duration)."/>
        <details key="documentation.de" value="dcat:temporalResolution — kleinster aufgeloester Zeitabstand als xsd:duration-Literal (core::Time ist ein Zeitpunkt, keine Dauer)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="wasGeneratedBy" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="prov:wasGeneratedBy — what generated this dataset. Deliberately typed generically (core::ModelElement), keeping the module hull of the targets out of consumers' poms. Canonical targets are transformation::Transformation (the mapping from source to target), transformation::TransformationTask (transformations run as a unit), transformation::TransformationActivity and warehouseoperation::TransformationExecution (one run). Set together with source: wasGeneratedBy says how the dataset was made, source from what (GeneratedHasSource). Unset: nothing is said about the process. Example: 'pool-visits-monthly' was generated by the transformation 'aggregate-visits' from 'turnstile-events'."/>
        <details key="documentation.de" value="prov:wasGeneratedBy — wodurch dieser Datensatz erzeugt wurde. Bewusst generisch typisiert (core::ModelElement), so bleibt die Modul-Huelle der Ziele aus dem pom der Konsumenten. Kanonische Ziele sind transformation::Transformation (die Abbildung von Quelle auf Ziel), transformation::TransformationTask (Transformationen, die als Einheit laufen), transformation::TransformationActivity und warehouseoperation::TransformationExecution (ein Lauf). Gesetzt zusammen mit source: wasGeneratedBy sagt, wie der Datensatz entstand, source, woraus (GeneratedHasSource). Nicht gesetzt: ueber den Vorgang ist nichts gesagt. Beispiel: 'pool-visits-monthly' wurde von der Transformation 'aggregate-visits' aus 'turnstile-events' erzeugt."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="generated"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="generated"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" ordered="false" upperBound="-1"
        eType="//Dataset">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:source — the datasets this dataset is derived from: the raw or operational data it was made of. Set on a published dataset that is an extract, an aggregation or a cleaned copy of another one; the source is usually a non-public dataset (accessRightsIri NON_PUBLIC) with distributions of its own. Unset: nothing is said about the origin — the dataset is a source itself, or its origin is unknown. A dataset is not its own source, neither directly nor over others (SourceNotCircular). Reverse role derivedDataset. Example: the published dataset 'pools' has the source 'pool-register', the register of pools in the operations database."/>
        <details key="documentation.de" value="dcterms:source — die Datensaetze, aus denen dieser abgeleitet ist: die Roh- oder Betriebsdaten, aus denen er entstand. Gesetzt an einem veroeffentlichten Datensatz, der ein Auszug, eine Verdichtung oder eine bereinigte Fassung eines anderen ist; die Quelle ist meist ein nicht oeffentlicher Datensatz (accessRightsIri NON_PUBLIC) mit eigenen Distributionen. Nicht gesetzt: ueber die Herkunft ist nichts gesagt — der Datensatz ist selbst eine Quelle, oder seine Herkunft ist unbekannt. Ein Datensatz ist nicht seine eigene Quelle, weder direkt noch ueber andere (SourceNotCircular). Gegenrolle derivedDataset. Beispiel: Der veroeffentlichte Datensatz 'pools' hat die Quelle 'pool-register', das Baederverzeichnis der Betriebsdatenbank."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="derivedDataset"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="derivedDataset"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DatasetSeries" eSuperTypes="//Dataset">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:DatasetSeries (new in DCAT 3) — a dataset that groups other datasets into a series (time series, map series). No own features; members point here via inSeries (reverse role seriesMember), their order via first/prev/last. A series should not carry distributions itself (SeriesHasNoDistribution)."/>
      <details key="documentation.de" value="dcat:DatasetSeries (neu in DCAT 3) — ein Datensatz, der andere Datensaetze als Serie buendelt (Zeitreihen, Kartenwerke). Keine eigenen Merkmale; Mitglieder zeigen per inSeries hierher (Gegenrolle seriesMember), ihre Ordnung ueber first/prev/last. Eine Serie soll selbst keine Distributionen tragen (SeriesHasNoDistribution)."/>
      <details key="caption.de" value="Datensatzserie"/>
      <details key="caption.en" value="Dataset Series"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SeriesHasNoDistribution"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SeriesHasNoDistribution" value="self.distribution->isEmpty()"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="SeriesHasNoDistribution.name" value="SeriesHasNoDistribution"/>
      <details key="SeriesHasNoDistribution.description" value="A dataset series should not carry distributions itself (DCAT 3 SHOULD)."/>
      <details key="SeriesHasNoDistribution.description.de" value="Eine Datensatzserie soll selbst keine Distributionen tragen (DCAT 3 SHOULD)."/>
      <details key="SeriesHasNoDistribution.level" value="warning"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Portal">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A portal — the place that provides catalogs, such as the open-data site of a city or a state. DCAT itself has no portal class, its unit is the catalog; the portal is the namespace above it. A core::Package without features of its own: it owns (ownedElement) its catalogs and exactly one data service, its access service (OneAccessService). The endpointUrl of that service is the address of the portal's catalog interface, conformsToIri names the metadata profile it speaks (for example DCAT-AP.de), servesDataset names the catalogs (AccessServiceServesCatalogs) and provider leads to the operations view (softwaredeployment). A catalog the portal takes over from another portal (harvesting) is imported (importedElement), not owned (TakenOverNotOwned): ownership is the home of a catalog, while the membership of resources stays the reference Catalog.resource. As a package a portal can also be the dataPackage of a softwaredeployment::DataManager that describes its installation. Example: the portal 'utility-open-data' of a municipal utility owns the catalog 'open-data' and the access service 'portal-api'; a regional portal imports 'open-data' and shows it as well."/>
      <details key="documentation.de" value="Ein Portal — die Stelle, die Kataloge bereitstellt, etwa das Open-Data-Angebot einer Stadt oder eines Landes. DCAT selbst kennt keine Portal-Klasse, seine Einheit ist der Katalog; das Portal ist der Namensraum darueber. Ein core::Package ohne eigene Merkmale: Es besitzt (ownedElement) seine Kataloge und genau einen Datendienst, seinen Zugangsdienst (OneAccessService). Dessen endpointUrl ist die Adresse der Katalogschnittstelle des Portals, conformsToIri nennt das Metadatenprofil (etwa DCAT-AP.de), servesDataset nennt die Kataloge (AccessServiceServesCatalogs), provider fuehrt zur Betriebssicht (softwaredeployment). Einen Katalog, den das Portal von einem anderen uebernimmt (Harvesting), importiert es (importedElement), statt ihn zu besitzen (TakenOverNotOwned): Der Besitz ist die Heimat eines Katalogs, die Mitgliedschaft von Ressourcen bleibt die Referenz Catalog.resource. Als Package kann ein Portal auch das dataPackage eines softwaredeployment::DataManager sein, der seine Installation beschreibt. Beispiel: Das Portal 'utility-open-data' der Stadtwerke besitzt den Katalog 'open-data' und den Zugangsdienst 'portal-api'; ein Landesportal importiert 'open-data' und zeigt ihn ebenfalls."/>
      <details key="caption.de" value="Portal"/>
      <details key="caption.en" value="Portal"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="OneAccessService AccessServiceServesCatalogs TakenOverNotOwned"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="OneAccessService" value="self.ownedElement->select(e | e.oclIsKindOf(DataService))->size() = 1"/>
      <details key="AccessServiceServesCatalogs" value="self.ownedElement->select(e | e.oclIsKindOf(DataService))->forAll(s | self.ownedElement->select(e | e.oclIsKindOf(Catalog))->forAll(c | s.oclAsType(DataService).servesDataset->includes(c)) and s.oclAsType(DataService).servesDataset->forAll(d | d.oclIsKindOf(Catalog) and (self.ownedElement->includes(d) or self.importedElement->includes(d))))"/>
      <details key="TakenOverNotOwned" value="self.importedElement->forAll(e | self.ownedElement->excludes(e))"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="OneAccessService.name" value="OneAccessService"/>
      <details key="OneAccessService.description" value="A portal owns exactly one data service: its access service."/>
      <details key="OneAccessService.description.de" value="Ein Portal besitzt genau einen Datendienst: seinen Zugangsdienst."/>
      <details key="OneAccessService.level" value="error"/>
      <details key="AccessServiceServesCatalogs.name" value="AccessServiceServesCatalogs"/>
      <details key="AccessServiceServesCatalogs.description" value="The access service of a portal serves every catalog the portal owns, and nothing but catalogs the portal owns or takes over."/>
      <details key="AccessServiceServesCatalogs.description.de" value="Der Zugangsdienst eines Portals liefert jeden Katalog aus, den das Portal besitzt, und nichts als Kataloge, die das Portal besitzt oder uebernimmt."/>
      <details key="AccessServiceServesCatalogs.level" value="error"/>
      <details key="TakenOverNotOwned.name" value="TakenOverNotOwned"/>
      <details key="TakenOverNotOwned.description" value="A portal does not take over what it owns: a catalog of another portal is in importedElement only, never also in ownedElement."/>
      <details key="TakenOverNotOwned.description.de" value="Ein Portal uebernimmt nicht, was es besitzt: Ein Katalog eines anderen Portals steht nur in importedElement, nie zugleich in ownedElement."/>
      <details key="TakenOverNotOwned.level" value="error"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Catalog">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:Catalog — a curated collection of metadata about resources. Faithful to DCAT it is a Dataset and at the same time a core::Package (precedent core::Subsystem): as a Package the catalog may own homeless datasets and support objects (ResponsibleParties, taxonomies) as ownedElement; canonical membership however is the resource reference — datasets usually live next to the resource models they describe. The dataset/service/catalog subsets are derivable (util filters), not separate features. A published catalog lives in a portal: the portal owns it, further portals that show it import it."/>
      <details key="documentation.de" value="dcat:Catalog — eine kuratierte Sammlung von Metadaten ueber Ressourcen. DCAT-treu ein Dataset und zugleich core::Package (Vorbild core::Subsystem): als Package kann der Katalog heimatlose Datensaetze und Traegerobjekte (ResponsibleParties, Taxonomien) als ownedElement besitzen; die kanonische Mitgliedschaft ist aber die Referenz resource — Datensaetze leben in der Regel bei den Ressourcenmodellen, die sie beschreiben. dataset/service/catalog-Teilmengen sind ableitbar (Util-Filter), keine eigenen Features. Ein veroeffentlichter Katalog lebt in einem Portal: das Portal besitzt ihn, weitere Portale, die ihn zeigen, importieren ihn."/>
      <details key="caption.de" value="Katalog"/>
      <details key="caption.en" value="Catalog"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="RecordTopicIsListed NotOwnMember"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="RecordTopicIsListed" value="self.record->forAll(r | self.resource->includes(r.primaryTopic) or self.ownedElement->includes(r.primaryTopic))"/>
      <details key="NotOwnMember" value="not self.resource->includes(self)"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="RecordTopicIsListed.name" value="RecordTopicIsListed"/>
      <details key="RecordTopicIsListed.description" value="Every catalog record describes a resource the catalog lists or owns."/>
      <details key="RecordTopicIsListed.description.de" value="Jeder Katalogeintrag beschreibt eine Ressource, die der Katalog listet oder besitzt."/>
      <details key="RecordTopicIsListed.level" value="error"/>
      <details key="NotOwnMember.name" value="NotOwnMember"/>
      <details key="NotOwnMember.description" value="A catalog does not list itself as a member."/>
      <details key="NotOwnMember.description.de" value="Ein Katalog listet sich nicht selbst als Mitglied."/>
      <details key="NotOwnMember.level" value="error"/>
    </eAnnotations>
    <eSuperTypes href="#//Dataset"/>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="homepage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="foaf:homepage — the catalog's home page."/>
        <details key="documentation.de" value="foaf:homepage — die Startseite des Katalogs."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="themeTaxonomy" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:themeTaxonomy as in-repo anchor: businessnomenclature::Taxonomy whose concepts provide the themes."/>
        <details key="documentation.de" value="dcat:themeTaxonomy als repo-interne Verankerung: businessnomenclature::Taxonomy, deren Concepts die Themen liefern."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="catalog"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="catalog"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Taxonomy"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="themeTaxonomyIri" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:themeTaxonomy as IRI of an external skos:ConceptScheme (e.g. EU data-theme)."/>
        <details key="documentation.de" value="dcat:themeTaxonomy als IRI eines externen skos:ConceptScheme (z. B. EU data-theme)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="resource" ordered="false" upperBound="-1"
        eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:resource — canonical membership: the catalog lists resources that structurally live next to their resource models; reverse role inCatalog. The dataset/service/catalog subsets via util filters."/>
        <details key="documentation.de" value="dcat:resource — die kanonische Mitgliedschaft: der Katalog listet Ressourcen, die strukturell bei ihren Ressourcenmodellen leben; Gegenrolle inCatalog. dataset/service/catalog-Teilmengen per Util-Filter."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="inCatalog"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="inCatalog"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="record" ordered="false" upperBound="-1"
        eType="//CatalogRecord" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:record — the catalog records; records are bound to the catalog's lifecycle (containment)."/>
        <details key="documentation.de" value="dcat:record — die Katalogeintraege; Eintraege sind an den Lebenszyklus des Katalogs gebunden (Containment)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DataService" eSuperTypes="//CatalogedResource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:DataService — a service/API offering access to datasets. endpointUrl is the one root address of the service (CWM SoftwareDeployment has no URL anywhere); conformsToIri names the protocol the service implements — at most one of the known protocols of DcatVocabularies (OneProtocol), such as OGC API Features, OData or MQTT. The distributions accessed through the service name it as accessService; the part of their accessUrl behind endpointUrl is the path of the dataset in the service, for an MQTT broker the topic. servesDataset names the datasets, and each of them has a distribution with this service (ServedDatasetHasDistribution). provider optionally links the deployed component (softwaredeployment::DataProvider) for the operations view. The data service a portal owns is the portal's access service."/>
      <details key="documentation.de" value="dcat:DataService — ein Dienst/API, der Zugriff auf Datensaetze bietet. endpointUrl ist die eine Wurzeladresse des Dienstes (CWM SoftwareDeployment kennt keine URL); conformsToIri nennt das Protokoll, das der Dienst umsetzt — hoechstens eines der bekannten Protokolle aus DcatVocabularies (OneProtocol), etwa OGC API Features, OData oder MQTT. Die Distributionen, die ueber den Dienst zugaenglich sind, nennen ihn als accessService; der Teil ihrer accessUrl hinter endpointUrl ist der Pfad des Datensatzes im Dienst, bei einem MQTT-Broker das Topic. servesDataset nennt die Datensaetze, und zu jedem gibt es eine Distribution mit diesem Dienst (ServedDatasetHasDistribution). provider verlinkt optional die deployte Komponente (softwaredeployment::DataProvider) fuer die Betriebssicht. Der Datendienst, den ein Portal besitzt, ist dessen Zugangsdienst."/>
      <details key="caption.de" value="Datendienst"/>
      <details key="caption.en" value="Data Service"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="EndpointUrlNotEmpty OneProtocol ServedDatasetHasDistribution"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="EndpointUrlNotEmpty" value="self.endpointUrl &lt;> null implies self.endpointUrl.size() > 0"/>
      <details key="OneProtocol" value="Sequence{'http://www.opengis.net/spec/ogcapi-features-1/', 'http://www.opengis.net/spec/iot_sensing/', 'http://docs.oasis-open.org/odata/', 'https://www.rfc-editor.org/rfc/rfc7946', 'https://spec.graphql.org/', 'https://spec.openapis.org/oas/', 'http://docs.oasis-open.org/mqtt/', 'https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/protocol/xmla', 'https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/protocol/qgis-project', 'https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/protocol/jdbc'}->select(p | self.conformsToIri->exists(i | i.size() >= p.size() and i.substring(1, p.size()) = p))->size() &lt;= 1"/>
      <details key="ServedDatasetHasDistribution" value="self.servesDataset->reject(d | d.oclIsKindOf(Catalog))->forAll(d | d.distribution->exists(x | x.accessService = self))"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="EndpointUrlNotEmpty.name" value="EndpointUrlNotEmpty"/>
      <details key="EndpointUrlNotEmpty.description" value="The endpoint URL, when set, is a non-empty string (that it is set at all, its lower bound says)."/>
      <details key="EndpointUrlNotEmpty.description.de" value="Die Endpunkt-URL ist, wenn gesetzt, eine nicht leere Zeichenkette (dass sie gesetzt ist, sagt ihre Untergrenze)."/>
      <details key="EndpointUrlNotEmpty.level" value="error"/>
      <details key="OneProtocol.name" value="OneProtocol"/>
      <details key="OneProtocol.description" value="A data service names at most one of the known protocols (DcatVocabularies.PROTOCOLS) in conformsToIri; an IRI that begins with a protocol IRI, such as a version or a conformance class, names that protocol."/>
      <details key="OneProtocol.description.de" value="Ein Datendienst nennt in conformsToIri hoechstens eines der bekannten Protokolle (DcatVocabularies.PROTOCOLS); eine IRI, die mit einer Protokoll-IRI beginnt, etwa eine Version oder Konformitaetsklasse, nennt dieses Protokoll."/>
      <details key="OneProtocol.level" value="error"/>
      <details key="ServedDatasetHasDistribution.name" value="ServedDatasetHasDistribution"/>
      <details key="ServedDatasetHasDistribution.description" value="Every dataset a service serves, catalogs excepted, has a distribution with this service as accessService."/>
      <details key="ServedDatasetHasDistribution.description.de" value="Jeder Datensatz, den ein Dienst ausliefert, Kataloge ausgenommen, hat eine Distribution mit diesem Dienst als accessService."/>
      <details key="ServedDatasetHasDistribution.level" value="warning"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endpointUrl" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:endpointURL — the one root address of the service. Required. The accessUrl of every distribution with this service starts with it (AccessUrlUnderEndpoint); the rest is the path of the dataset in the service. A service reachable under a second root is a second data service. Example: the OGC API Features service 'ogc-assets' has the root https://geo.utility.example/ogc/assets, the distribution of 'pools' in it the accessUrl https://geo.utility.example/ogc/assets/collections/pools."/>
        <details key="documentation.de" value="dcat:endpointURL — die eine Wurzeladresse des Dienstes. Pflicht. Die accessUrl jeder Distribution mit diesem Dienst beginnt damit (AccessUrlUnderEndpoint), der Rest ist der Pfad des Datensatzes im Dienst. Ist ein Dienst unter einer zweiten Wurzel erreichbar, ist das ein zweiter Datendienst. Beispiel: Der OGC-API-Features-Dienst 'ogc-assets' hat die Wurzel https://geo.utility.example/ogc/assets, die Distribution von 'pools' darin die accessUrl https://geo.utility.example/ogc/assets/collections/pools."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endpointDescription" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:endpointDescription — machine-readable description (OpenAPI, OGC GetCapabilities, SPARQL service description, WSDL) as URL or inline."/>
        <details key="documentation.de" value="dcat:endpointDescription — maschinenlesbare Beschreibung (OpenAPI, OGC GetCapabilities, SPARQL Service Description, WSDL) als URL oder inline."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="servesDataset" ordered="false" upperBound="-1"
        eType="//Dataset">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:servesDataset — the datasets this service serves; reverse role dataService. Each of them, catalogs excepted, has a distribution with this service (ServedDatasetHasDistribution); for the access service of a portal these are the portal's catalogs."/>
        <details key="documentation.de" value="dcat:servesDataset — die Datensaetze, die dieser Dienst ausliefert; Gegenrolle dataService. Jeder davon, Kataloge ausgenommen, hat eine Distribution mit diesem Dienst (ServedDatasetHasDistribution); beim Zugangsdienst eines Portals sind es die Kataloge des Portals."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="dataService"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="dataService"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="provider">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Optional bridge to the operations view: the deployed access component (softwaredeployment::DataProvider with its ProviderConnections)."/>
        <details key="documentation.de" value="Optionale Bruecke zur Betriebssicht: die deployte Zugriffskomponente (softwaredeployment::DataProvider mit ProviderConnections)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="catalogedService"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="catalogedService"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/foundation/softwaredeployment#//DataProvider"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Distribution" eSuperTypes="//DcatElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:Distribution — a concrete access form of a dataset (file download, API view, media type, size, checksum). Exists only as a child of its dataset (Dataset.distribution); dcat:isDistributionOf is the container. Accessed through a service, it is accessed through exactly one (accessService): the same dataset through two services is two distributions."/>
      <details key="documentation.de" value="dcat:Distribution — eine konkrete Zugriffsform eines Datensatzes (Datei-Download, API-Sicht, Medientyp, Groesse, Pruefsumme). Existiert nur als Kind seines Datensatzes (Dataset.distribution); dcat:isDistributionOf ist der Container. Ist sie ueber einen Dienst zugaenglich, dann ueber genau einen (accessService): Derselbe Datensatz ueber zwei Dienste sind zwei Distributionen."/>
      <details key="caption.de" value="Distribution"/>
      <details key="caption.en" value="Distribution"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ByteSizeNonNegative SpatialResolutionPositive AccessUrlUnderEndpoint"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="ByteSizeNonNegative" value="self.byteSize >= 0"/>
      <details key="SpatialResolutionPositive" value="self.spatialResolutionInMeters &lt;> null implies self.spatialResolutionInMeters.toReal() > 0"/>
      <details key="AccessUrlUnderEndpoint" value="self.accessService &lt;> null implies (let e : String = self.accessService.endpointUrl in e &lt;> null implies self.accessUrl->forAll(u | u.size() >= e.size() and u.substring(1, e.size()) = e))"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="ByteSizeNonNegative.name" value="ByteSizeNonNegative"/>
      <details key="ByteSizeNonNegative.description" value="The byte size is not negative (core::Integer is a primitive long; unset = 0)."/>
      <details key="ByteSizeNonNegative.description.de" value="Die Groesse in Bytes ist nicht negativ (core::Integer ist ein primitives long; nicht gesetzt = 0)."/>
      <details key="ByteSizeNonNegative.level" value="error"/>
      <details key="SpatialResolutionPositive.name" value="SpatialResolutionPositive"/>
      <details key="SpatialResolutionPositive.description" value="The spatial resolution, when given, is positive (core::Float is a decimal literal)."/>
      <details key="SpatialResolutionPositive.description.de" value="Die raeumliche Aufloesung ist, wenn angegeben, positiv (core::Float ist ein Dezimal-Literal)."/>
      <details key="SpatialResolutionPositive.level" value="error"/>
      <details key="AccessUrlUnderEndpoint.name" value="AccessUrlUnderEndpoint"/>
      <details key="AccessUrlUnderEndpoint.description" value="Every access URL of a distribution with an access service starts with the endpoint URL of that service."/>
      <details key="AccessUrlUnderEndpoint.description.de" value="Jede Zugangs-URL einer Distribution mit Zugangsdienst beginnt mit der Endpunkt-URL dieses Dienstes."/>
      <details key="AccessUrlUnderEndpoint.level" value="error"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accessUrl" ordered="false" lowerBound="1"
        upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:accessURL — access point(s): download page, API entry, form. For direct file access also set downloadUrl. With an accessService every accessUrl starts with the endpointUrl of the service."/>
        <details key="documentation.de" value="dcat:accessURL — Zugangspunkt(e): Downloadseite, API-Einstieg, Formular. Bei direktem Dateizugriff zusaetzlich downloadUrl setzen. Mit accessService beginnt jede accessUrl mit der endpointUrl des Dienstes."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="downloadUrl" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:downloadURL — direct download address(es) of the file."/>
        <details key="documentation.de" value="dcat:downloadURL — direkte Download-Adresse(n) der Datei."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mediaType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:mediaType — IANA media type (e.g. text/csv)."/>
        <details key="documentation.de" value="dcat:mediaType — IANA-Medientyp (z. B. text/csv)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="formatIri">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:format — file format as IRI (EU file-type) when no IANA media type fits."/>
        <details key="documentation.de" value="dcterms:format — Dateiformat als IRI (EU file-type), wenn kein IANA-Medientyp passt."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="compressFormat">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:compressFormat — media type of the compression (e.g. application/gzip)."/>
        <details key="documentation.de" value="dcat:compressFormat — Medientyp der Kompression (z. B. application/gzip)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="packageFormat">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:packageFormat — media type of the packaging (e.g. application/zip) when several files are bundled."/>
        <details key="documentation.de" value="dcat:packageFormat — Medientyp der Paketierung (z. B. application/zip), wenn mehrere Dateien gebuendelt sind."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="byteSize">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:byteSize — size in bytes (core::Integer = long)."/>
        <details key="documentation.de" value="dcat:byteSize — Groesse in Bytes (core::Integer = long)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="spatialResolutionInMeters">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:spatialResolutionInMeters — minimum resolvable distance in meters."/>
        <details key="documentation.de" value="dcat:spatialResolutionInMeters — kleinster aufgeloester Abstand in Metern."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="temporalResolution">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:temporalResolution — minimum resolvable time period as an xsd:duration literal."/>
        <details key="documentation.de" value="dcat:temporalResolution — kleinster aufgeloester Zeitabstand als xsd:duration-Literal."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="checksum" eType="//Checksum" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="spdx:checksum (new in DCAT 3) — checksum, related to downloadUrl."/>
        <details key="documentation.de" value="spdx:checksum (neu in DCAT 3) — Pruefsumme, bezogen auf downloadUrl."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="accessService" eType="//DataService">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:accessService — the one service through which this distribution is accessed; reverse role servedDistribution. Set when the distribution is the view of a dataset in a service: its accessUrl starts with the service's endpointUrl, the part behind it is the path (for MQTT the topic), and the service's protocol (conformsToIri) says how to read it. The service names the dataset in servesDataset (DistributionServiceServesDataset). Unset: a file download or a web page without a service. The same dataset through two services is two distributions. Example: the distribution 'pools-geojson' of the dataset 'pools' is accessed through 'ogc-assets' at the path collections/pools."/>
        <details key="documentation.de" value="dcat:accessService — der eine Dienst, ueber den diese Distribution zugaenglich ist; Gegenrolle servedDistribution. Gesetzt, wenn die Distribution die Sicht eines Datensatzes in einem Dienst ist: Ihre accessUrl beginnt mit der endpointUrl des Dienstes, der Teil dahinter ist der Pfad (bei MQTT das Topic), und das Protokoll des Dienstes (conformsToIri) sagt, wie er zu lesen ist. Der Dienst nennt den Datensatz in servesDataset (DistributionServiceServesDataset). Nicht gesetzt: ein Datei-Download oder eine Webseite ohne Dienst. Derselbe Datensatz ueber zwei Dienste sind zwei Distributionen. Beispiel: Die Distribution 'pools-geojson' des Datensatzes 'pools' ist ueber 'ogc-assets' unter dem Pfad collections/pools zugaenglich."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="servedDistribution"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="servedDistribution"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CatalogRecord" eSuperTypes="//DcatElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:CatalogRecord — the catalog entry as its own object: metadata about the registration (listing date = issued, modification date, metadata profile = conformsToIri), separate from the metadata of the resource itself. Child of the catalog (Catalog.record)."/>
      <details key="documentation.de" value="dcat:CatalogRecord — der Katalogeintrag als eigenes Objekt: Metadaten ueber die Registrierung (Listungsdatum = issued, Aenderungsdatum, Metadatenprofil = conformsToIri), getrennt von den Metadaten der Ressource selbst. Kind des Katalogs (Catalog.record)."/>
      <details key="caption.de" value="Katalogeintrag"/>
      <details key="caption.en" value="Catalog Record"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="primaryTopic" lowerBound="1" eType="//CatalogedResource">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="foaf:primaryTopic — the single resource this record describes; reverse role isPrimaryTopicOf."/>
        <details key="documentation.de" value="foaf:primaryTopic — die eine Ressource, die dieser Eintrag beschreibt; Gegenrolle isPrimaryTopicOf."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="isPrimaryTopicOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="isPrimaryTopicOf"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Attribution">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Responsibility of a ResponsibleParty for a resource in exactly one role — unifies dcterms:publisher/creator/contributor, dcat:contactPoint, dcterms:rightsHolder and prov:qualifiedAttribution+dcat:hadRole in one shape (agent, role). Contact data comes with the ResponsibleParty via businessinformation::Contact: the url of its one ResourceLocator (contact -> Contact.url) is its URI for every purpose — as publisher the URI of the organization, as contact point the contact page (AgentHasOneLocator); the e-mail address is in Contact.email. A contact point that needs another address than its organization is a ResponsibleParty of its own, owned by the organization's party (a ResponsibleParty is a Namespace). Example: PUBLISHER -> 'municipal-utility' (https://www.utility.example), CONTACT_POINT -> its 'customer-service' (https://www.utility.example/contact, service@utility.example)."/>
      <details key="documentation.de" value="Zustaendigkeit einer ResponsibleParty fuer eine Ressource in genau einer Rolle — vereinigt dcterms:publisher/creator/contributor, dcat:contactPoint, dcterms:rightsHolder und prov:qualifiedAttribution+dcat:hadRole in einer Form (agent, role). Kontaktdaten bringt die ResponsibleParty ueber businessinformation::Contact mit: Die url ihres einen ResourceLocator (contact -> Contact.url) ist ihre URI fuer jeden Zweck — als Herausgeber die URI der Organisation, als Kontaktstelle die Kontaktseite (AgentHasOneLocator); die E-Mail-Adresse steht in Contact.email. Braucht die Kontaktstelle eine andere Adresse als die Organisation, ist sie eine eigene ResponsibleParty, die die Organisation besitzt (ResponsibleParty ist ein Namespace). Beispiel: PUBLISHER -> 'municipal-utility' (https://www.utility.example), CONTACT_POINT -> deren 'customer-service' (https://www.utility.example/contact, service@utility.example)."/>
      <details key="caption.de" value="Attribution"/>
      <details key="caption.en" value="Attribution"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="OtherRoleNeedsIri AgentHasOneLocator"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="OtherRoleNeedsIri" value="self.role = AgentRole::OTHER implies self.roleIri &lt;> null"/>
      <details key="AgentHasOneLocator" value="self.agent &lt;> null implies self.agent.contact.url->asSet()->size() &lt;= 1"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="OtherRoleNeedsIri.name" value="OtherRoleNeedsIri"/>
      <details key="OtherRoleNeedsIri.description" value="The open role OTHER requires a refining role IRI."/>
      <details key="OtherRoleNeedsIri.description.de" value="Die offene Rolle OTHER verlangt eine praezisierende Rollen-IRI."/>
      <details key="OtherRoleNeedsIri.level" value="error"/>
      <details key="AgentHasOneLocator.name" value="AgentHasOneLocator"/>
      <details key="AgentHasOneLocator.description" value="The agent of an attribution has at most one ResourceLocator over all its contacts: its url is the party's URI; with more, the first counts."/>
      <details key="AgentHasOneLocator.description.de" value="Der Agent einer Attribution hat ueber alle seine Kontakte hoechstens einen ResourceLocator: dessen url ist die URI der Stelle; bei mehreren gilt der erste."/>
      <details key="AgentHasOneLocator.level" value="warning"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="agent" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The responsible businessinformation::ResponsibleParty (person, role or organization); reverse role attribution. Its URI is the url of its one ResourceLocator."/>
        <details key="documentation.de" value="Die zustaendige businessinformation::ResponsibleParty (Person, Rolle oder Organisation); Gegenrolle attribution. Ihre URI ist die url ihres einen ResourceLocator."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="attribution"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="attribution"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/foundation/businessinformation#//ResponsibleParty"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1" eType="//AgentRole">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The agent's role towards the resource."/>
        <details key="documentation.de" value="Die Rolle des Agenten gegenueber der Ressource."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roleIri">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Refining role IRI (prov/ISO 19115); mandatory for role=OTHER."/>
        <details key="documentation.de" value="Praezisierende Rollen-IRI (prov/ISO 19115); Pflicht bei role=OTHER."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Relationship">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcat:Relationship — qualified relation to other resources when no dcterms property fits: target(s) plus role as IRI (ISO 19115, DataCite, IANA link relations) and/or businessnomenclature::Concept."/>
      <details key="documentation.de" value="dcat:Relationship — qualifizierte Beziehung zu anderen Ressourcen, wenn keine dcterms-Property passt: Ziel(e) plus Rolle als IRI (ISO 19115, DataCite, IANA Link Relations) und/oder businessnomenclature::Concept."/>
      <details key="caption.de" value="Qualifizierte Beziehung"/>
      <details key="caption.en" value="Qualified Relationship"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="RelationshipHasRole"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="RelationshipHasRole" value="self.roleIri->notEmpty() or self.role->notEmpty()"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="RelationshipHasRole.name" value="RelationshipHasRole"/>
      <details key="RelationshipHasRole.description" value="A qualified relationship names at least one role (IRI or concept)."/>
      <details key="RelationshipHasRole.description.de" value="Eine qualifizierte Beziehung nennt mindestens eine Rolle (IRI oder Konzept)."/>
      <details key="RelationshipHasRole.level" value="error"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relation" ordered="false" lowerBound="1"
        upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcterms:relation — target(s) of the qualified relationship."/>
        <details key="documentation.de" value="dcterms:relation — Ziel(e) der qualifizierten Beziehung."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="qualifiedRelationOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="qualifiedRelationOf"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roleIri" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:hadRole as IRI (ISO 19115, DataCite, IANA link relations)."/>
        <details key="documentation.de" value="dcat:hadRole als IRI (ISO 19115, DataCite, IANA Link Relations)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="role" ordered="false" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:hadRole as in-repo anchor: businessnomenclature::Concept."/>
        <details key="documentation.de" value="dcat:hadRole als repo-interne Verankerung: businessnomenclature::Concept."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="relationshipRole"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="relationshipRole"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Concept"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PeriodOfTime">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcterms:PeriodOfTime — temporal coverage of a dataset; open intervals (start only or end only) are allowed."/>
      <details key="documentation.de" value="dcterms:PeriodOfTime — zeitliche Abdeckung eines Datensatzes; offene Intervalle (nur Anfang oder nur Ende) sind erlaubt."/>
      <details key="caption.de" value="Zeitraum"/>
      <details key="caption.en" value="Period of Time"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="StartBeforeEnd"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="StartBeforeEnd" value="(self.startDate &lt;> null and self.endDate &lt;> null) implies self.startDate &lt;= self.endDate"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="StartBeforeEnd.name" value="StartBeforeEnd"/>
      <details key="StartBeforeEnd.description" value="When both bounds are given, the period starts no later than it ends (lexical comparison of ISO 8601 values)."/>
      <details key="StartBeforeEnd.description.de" value="Sind beide Grenzen angegeben, beginnt der Zeitraum nicht nach seinem Ende (lexikalischer Vergleich der ISO-8601-Werte)."/>
      <details key="StartBeforeEnd.level" value="error"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:startDate — start of the period (ISO 8601)."/>
        <details key="documentation.de" value="dcat:startDate — Beginn des Zeitraums (ISO 8601)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Time"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:endDate — end of the period (ISO 8601)."/>
        <details key="documentation.de" value="dcat:endDate — Ende des Zeitraums (ISO 8601)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Time"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Location">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="dcterms:Location — spatial coverage: gazetteer IRI (Geonames, EU places) and/or geometry, bounding box and centroid as WKT literals (dcat:bbox, dcat:centroid, locn:geometry)."/>
      <details key="documentation.de" value="dcterms:Location — raeumliche Abdeckung: Gazetteer-IRI (Geonames, EU-Orte) und/oder Geometrie, Begrenzungsrahmen und Zentroid als WKT-Literale (dcat:bbox, dcat:centroid, locn:geometry)."/>
      <details key="caption.de" value="Ort"/>
      <details key="caption.en" value="Location"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="LocationNotEmpty"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="LocationNotEmpty" value="self.iri &lt;> null or self.geometryWkt &lt;> null or self.bboxWkt &lt;> null or self.centroidWkt &lt;> null"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="LocationNotEmpty.name" value="LocationNotEmpty"/>
      <details key="LocationNotEmpty.description" value="A location carries at least one of gazetteer IRI, geometry, bounding box or centroid."/>
      <details key="LocationNotEmpty.description.de" value="Ein Ort traegt mindestens eines von Gazetteer-IRI, Geometrie, Begrenzungsrahmen oder Zentroid."/>
      <details key="LocationNotEmpty.level" value="error"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iri">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Gazetteer IRI of the place (Geonames, EU countries/places, ATU)."/>
        <details key="documentation.de" value="Gazetteer-IRI des Ortes (Geonames, EU Countries/Places, ATU)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="geometryWkt">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="locn:geometry as WKT literal."/>
        <details key="documentation.de" value="locn:geometry als WKT-Literal."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bboxWkt">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:bbox — bounding box as WKT literal."/>
        <details key="documentation.de" value="dcat:bbox — Begrenzungsrahmen als WKT-Literal."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="centroidWkt">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="dcat:centroid — centroid as WKT literal (POINT)."/>
        <details key="documentation.de" value="dcat:centroid — Zentroid als WKT-Literal (POINT)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Checksum">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="spdx:Checksum (new in DCAT 3) — integrity checksum of a distribution, related to its downloadUrl."/>
      <details key="documentation.de" value="spdx:Checksum (neu in DCAT 3) — Integritaetspruefsumme einer Distribution, bezogen auf deren downloadUrl."/>
      <details key="caption.de" value="Pruefsumme"/>
      <details key="caption.en" value="Checksum"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ChecksumValueNotEmpty"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="ChecksumValueNotEmpty" value="self.checksumValue.size() > 0"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.dcat/constraints">
      <details key="ChecksumValueNotEmpty.name" value="ChecksumValueNotEmpty"/>
      <details key="ChecksumValueNotEmpty.description" value="The checksum value is a non-empty hex string."/>
      <details key="ChecksumValueNotEmpty.description.de" value="Der Pruefsummenwert ist eine nicht leere Hex-Zeichenkette."/>
      <details key="ChecksumValueNotEmpty.level" value="error"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="algorithm" lowerBound="1" eType="//ChecksumAlgorithm">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="spdx:algorithm — the checksum algorithm."/>
        <details key="documentation.de" value="spdx:algorithm — der Pruefsummen-Algorithmus."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="checksumValue" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="spdx:checksumValue — lowercase hex value."/>
        <details key="documentation.de" value="spdx:checksumValue — Hexwert in Kleinbuchstaben."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
