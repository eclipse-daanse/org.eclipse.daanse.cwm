  <eClassifiers xsi:type="ecore:EClass" name="SqlElement" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Lokale Wurzel aller SQL-Modellknoten. Phase 1 traegt name/description lokal; in einer spaeteren Phase erbt SqlElement von CWM ModelElement."/>
      <details key="documentation.en" value="Local root of all SQL model nodes. Phase 1 carries name/description locally; in a later phase SqlElement inherits from CWM ModelElement."/>
      <details key="caption.de" value="SQL-Element"/>
      <details key="caption.en" value="SQL Element"/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Statement" abstract="true" eSuperTypes="//SqlElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Abstrakte Wurzel einer SQL-Anweisung (Anker fuer kuenftige INSERT/UPDATE/DELETE)."/>
      <details key="documentation.en" value="Abstract root of a SQL statement (anchor for future INSERT/UPDATE/DELETE)."/>
      <details key="caption.de" value="Anweisung"/>
      <details key="caption.en" value="Statement"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Expression" abstract="true" eSuperTypes="//SqlElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Vereinheitlichte Wurzel aller Werte- und Wahrheitswert-Ausdruecke. Nach ANSI-SQL ist eine search condition eine boolean value expression und damit eine value expression; daher sind AND/OR/NOT und alle Praedikate Subtypen von Expression."/>
      <details key="documentation.en" value="Unified root of all value and boolean expressions. Per ANSI-SQL a search condition is a boolean value expression and thus a value expression; hence AND/OR/NOT and all predicates are subtypes of Expression."/>
      <details key="caption.de" value="Ausdruck"/>
      <details key="caption.en" value="Expression"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QualifiedName" eSuperTypes="//SqlElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Mehrteiliger Name (catalog.schema.table.column) als geordnete Teilliste."/>
      <details key="documentation.en" value="Multi-part name (catalog.schema.table.column) as an ordered list of parts."/>
      <details key="caption.de" value="Qualifizierter Name"/>
      <details key="caption.en" value="Qualified Name"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="parts" lowerBound="1" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Geordnete Namensbestandteile."/>
        <details key="documentation.en" value="Ordered name parts."/>
        <details key="caption.de" value="Teile"/>
        <details key="caption.en" value="Parts"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AliasDefinition" eSuperTypes="//SqlElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Anonyme Identitaet eines Alias (Spalten-Alias, Korrelationsname, CTE-Name, Fenstername). Es genuegt, dass etwas ein Alias IST; ein Name ist optional. Fehlt er, erzeugt ihn der Serializer (Dialekt-Modul). Referenziert wird ausschliesslich per Objekt."/>
      <details key="documentation.en" value="Anonymous identity of an alias (column alias, correlation name, CTE name, window name). It is enough that something IS an alias; a name is optional. If absent the serializer (dialect module) generates it. Referenced exclusively by object."/>
      <details key="caption.de" value="Alias-Definition"/>
      <details key="caption.en" value="Alias Definition"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="alias">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Optionaler expliziter Alias-Name; leer bedeutet: beim Serialisieren erzeugen."/>
        <details key="documentation.en" value="Optional explicit alias name; empty means: generate at serialization."/>
        <details key="caption.de" value="Alias"/>
        <details key="caption.en" value="Alias"/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DataTypeReference" eSuperTypes="//SqlElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Ziel-Datentyp (z.B. fuer CAST). Aufgeloest auf einen CWM DataType oder namensbasiert."/>
      <details key="documentation.en" value="Target data type (e.g. for CAST). Resolved to a CWM DataType or name-based."/>
      <details key="caption.de" value="Datentyp-Referenz"/>
