<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="sql" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.sql"
    nsPrefix="sql">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Dialekt-neutrales Datenmodell fuer SQL-Anweisungen nach ANSI-SQL-Standard (ISO/IEC 9075). Dieses Basispaket enthaelt die wiederverwendbaren Bausteine: den vereinheitlichten Ausdrucksbaum (Expression mit Praedikaten als Subtypen), Literale sowie die Alias- und Referenz-Maschinerie. SELECT-spezifische Strukturen liegen im Subpaket 'select'."/>
    <details key="documentation.en" value="Dialect-neutral data model for SQL statements following the ANSI-SQL standard (ISO/IEC 9075). This base package holds the reusable building blocks: the unified expression tree (Expression with predicates as subtypes), literals and the alias/reference machinery. SELECT-specific structures live in the 'select' subpackage."/>
    <details key="caption.de" value="SQL-Anweisung"/>
    <details key="caption.en" value="SQL Statement"/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse"/>
    <details key="prefix" value="Sql"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="fileExtensions" value="sql"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
  </eAnnotations>
