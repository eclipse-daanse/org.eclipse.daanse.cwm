    <eClassifiers xsi:type="ecore:EClass" name="Join" eSuperTypes="//select/TableReference">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Semantischer Verbund zweier Quellen: Join-Typ (was er tut) + allgemeine Bedingung. Entkoppelt von der SQL-Schreibweise; der Serializer waehlt FROM-JOIN oder WHERE. Erbt - wie alle Knoten - die Moeglichkeit, eine Beschreibung zu tragen."/>
        <details key="documentation.en" value="Semantic join of two sources: join type (what it does) + a general condition. Decoupled from SQL syntax; the serializer chooses FROM-JOIN or WHERE. Like all nodes it can carry a description."/>
        <details key="caption.de" value="Verbund"/>
        <details key="caption.en" value="Join"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="crossHasNoCondition"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="crossHasNoCondition" value="self.condition &lt;> null implies self.joinType &lt;> JoinTypeKind::CROSS"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="joinType" lowerBound="1" eType="//JoinTypeKind">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Semantische Verbund-Art (INNER/LEFT/RIGHT/FULL/CROSS)."/>
          <details key="documentation.en" value="Semantic join type (INNER/LEFT/RIGHT/FULL/CROSS)."/>
          <details key="caption.de" value="Verbund-Art"/>
          <details key="caption.en" value="Join Type"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="left" lowerBound="1" eType="//select/TableReference"
          containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Linke Quelle."/>
          <details key="documentation.en" value="Left source."/>
          <details key="caption.de" value="Links"/>
          <details key="caption.en" value="Left"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="right" lowerBound="1" eType="//select/TableReference"
          containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Rechte Quelle."/>
          <details key="documentation.en" value="Right source."/>
          <details key="caption.de" value="Rechts"/>
          <details key="caption.en" value="Right"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="condition" eType="//Expression" containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Allgemeine Verbund-Bedingung (Suchbedingung); leer bei CROSS."/>
