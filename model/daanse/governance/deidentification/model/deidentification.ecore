<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="deidentification" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.governance.deidentification"
    nsPrefix="deid">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="De-identification of the data of CWM classifiers. A de-identification policy is a core::Constraint on the classifiers whose rows it de-identifies: one treatment per feature, each with the role of the feature, the privacy models the result meets, and the outcome it claims — pseudonymous or anonymous — for an audience. A pseudonymization domain is where pseudonyms are consistent and who holds the means to reverse them. The stages Pseudonymize, Anonymize and DestroyLinkage put a policy or a domain into a retention schedule of the lifecycle model. A disclosure control protects the aggregates of cubes and measures."/>
    <details key="modelName" value="Deidentification"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse.governance"/>
    <details key="resource" value="XMI"/>
    <details key="prefix" value="Deidentification"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="invocationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="settingDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
    <details key="hiddenOpposites" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="AttributeRole">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The part a feature plays in de-identification. identifying: it names a person on its own (a name, an account number). quasiIdentifying: combined with others it may single out a person (birth date, postcode, sex). sensitive: what must not be learned about a person (a diagnosis, an income). insensitive: none of these."/>
    </eAnnotations>
    <eLiterals name="identifying"/>
    <eLiterals name="quasiIdentifying" value="1"/>
    <eLiterals name="sensitive" value="2"/>
    <eLiterals name="insensitive" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="PseudonymMethod">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How a pseudonym is made: a counter, a random value (both kept in a mapping), a hash, a hash with a secret key, an encryption that the key holder can reverse."/>
    </eAnnotations>
    <eLiterals name="counter"/>
    <eLiterals name="random" value="1"/>
    <eLiterals name="hash" value="2"/>
    <eLiterals name="keyedHash" value="3"/>
    <eLiterals name="encryption" value="4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Consistency">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Within what the same value is treated alike: in every data set (global), within one data set (perDataset), within one row (perRow: the dates of a record shift alike, so that the intervals between them stay), anew for every occurrence (perOccurrence)."/>
    </eAnnotations>
    <eLiterals name="global"/>
    <eLiterals name="perDataset" value="1"/>
    <eLiterals name="perRow" value="2"/>
    <eLiterals name="perOccurrence" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Outcome">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What a policy claims for its result. pseudonymous: the data can be linked back to a person with additional information kept separately — it is still personal data. anonymous: it cannot, by the means reasonably likely to be used."/>
    </eAnnotations>
    <eLiterals name="pseudonymous"/>
    <eLiterals name="anonymous" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DiversityVariant">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What well-represented means for l-diversity: l distinct values, an entropy of at least log l, or recursive (c, l)-diversity."/>
    </eAnnotations>
    <eLiterals name="distinct"/>
    <eLiterals name="entropy" value="1"/>
    <eLiterals name="recursive" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DisclosureMethod">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How a sensitive cell of an aggregate is protected: suppressed, perturbed by the cell-key method, or rounded."/>
    </eAnnotations>
    <eLiterals name="suppression"/>
    <eLiterals name="cellKey" value="1"/>
    <eLiterals name="rounding" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DeidentificationPolicy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ConstrainsClassifiers OneTreatmentPerFeature"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="ConstrainsClassifiers" value="self.constrainedElement->notEmpty() and self.constrainedElement->forAll(e | e.oclIsKindOf(core::Classifier))"/>
      <details key="OneTreatmentPerFeature" value="self.treatment->isUnique(t | t.feature)"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How the rows of the governed classifiers are de-identified: one treatment per feature, the privacy models the result meets, and the outcome claimed — pseudonymous or anonymous. audience: for whom the outcome holds, since anonymity depends on what a recipient can know. suppressionLimit: the share of rows that may be left out to meet the models, a decimal number between 0 and 1. The body holds the policy as text."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Constraint"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="outcome" lowerBound="1" eType="//Outcome"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The outcome the policy claims; always written."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="audience">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="For whom the outcome holds: the recipient of the de-identified data."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidAudienceOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidAudienceOf"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/foundation/businessinformation#//ResponsibleParty"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="suppressionLimit">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The share of rows that may be suppressed, between 0 and 1."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatment" ordered="false" upperBound="-1"
        eType="//Treatment" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="One treatment per feature of the governed classifiers."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="model" ordered="false" upperBound="-1"
        eType="//PrivacyModel" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The privacy models the result meets."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Treatment" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What happens to one feature of the rows: the feature, the role it plays, and in the subclass the technique."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="feature" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The feature treated."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidTreatment"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidTreatment"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1" eType="//AttributeRole"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The role of the feature; always written."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PrivacyModel" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A formal property the de-identified rows meet."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Unchanged" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The feature is kept as it is: the explicit choice for a feature that needs no treatment, or whose value the result must keep, as the sensitive feature of l-diversity."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Removal" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The feature is removed from every row."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Masking" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Characters of the value are replaced by a mask; pattern shows which: X is masked, # kept (XXXX-XXXX-XXXX-#### keeps the last four digits)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pattern" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mask: X masks a character, # keeps it."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Truncation" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Only the first keep characters of the value remain: a postcode of five digits cut to three."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keep" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How many characters remain."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Rounding" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The value is rounded to a multiple of to: an income to 1000, an age to 5."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="to" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The multiple the value is rounded to."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TopBottomCoding" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Values below low become low, values above high become high: the rare extremes that single out a person."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="low">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The lowest value kept; lower ones become it."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="high">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The highest value kept; higher ones become it."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="NoiseAddition" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Random noise is added to the value, drawn from distribution (laplace, gaussian, uniform) with scale."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scale" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The scale of the noise."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="distribution" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The distribution the noise is drawn from."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DateShift" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A date is moved by a random period of at most maximum, the same shift within consistency: perRow keeps the intervals between the dates of a record, a shift per data set reveals every date once one is known, a shift per occurrence loses the intervals."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maximum" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The largest shift, a Period literal."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.governance.lifecycle#//Period"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consistency" lowerBound="1" eType="//Consistency">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Within what the shift is the same."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Generalization" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="WidthOrGranularity"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="WidthOrGranularity" value="not self.width.oclIsUndefined() or not self.granularity.oclIsUndefined()"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The value is replaced by a coarser one: a number by an interval of width, a date or a code by its granularity (year, month, the first digits). The hierarchy of the coarser values is not modelled."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="width">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The width of the intervals a number falls into."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="granularity">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The coarser unit of a date or a code: year, month, the first three digits."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Pseudonymization" eSuperTypes="//Treatment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The value is replaced by a pseudonym made by method, the same value giving the same pseudonym within consistency, in the domain whose key or mapping links pseudonym and value."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="method" lowerBound="1" eType="//PseudonymMethod">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How the pseudonym is made."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consistency" lowerBound="1" eType="//Consistency">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Within what a value keeps its pseudonym."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="domain" eType="//PseudonymizationDomain">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The domain of the pseudonyms."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidPseudonymization"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidPseudonymization"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PseudonymizationDomain">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Where pseudonyms are consistent and who can reverse them: the key holder — a trusted third party, a trust centre, the controller — and the classifier that maps pseudonyms to values, where there is one. A retention schedule on the domain that ends in DestroyLinkage says when the link is destroyed."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="keyHolder" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Who holds the key or the mapping."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidKeyHolderOf"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidKeyHolderOf"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/foundation/businessinformation#//ResponsibleParty"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mapping">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The classifier whose rows map pseudonyms to values."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidDomainOfMapping"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidDomainOfMapping"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Classifier"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="KAnonymity" eSuperTypes="//PrivacyModel">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Every combination of quasi-identifying values is shared by at least k rows."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="k" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The least number of rows alike."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LDiversity" eSuperTypes="//PrivacyModel">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Every group of rows alike in the quasi-identifiers holds at least l well-represented values of the sensitive feature, as variant defines."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="l" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The least number of well-represented values."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="variant" lowerBound="1" eType="//DiversityVariant">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="What well-represented means."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensitive" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The sensitive feature."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidLDiversity"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidLDiversity"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TCloseness" eSuperTypes="//PrivacyModel">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="In every group of rows alike in the quasi-identifiers, the distribution of the sensitive feature is within t of its distribution over all rows."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="t" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The largest distance of the distributions, between 0 and 1."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensitive" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The sensitive feature."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidTCloseness"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidTCloseness"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DifferentialPrivacy" eSuperTypes="//PrivacyModel">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The result changes little with or without any one person: the privacy budget epsilon, and delta, the probability that the bound fails."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="epsilon" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The privacy budget."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="delta">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The probability that the bound fails."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Pseudonymize">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A stage that pseudonymizes the data after its period, by the policy. The data stays personal: the periods of the schedule go on, and a hold suspends the stage."/>
    </eAnnotations>
    <eSuperTypes href="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.governance.lifecycle#//DestructiveStage"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="policy" lowerBound="1" eType="//DeidentificationPolicy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The policy the stage applies."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidPseudonymizeStage"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidPseudonymizeStage"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Anonymize">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="PolicyIsAnonymous"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="PolicyIsAnonymous" value="self.policy.oclIsUndefined() or self.policy.outcome = Outcome::anonymous"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A terminal stage that makes the data anonymous after its period, by the policy, whose outcome is anonymous. It fulfils a deletion obligation that lets anonymization satisfy it."/>
    </eAnnotations>
    <eSuperTypes href="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.governance.lifecycle#//TerminalStage"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="policy" lowerBound="1" eType="//DeidentificationPolicy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The policy the stage applies."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidAnonymizeStage"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidAnonymizeStage"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DestroyLinkage">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A terminal stage that destroys the link of a pseudonymization domain after its period — its key or its mapping: the pseudonyms of the domain can no longer be reversed."/>
    </eAnnotations>
    <eSuperTypes href="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.governance.lifecycle#//TerminalStage"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="domain" lowerBound="1" eType="//PseudonymizationDomain">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The domain whose link is destroyed."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="deidDestroyLinkage"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="deidDestroyLinkage"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DisclosureControl">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SaysSomething"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SaysSomething" value="self.minimumCellCount > 0 or not self.dominance.oclIsUndefined()"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Protection of the aggregates of the governed cubes or measures against disclosing a person or a business: a cell of fewer than minimumCellCount contributors, or one that a few contributors dominate, is protected by method. The body holds the control as text."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Constraint"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minimumCellCount" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The least number of contributors of a cell that is shown as it is."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dominance" eType="//DominanceRule" containment="true"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The dominance rule, where there is one."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="method" lowerBound="1" eType="//DisclosureMethod">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How a sensitive cell is protected."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DominanceRule">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A cell is sensitive when its n largest contributors make up more than k percent of its total: the (n, k) rule."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="n" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How many of the largest contributors count."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="k" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The share in percent they may make up."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
