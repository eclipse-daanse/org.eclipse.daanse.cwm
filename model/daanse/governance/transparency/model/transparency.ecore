  <eClassifiers xsi:type="ecore:EClass" name="TransparencyAssessment" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Transparency assessment of a data domain according to Thuringian Transparency Act (ThuerTG). Extends core::Package; the name comes from core::ModelElement and a description is attached as businessinformation::Description. Its ratings are the typed dataClasses containment feature - keep them there. The inherited Namespace.ownedElement is only for auxiliary owned CWM objects (e.g. a businessinformation::Description)."/>
      <details key="caption.de" value="Transparenzbewertung"/>
      <details key="caption.en" value="Transparency Assessment"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="legalBasis" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Legal basis for the transparency obligation (e.g. ThuerTG §6 para. 3)"/>
        <details key="caption.de" value="Rechtsgrundlage"/>
        <details key="caption.en" value="Legal Basis"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="validFrom" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Validity start date of the transparency assessment"/>
        <details key="caption.de" value="Gueltig ab"/>
        <details key="caption.en" value="Valid From"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastReview" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Date of the last review"/>
        <details key="caption.de" value="Letzte Ueberpruefung"/>
        <details key="caption.en" value="Last Review"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="contactResponsible" lowerBound="1"
        eType="ecore:EClass http://www.omg.org/spec/CWM/1.1/foundation/businessinformation#//ResponsibleParty">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
