  <eClassifiers xsi:type="ecore:EClass" name="CriticalityAssessment" eSuperTypes="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="OnlyGovernanceContent"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="OnlyGovernanceContent" value="self.ownedElement->forAll(e | e.oclIsKindOf(CriticalityRating) or e.oclIsKindOf(ChangeAssessment) or e.oclIsKindOf(RegimeProfile) or e.oclIsKindOf(SectorProfile) or e.oclIsKindOf(EquivalenceMapping) or e.oclIsKindOf(warehouseoperation::Measurement) or e.oclIsKindOf(warehouseoperation::ChangeRequest))"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.governance.criticality/constraints">
      <details key="OnlyGovernanceContent.name" value="OnlyGovernanceContent"/>
      <details key="OnlyGovernanceContent.description" value="A criticality assessment contains only ratings, change assessments and profiles."/>
      <details key="OnlyGovernanceContent.level" value="error"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A versioned criticality assessment context for a domain, operator or service. Extends core::Package: its content lives in the inherited Namespace.ownedElement. Good owned objects (enforced by the OnlyGovernanceContent constraint): CriticalityRating, ChangeAssessment, RegimeProfile, SectorProfile, EquivalenceMapping - plus the warehouseoperation::Measurement and warehouseoperation::ChangeRequest instances the ratings reference (they get their home here, so cross-resource proxies resolve). Versioning via validFrom/validTo represents the transition from the BSI-KritisV to the KRITIS umbrella act."/>
      <details key="caption.de" value="Kritikalitaetsbewertung"/>
      <details key="caption.en" value="Criticality Assessment"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="validFrom" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Valid from."/>
        <details key="caption.de" value="Gueltig ab"/>
        <details key="caption.en" value="Valid From"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="validTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Valid to."/>
        <details key="caption.de" value="Gueltig bis"/>
        <details key="caption.en" value="Valid To"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
