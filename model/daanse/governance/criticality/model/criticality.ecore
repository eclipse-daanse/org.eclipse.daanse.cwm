<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="criticality" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.governance.criticality"
    nsPrefix="criticality">
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="invocationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="settingDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
    <details key="hiddenOpposites" value="true"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="KRITIS criticality overlay: rates how critical a CWM model object or its content is - classes, attributes, references, associations, warehouse processes, systems and changes - for banks, public authorities and network operators under NIS2, DORA, the BSI Act, the BSI-KritisV and the KRITIS umbrella act. A single generic rating attaches via element -> core::ModelElement to arbitrary objects, exactly like warehouseoperation::Measurement in the CWM core. Supersedes the empty critis placeholder package."/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse.governance"/>
    <details key="prefix" value="Criticality"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="literalsInterface" value="true"/>
    <details key="loadInitialization" value="false"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="CriticalityLevel">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Protection need per BSI IT-Grundschutz: normal, high, very high."/>
      <details key="caption.de" value="Kritikalitaetsstufe"/>
      <details key="caption.en" value="Criticality Level"/>
    </eAnnotations>
    <eLiterals name="UNASSESSED" literal="UNASSESSED">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Not yet assessed."/>
        <details key="caption.de" value="Unbewertet"/>
        <details key="caption.en" value="Not Assessed"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NORMAL" value="1" literal="NORMAL">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Impact is limited and manageable."/>
        <details key="caption.de" value="Normal"/>
        <details key="caption.en" value="Normal"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="HIGH" value="2" literal="HIGH">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Impact can be considerable."/>
        <details key="caption.de" value="Hoch"/>
        <details key="caption.en" value="High"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="VERY_HIGH" value="3" literal="VERY_HIGH">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Impact can be existentially threatening, catastrophic."/>
        <details key="caption.de" value="Sehr hoch"/>
        <details key="caption.en" value="Very High"/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="CriticalityDimension">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Rating axis. The first three are the BSI protection goals; the rest extend them with resilience, dependency and regulatory aspects from NIS2, DORA and the KRITIS umbrella act."/>
      <details key="caption.de" value="Kritikalitaetsdimension"/>
      <details key="caption.en" value="Criticality Dimension"/>
    </eAnnotations>
    <eLiterals name="CONFIDENTIALITY" literal="CONFIDENTIALITY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Protection against unauthorised disclosure."/>
        <details key="caption.de" value="Vertraulichkeit"/>
        <details key="caption.en" value="Confidentiality"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="INTEGRITY" value="1" literal="INTEGRITY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Protection against unauthorised modification."/>
        <details key="caption.de" value="Integritaet"/>
        <details key="caption.en" value="Integrity"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="AVAILABILITY" value="2" literal="AVAILABILITY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Protection against outage."/>
        <details key="caption.de" value="Verfuegbarkeit"/>
        <details key="caption.en" value="Availability"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="RECOVERY" value="3" literal="RECOVERY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Criticality of recoverability after an outage (KRITIS umbrella act)."/>
        <details key="caption.de" value="Wiederanlauf"/>
        <details key="caption.en" value="Recovery"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DEPENDENCY" value="4" literal="DEPENDENCY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Criticality from dependencies and cascade effects (DORA, KRITIS umbrella act)."/>
        <details key="caption.de" value="Abhaengigkeit"/>
        <details key="caption.en" value="Dependency"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="PUBLIC_SAFETY" value="5" literal="PUBLIC_SAFETY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Sensitivity for public order and safety."/>
        <details key="caption.de" value="Oeffentliche Sicherheit"/>
        <details key="caption.en" value="Public Safety"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MARKET_STABILITY" value="6" literal="MARKET_STABILITY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Sensitivity for financial-market and systemic stability (DORA)."/>
        <details key="caption.de" value="Marktstabilitaet"/>
        <details key="caption.en" value="Market Stability"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DISCLOSURE" value="7" literal="DISCLOSURE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Risk from disclosure or reconnaissance (e.g. installation descriptions)."/>
        <details key="caption.de" value="Offenlegung"/>
        <details key="caption.en" value="Disclosure Risk"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CHANGE" value="8" literal="CHANGE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Criticality of major changes (DORA major change)."/>
        <details key="caption.de" value="Aenderung"/>
        <details key="caption.en" value="Change Risk"/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Classification">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="German classification level (Verschlusssache) per SUeG/VSA - a confidentiality axis separate from impact level. An emergency plan can be highly available AND classified; the two are different things. English names with the German equivalent in the documentation."/>
      <details key="caption.de" value="VS-Einstufung"/>
      <details key="caption.en" value="Classification Level"/>
    </eAnnotations>
    <eLiterals name="UNCLASSIFIED" literal="UNCLASSIFIED">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Not classified (offen)."/>
        <details key="caption.de" value="Offen"/>
        <details key="caption.en" value="Unclassified"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="RESTRICTED" value="1" literal="RESTRICTED">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Restricted (VS - Nur fuer den Dienstgebrauch, VS-NfD)."/>
        <details key="caption.de" value="VS-NfD"/>
        <details key="caption.en" value="Restricted"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CONFIDENTIAL" value="2" literal="CONFIDENTIAL">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Confidential (VS - Vertraulich)."/>
        <details key="caption.de" value="VS-Vertraulich"/>
        <details key="caption.en" value="Confidential"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SECRET" value="3" literal="SECRET">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Secret (Geheim)."/>
        <details key="caption.de" value="Geheim"/>
        <details key="caption.en" value="Secret"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="TOP_SECRET" value="4" literal="TOP_SECRET">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Top secret (Streng geheim)."/>
        <details key="caption.de" value="Streng geheim"/>
        <details key="caption.en" value="Top Secret"/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="LegalRegime">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Regulatory regime under which an assessment stands."/>
      <details key="caption.de" value="Regulierungsregime"/>
      <details key="caption.en" value="Legal Regime"/>
    </eAnnotations>
    <eLiterals name="NIS2" literal="NIS2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="NIS 2 Directive (EU) 2022/2555."/>
        <details key="caption.de" value="NIS 2"/>
        <details key="caption.en" value="NIS 2"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DORA" value="1" literal="DORA">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="DORA, Regulation (EU) 2022/2554."/>
        <details key="caption.de" value="DORA"/>
        <details key="caption.en" value="DORA"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="BSIG" value="2" literal="BSIG">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="BSI Act (BSIG, 2025 revision)."/>
        <details key="caption.de" value="BSIG"/>
        <details key="caption.en" value="BSI Act"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="BSI_KRITISV" value="3" literal="BSI_KRITISV">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="BSI Critis Regulation (BSI-KritisV, transitional)."/>
        <details key="caption.de" value="BSI-KritisV"/>
        <details key="caption.en" value="BSI-KritisV"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="KRITIS_UMBRELLA_ACT" value="4" literal="KRITIS_UMBRELLA_ACT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="KRITIS umbrella act (KRITIS-Dachgesetz, 2026)."/>
        <details key="caption.de" value="KRITIS-Dachgesetz"/>
        <details key="caption.en" value="KRITIS Umbrella Act"/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CER" value="5" literal="CER">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="CER Directive (EU) 2022/2557."/>
        <details key="caption.de" value="CER"/>
        <details key="caption.en" value="CER"/>
