    <eLiterals name="calc_boolean" value="7">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A truth value."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_error" value="8">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An error value such as #DIV/0! or #N/A, arising from the evaluation of a formula."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SectionKind">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Where a region takes its delimitation from. This matters for how dependable its bounds are: a region declared in the file is binding, a detected one is merely the reading tool's conjecture."/>
    </eAnnotations>
    <eLiterals name="calc_databaseRange">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Declared in ODF as table:database-range. Grows as rows are appended and therefore often has no fixed end."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_listObject" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Declared in SpreadsheetML as a separate table part (a ListObject), with ref, headerRowCount and totalsRowCount."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_namedRange" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Delimited through a named range."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_pivotTable" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The result of a pivot or data-pilot evaluation."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_labelRange" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Declared in ODF as table:label-range: labels that let formulas address rows or columns."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_plainRegion" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Not declared in the file but detected by the reading tool from contiguously occupied cells."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_freeform" value="6">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A region without column-shaped structure - a header block, a note field. Only its position is described."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Orientation">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The direction in which the like-kinded values of a region lie."/>
    </eAnnotations>
    <eLiterals name="calc_columnwise">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Column-wise: one attribute per column, one record per row. The regular case and the shape a CSV file has as well."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="calc_rowwise" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Row-wise: one attribute per row, one record per column. The transposed case, declared in ODF through table:orientation."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
