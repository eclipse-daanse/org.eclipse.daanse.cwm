  <eClassifiers xsi:type="ecore:EClass" name="Entity" eSuperTypes="//IdentifiableType //OverrideHost">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An entity: cwmClass (inherited) is the Java class, cwmTable its primary table. The JPA entity name is the inherited name; the fully qualified class name follows from the core package chain."/>
    </eAnnotations>
