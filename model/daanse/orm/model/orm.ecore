<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="orm" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.orm"
    nsPrefix="orm">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Plain CWM object/relational mapping model with the functional scope of the Jakarta Persistence 3.1 mappings (orm.xml). It deliberately does not model the XML itself: no ExtendedMetaData, no DocumentRoot, no derived JPA name strings and no derivation OCL. The cwm* references are the single truth — object side core::Class / core::Attribute / relationships::AssociationEnd / behavioral::Operation, table side relational::NamedColumnSet / Column / ForeignKey / QueryColumnSet / Procedure. What follows from an anchor (schema, catalog, primary key, the table of a join form, SQL type, nullability) has no feature of its own. Every topic has exactly one place: join columns and foreign key in Join, tables with a join in JoinedTable, overrides and conversions in OverrideHost, the map key in MapKey; generators, queries, result-set mappings, converters and listeners only in EntityMappings. Nothing is implicit: what JPA would default (persistent attributes, column and join names, inheritance strategy) is stated in the model and checked by OrmModelValidator. All concrete classes extend OrmElement (core::ModelElement); non-containment references are hidden association ends (Property.oppositeRoleName, prefix orm) — backward navigation via InverseReferences."/>
    <details key="modelName" value="CWMORM"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse"/>
    <details key="fileExtensions" value="cwmorm"/>
    <details key="resource" value="XMI"/>
    <details key="prefix" value="CWMORM"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
    <details key="hiddenOpposites" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="AccessType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How the persistence provider accesses the state of an entity or embedded object."/>
    </eAnnotations>
    <eLiterals name="PROPERTY"/>
    <eLiterals name="FIELD" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EnumType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How a Java enum value maps to its column: by ordinal or by name."/>
    </eAnnotations>
    <eLiterals name="ORDINAL"/>
    <eLiterals name="STRING" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="FetchType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Whether the value is fetched lazily or eagerly."/>
    </eAnnotations>
    <eLiterals name="LAZY"/>
    <eLiterals name="EAGER" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GenerationType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Primary-key generation strategy. SEQUENCE and TABLE name their generator, IDENTITY, UUID and AUTO have none."/>
    </eAnnotations>
    <eLiterals name="TABLE"/>
    <eLiterals name="SEQUENCE" value="1"/>
    <eLiterals name="IDENTITY" value="2"/>
    <eLiterals name="UUID" value="3"/>
    <eLiterals name="AUTO" value="4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="InheritanceType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Inheritance mapping strategy of an entity hierarchy."/>
    </eAnnotations>
    <eLiterals name="SINGLETABLE" literal="SINGLE_TABLE"/>
    <eLiterals name="JOINED" value="1"/>
    <eLiterals name="TABLEPERCLASS" value="2" literal="TABLE_PER_CLASS"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="LockModeType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Lock mode for a named query."/>
    </eAnnotations>
    <eLiterals name="READ"/>
    <eLiterals name="WRITE" value="1"/>
    <eLiterals name="OPTIMISTIC" value="2"/>
    <eLiterals name="OPTIMISTICFORCEINCREMENT" value="3" literal="OPTIMISTIC_FORCE_INCREMENT"/>
    <eLiterals name="PESSIMISTICREAD" value="4" literal="PESSIMISTIC_READ"/>
    <eLiterals name="PESSIMISTICWRITE" value="5" literal="PESSIMISTIC_WRITE"/>
    <eLiterals name="PESSIMISTICFORCEINCREMENT" value="6" literal="PESSIMISTIC_FORCE_INCREMENT"/>
    <eLiterals name="NONE" value="7"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="CascadeKind">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Cascadable operation of a relationship."/>
    </eAnnotations>
    <eLiterals name="ALL"/>
    <eLiterals name="PERSIST" value="1"/>
    <eLiterals name="MERGE" value="2"/>
    <eLiterals name="REMOVE" value="3"/>
    <eLiterals name="REFRESH" value="4"/>
    <eLiterals name="DETACH" value="5"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="CallbackKind">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Lifecycle event of a callback method (pre/post persist, remove, update; post load)."/>
    </eAnnotations>
    <eLiterals name="PREPERSIST" literal="PRE_PERSIST"/>
    <eLiterals name="POSTPERSIST" value="1" literal="POST_PERSIST"/>
    <eLiterals name="PREREMOVE" value="2" literal="PRE_REMOVE"/>
    <eLiterals name="POSTREMOVE" value="3" literal="POST_REMOVE"/>
    <eLiterals name="PREUPDATE" value="4" literal="PRE_UPDATE"/>
    <eLiterals name="POSTUPDATE" value="5" literal="POST_UPDATE"/>
    <eLiterals name="POSTLOAD" value="6" literal="POST_LOAD"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OrmElement" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Abstract local root of the mapping world: every concrete mapping class is a core::ModelElement (inherited name, visibility, taggedValue). Where an element is anchored, its name equals the name of the anchor (the class, attribute, end, column, foreign key, operation or path); an own meaning has the name only for the entity (JPA entity name), the mapping set, generators, queries, hints, result-set mappings, column-result aliases and entity graphs."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Free-text description of the mapping element."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ManagedType" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A persistently managed Java type (entity, mapped superclass or embeddable): the cwmClass anchor plus the attribute mappings, held in typed containments. The mapping is complete: every own attribute and every navigable association end of the class has exactly one mapping, a Transient one if it is not persistent."/>
    </eAnnotations>
    <eSuperTypes href="#//OrmElement"/>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Namespace"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmClass" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mapped Java type as core::Class. The fully qualified class name follows from the owning core::Package chain."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormManagedType"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormManagedType"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" eType="//AccessType" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Access strategy for the attributes of this type."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="basic" ordered="false" upperBound="-1"
        eType="//Basic" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Basic value mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="embedded" ordered="false" upperBound="-1"
        eType="//Embedded" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Embedded value mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="transient" ordered="false" upperBound="-1"
        eType="//Transient" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Attributes and association ends excluded from persistence."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="elementCollection" ordered="false" upperBound="-1"
        eType="//ElementCollection" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Element-collection mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manyToOne" ordered="false" upperBound="-1"
        eType="//ManyToOne" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Many-to-one relationship mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="oneToMany" ordered="false" upperBound="-1"
        eType="//OneToMany" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="One-to-many relationship mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="oneToOne" ordered="false" upperBound="-1"
        eType="//OneToOne" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="One-to-one relationship mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manyToMany" ordered="false" upperBound="-1"
        eType="//ManyToMany" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Many-to-many relationship mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="IdentifiableType" abstract="true" eSuperTypes="//ManagedType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A managed type with identity: id/embeddedId/version mappings, an optional id class, the entity listeners it uses and its own lifecycle callbacks."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="id" ordered="false" upperBound="-1" eType="//Id"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Id attribute mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="embeddedId" eType="//EmbeddedId" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Composite id mapping (mutually exclusive with id mappings)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="version" ordered="false" upperBound="-1"
        eType="//Version" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Version attribute mappings."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmIdClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The composite id class, set exactly when the type has more than one id mapping."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormIdClassUser"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormIdClassUser"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="listener" upperBound="-1" eType="//EntityListener">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The entity listeners of this type in invocation order (defined in EntityMappings)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormListenerUser"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormListenerUser"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="excludeDefaultListeners" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Excludes the persistence unit's default listeners for this type."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="excludeSuperclassListeners" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Excludes superclass listeners for this type."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lifecycleCallback" ordered="false" upperBound="-1"
        eType="//LifecycleCallback" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Lifecycle callbacks implemented by operations of the type's own class."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AttributeMapping" abstract="true" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One mapped feature of a managed type. Three branches: ValueMapping (a core::Attribute), RelationshipMapping (a relationships::AssociationEnd) and Transient (either, explicitly not persistent)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" eType="//AccessType" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Access strategy override for this attribute."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ValueMapping" abstract="true" eSuperTypes="//AttributeMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Attribute mapping whose object side is a value: cwmAttribute is the mandatory core::Attribute anchor."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmAttribute" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mapped object attribute (core::Attribute) — the single truth for the attribute name, type and multiplicity."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormValueMapping"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormValueMapping"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RelationshipMapping" abstract="true" eSuperTypes="//AttributeMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Attribute mapping whose object side is an association end: cwmAssociationEnd is the mandatory relationships::AssociationEnd anchor. The target entity is cwmAssociationEnd.type — not repeated as a string."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmAssociationEnd" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mapped association end (relationships::AssociationEnd) — the single truth for name, target type and multiplicity."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormRelationshipMapping"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormRelationshipMapping"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/relationships#//AssociationEnd"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fetch" eType="//FetchType" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Fetch strategy of the relationship."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cascade" ordered="false" upperBound="-1"
        eType="//CascadeKind">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cascaded operations of the relationship."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="joinTable" eType="//JoinTable" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Maps the relationship over an intersection table."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OwnableRelationship" abstract="true" eSuperTypes="//RelationshipMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Bidirectionally mappable relationship (one-to-one, one-to-many, many-to-many): the opposite end follows from the association, so the only mapping information is which side owns it (owningSide)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="owningSide" defaultValueLiteral="true"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this side owns the mapping; the opposite end follows from the association, and exactly one side of a bidirectional relationship is the owner."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CollectionSupport" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Mixin for collection-valued mappings (element collection, one-to-many, many-to-many): ordering, order column and map key."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderBy" upperBound="-1" eType="//Ordering"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Ordering criteria over attributes of the target type, most significant first."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderColumn" eType="//Column" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A dedicated order column maintaining the list order."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mapKey" eType="//MapKey" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The key of a map-valued collection."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OverrideHost" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Mixin for the places that re-map features of another type: an entity (inherited features of mapped superclasses), an embedded or embedded-id attribute and an element collection (features of the embeddable) and a map key. Each override and conversion names its feature path as typed references."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attributeOverride" ordered="false" upperBound="-1"
        eType="//AttributeOverride" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Column overrides per feature path."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="associationOverride" ordered="false" upperBound="-1"
        eType="//AssociationOverride" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Join overrides per feature path."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="convert" ordered="false" upperBound="-1"
        eType="//Convert" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Converter applications per feature path."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Generator" abstract="true" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A primary-key value generator, defined once per mapping set and referenced by GeneratedValue.generator."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="initialValue" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Initial value of the generator."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="allocationSize" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Number of values allocated per round trip."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Query" abstract="true" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A named query of the persistence unit (JPQL, native SQL or stored procedure) with its provider hints; the query name is the inherited name."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hint" ordered="false" upperBound="-1" eType="//QueryHint"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Provider hints."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ColumnRef" abstract="true" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A reference to one catalog column; cwmColumn is the single truth for name, type, length, precision, scale and nullability."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmColumn" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The catalog column (relational::Column) — the single truth for name, type, length, precision, scale and nullability."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormColumn"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormColumn"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/resource/relational#//Column"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Column" eSuperTypes="//ColumnRef">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A mapped column: the catalog column plus the insert/update flags, the only genuine mapping information. Also used for order and map-key columns — the role follows from the containing reference."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="insertable" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the column appears in provider-generated INSERT statements."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="updatable" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the column appears in provider-generated UPDATE statements."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JoinColumn" eSuperTypes="//ColumnRef">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One column pair of a join: cwmColumn is the foreign-key column, cwmReferencedColumn the referenced (usually primary-key) column. Insert/update flags belong to the whole Join."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmReferencedColumn" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The referenced column in the target table."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormReferencingJoinColumn"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormReferencingJoinColumn"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/resource/relational#//Column"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Join" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How two tables are joined, the one place for join columns and foreign-key policy: either the catalog foreign key (its feature and uniqueKey.feature columns are the join columns) or explicit column pairs when no constraint exists. Used by to-one and one-to-many relationships, the JOINED primary-key join, association overrides, map keys and every JoinedTable."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmForeignKey">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The catalog constraint (relational::ForeignKey) the join follows; unset when no constraint exists, then the join columns name the column pairs."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormJoin"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormJoin"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/resource/relational#//ForeignKey"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="joinColumn" upperBound="-1" eType="//JoinColumn"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Explicit column pairs, only when there is no foreign key."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="insertable" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the join columns appear in provider-generated INSERT statements."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="updatable" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the join columns appear in provider-generated UPDATE statements."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JoinedTable" abstract="true" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A further table reached over a join (secondary, collection or join table). The table itself is not repeated: it is the owner of the join columns (or the table owning the foreign key)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="join" lowerBound="1" eType="//Join" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The join from this table to the owner's table; its columns live in this table."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SecondaryTable" eSuperTypes="//JoinedTable">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An additional table of an entity; its join is the primary-key join to the primary table."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CollectionTable" eSuperTypes="//JoinedTable">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The table holding an element collection; its join leads to the owner's table."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JoinTable" eSuperTypes="//JoinedTable">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An intersection table mapping a relationship: the join towards the owning side, the inverse join towards the target side."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="inverseJoin" lowerBound="1" eType="//Join"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The join from this table to the target's table."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MapKey" eSuperTypes="//OrmElement //OverrideHost">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The key of a map-valued collection, in one place: an attribute of the target type (cwmAttribute) or, when no attribute is the key, the key type (cwmClassifier) with its column, join, enum mapping, overrides and conversions."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmAttribute">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The feature of the target type acting as key; its type is the key type."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormMapKey"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormMapKey"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmClassifier">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The key type when no feature of the target is the key."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormMapKeyClassifier"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormMapKeyClassifier"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Classifier"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enumerated" eType="//EnumType" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Enum mapping of an enum key."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="column" eType="//Column" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The column holding a basic key."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="join" eType="//Join" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The join to the key entity's table for an entity key."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Ordering" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One ordering criterion of a collection: a feature path into the target type, ascending or descending; the name is the path with dots."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmPath" lowerBound="1" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The feature path to order by: first element a feature of the target type (the related entity or the element embeddable), each further element a feature of the previous type, ending in an attribute."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormOrdering"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormOrdering"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="descending">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the order is descending (default ascending)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AttributeOverride" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Overrides the column of an inherited or embedded value mapping. cwmPath is the feature path from the host (e.g. address, street); the name is the path names joined with a dot."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmPath" lowerBound="1" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The overridden feature path, first element a feature of the host's class or of the embeddable, each further element a feature of the previous type."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormAttributeOverride"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormAttributeOverride"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="column" lowerBound="1" eType="//Column"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The overriding column."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AssociationOverride" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Overrides the join or join table of an inherited or embedded relationship mapping. cwmPath is the feature path from the host; the name is the path names joined with a dot."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmPath" lowerBound="1" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The overridden feature path, ending in an association end."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormAssociationOverride"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormAssociationOverride"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="join" eType="//Join" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The overriding join."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="joinTable" eType="//JoinTable" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The overriding join table."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Convert" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Applies a converter to an attribute or disables conversion for it. An empty cwmPath means the attribute of the mapping itself; on an override host the path leads into the embedded or inherited features."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="converter" eType="//Converter">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The converter applied (exclusive with disableConversion)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormConvert"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormConvert"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="disableConversion" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Disables an otherwise auto-applied converter."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmPath" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The feature path the conversion applies to; empty for the mapped attribute itself."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormConvertPath"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormConvertPath"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//StructuralFeature"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Converter" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Registers an attribute converter: cwmClass is the converter class in the object model, its name the class name."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmClass" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The converter class in the object model."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormConverter"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormConverter"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="autoApply" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the converter applies automatically to all matching attributes."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EntityListener" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A listener class receiving lifecycle callbacks: cwmClass is the listener class in the object model, its operations are the callback methods."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmClass" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The listener class in the object model."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormEntityListener"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormEntityListener"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lifecycleCallback" ordered="false" upperBound="-1"
        eType="//LifecycleCallback" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Callbacks implemented by operations of the listener class."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LifecycleCallback" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One lifecycle callback: which event (kind) invokes which operation (cwmOperation, owned by the listener or the entity class)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="//CallbackKind">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The lifecycle event invoking the operation."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cwmOperation" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The callback operation (behavioral::Operation) of the listener or entity class."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormLifecycleCallback"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="ormLifecycleCallback"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/behavioral#//Operation"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersistenceUnitMetadata" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Metadata that applies to the whole persistence unit. The mapping is always complete; a converter to orm.xml writes metadata-complete."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="persistenceUnitDefaults" eType="//PersistenceUnitDefaults"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Defaults for the persistence unit."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersistenceUnitDefaults" eSuperTypes="//OrmElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Defaults for the persistence unit. Schema and catalog follow from the tables, the access type is EntityMappings.access."/>
    </eAnnotations>
