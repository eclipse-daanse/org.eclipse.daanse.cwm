    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A basic value mapping. Whether the value may be null follows from the multiplicity of the attribute and the nullability of the column."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="convert" eType="//Convert" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The conversion of the value (without path)."/>
