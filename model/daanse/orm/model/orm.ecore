      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The primary table (relational::NamedColumnSet; a table or updatable view). Schema and catalog follow from the table's namespace chain. Unset only for a SINGLE_TABLE subclass, which lives in the table of its root."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="ormEntity"/>
