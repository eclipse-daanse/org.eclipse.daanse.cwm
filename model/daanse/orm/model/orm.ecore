  <eClassifiers xsi:type="ecore:EClass" name="MappedSuperclass" eSuperTypes="//IdentifiableType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A mapped superclass: contributes mappings to subclasses, has no table of its own; columns it leaves open are set by every inheriting entity."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Embeddable" eSuperTypes="//ManagedType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An embeddable type: its attribute mappings apply within the owning entity's table(s); columns it leaves open are set by every embedding mapping."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Base" abstract="true" eSuperTypes="//ValueMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Value mapping with a column: the Column carries the catalog column and the insert/update flags."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="column" eType="//Column" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The mapped column with its insert/update flags; open only in a mapped superclass or embeddable whose users override it."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SimpleBase" abstract="true" eSuperTypes="//Base">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Value mapping with fetch and enum options. Temporal precision and large-object storage follow from the SQL type of the column."/>
    </eAnnotations>
