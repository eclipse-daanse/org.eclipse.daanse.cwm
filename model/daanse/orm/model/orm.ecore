  <eClassifiers xsi:type="ecore:EClass" name="Version" eSuperTypes="//Base">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An optimistic-locking version attribute mapping."/>
    </eAnnotations>
  </eClassifiers>
