<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="spatial" nsURI="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.spatial"
    nsPrefix="spatial">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Geodata for CWM attributes: what a geometry is, where and how it is held, and the rules by which keys are derived from geometry. A GeometryFeature says what a geometry is: the kind, single or multi, with a height or without, the spatial reference system and the epoch of the coordinates, the accuracy, and whether it is a geometry of its own or derived from another one (its envelope, a corner, its centroid, a point on its surface). It owns its holdings, which say where and how the values are held: one attribute with the whole geometry (WholeHolding: in the database's geometry type, as WKB, WKT or GeoJSON), one number per attribute (PartsHolding: the columns lon and lat of a table station), or several numbers in one attribute (ListHolding: an array [west, south, east, north], a text 50.93,11.59). A ReferenceSystem names a coordinate reference system by its authority and code, as an OGC URI does, with what its register defines: its kind, axes and axis order. A GeometryType is the logical data type of a property that holds a whole geometry. Distances and the bounds of distance classes are metres, whatever the reference system. A SpatialRelation says how the rows of a child geometry are assigned to the rows of a parent geometry: a predicate, what happens when several parents match or none, what is measured to divide them. A resolver evaluates it once in the database and leaves a key pair (every child at most one parent, a foreign key) or a bridge with a share (a child in several parents); from there on it is plain schema, and whoever reads it, a cube for instance, reads only keys. A GridLevel puts points into the cells of a GridSystem, a DistanceBand puts the distance to a reference geometry into classes. The model holds no coordinates and knows no OLAP class; a model that reads a result does not depend on it. Non-containment references are hidden association ends (Property.oppositeRoleName, prefix spatial)."/>
    <details key="modelName" value="Spatial"/>
    <details key="copyrightText" value="Copyright (c) 2026 Contributors to the Eclipse Foundation.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.daanse.cwm.model.daanse"/>
    <details key="resource" value="XMI"/>
    <details key="prefix" value="Spatial"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="invocationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="settingDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
    <details key="hiddenOpposites" value="true"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="GeometryFeature">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SP23 SP24 SP28 SP29 SP30 SP31 SP32 SP33 SP42 SP43 SP44 SP45 SP46 SP48 SP50 SP51 SP52"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SP23" value="not self.hasHeight or self.referenceSystem.oclIsUndefined() or self.referenceSystem.axes = 3"/>
      <details key="SP24" value="self.referenceSystem.oclIsUndefined() or not self.referenceSystem.dynamic or not self.coordinateEpoch.oclIsUndefined()"/>
      <details key="SP28" value="self.holding->forAll(h | not (h.oclIsKindOf(WholeHolding) and h.oclAsType(WholeHolding).storage = GeometryStorage::GEOJSON) or h.oclAsType(WholeHolding).axisOrder = AxisOrder::EAST_NORTH)"/>
      <details key="SP29" value="self.referenceSystem.oclIsUndefined() or self.holding->forAll(h | not (h.oclIsKindOf(WholeHolding) and h.oclAsType(WholeHolding).storage = GeometryStorage::GEOJSON)) or (not self.referenceSystem.code.oclIsUndefined() and (if self.referenceSystem.authority = ReferenceSystemAuthority::OGC then Set{'CRS84', 'CRS84h'} else Set{'4326', '4979'} endif)->includes(self.referenceSystem.code.trim()))"/>
      <details key="SP30" value="not self.referenceSystem.oclIsUndefined()"/>
      <details key="SP31" value="self.accuracy.oclIsUndefined() or (self.accuracy.trim().matches('[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?') and self.accuracy.toReal() >= 0)"/>
      <details key="SP32" value="self.coordinateEpoch.oclIsUndefined() or self.referenceSystem.oclIsUndefined() or self.referenceSystem.dynamic"/>
      <details key="SP33" value="self.coordinateEpoch.oclIsUndefined() or self.coordinateEpoch.trim().matches('[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?')"/>
      <details key="SP42" value="self.holding->notEmpty() and self.holding->forAll(h | (h.oclIsKindOf(WholeHolding) implies not h.oclAsType(WholeHolding).attribute.oclIsUndefined()) and (h.oclIsKindOf(ListHolding) implies not h.oclAsType(ListHolding).attribute.oclIsUndefined()) and (h.oclIsKindOf(PartsHolding) implies (h.oclAsType(PartsHolding).part->notEmpty() and h.oclAsType(PartsHolding).part->forAll(p | not p.attribute.oclIsUndefined()))))"/>
      <details key="SP43" value="self.holding->forAll(h | h.oclIsKindOf(WholeHolding)) or (not self.of.oclIsUndefined() and self.derivation = GeometryDerivation::ENVELOPE) or (self.kind = GeometryKind::POINT and self.multiplicity &lt;> GeometryMultiplicity::MULTI)"/>
      <details key="SP44" value="self.holding->forAll(h | (h.oclIsKindOf(PartsHolding) implies h.oclAsType(PartsHolding).part->isUnique(p | p.role)) and (h.oclIsKindOf(ListHolding) implies h.oclAsType(ListHolding).ordinate->isUnique(o | o)))"/>
      <details key="SP45" value="self.holding->select(h | not h.oclIsKindOf(WholeHolding))->forAll(h | let roles : Bag(Ordinate) = (if h.oclIsKindOf(PartsHolding) then h.oclAsType(PartsHolding).part->collect(p | p.role)->asBag() else h.oclAsType(ListHolding).ordinate->asBag() endif) in (h.oclIsKindOf(PartsHolding) and roles->isEmpty()) or (if (not self.of.oclIsUndefined() and self.derivation = GeometryDerivation::ENVELOPE) then roles->includesAll(Set{Ordinate::MIN_EAST, Ordinate::MIN_NORTH, Ordinate::MAX_EAST, Ordinate::MAX_NORTH}) and roles->excludesAll(Set{Ordinate::EAST, Ordinate::NORTH, Ordinate::HEIGHT}) else self.kind &lt;> GeometryKind::POINT or (roles->includesAll(Set{Ordinate::EAST, Ordinate::NORTH}) and roles->excludesAll(Set{Ordinate::MIN_EAST, Ordinate::MIN_NORTH, Ordinate::MAX_EAST, Ordinate::MAX_NORTH, Ordinate::MIN_HEIGHT, Ordinate::MAX_HEIGHT})) endif))"/>
      <details key="SP46" value="self.holding->select(h | not h.oclIsKindOf(WholeHolding))->forAll(h | let roles : Bag(Ordinate) = (if h.oclIsKindOf(PartsHolding) then h.oclAsType(PartsHolding).part->collect(p | p.role)->asBag() else h.oclAsType(ListHolding).ordinate->asBag() endif) in (h.oclIsKindOf(PartsHolding) and roles->isEmpty()) or (not (not self.of.oclIsUndefined() and self.derivation = GeometryDerivation::ENVELOPE) and self.kind &lt;> GeometryKind::POINT) or (let height : Set(Ordinate) = if (not self.of.oclIsUndefined() and self.derivation = GeometryDerivation::ENVELOPE) then Set{Ordinate::MIN_HEIGHT, Ordinate::MAX_HEIGHT} else Set{Ordinate::HEIGHT} endif in if self.hasHeight then roles->includesAll(height) else roles->excludesAll(height) endif))"/>
      <details key="SP48" value="self.holding->forAll(h | h.oclIsKindOf(PartsHolding) implies h.oclAsType(PartsHolding).part->collect(p | p.attribute)->select(a | not a.oclIsUndefined())->collect(a | a.owner)->select(o | not o.oclIsUndefined())->asSet()->size() &lt;= 1)"/>
      <details key="SP50" value="self.of.oclIsUndefined() or self.of->closure(of)->excludes(self)"/>
      <details key="SP51" value="self.of.oclIsUndefined() or self.referenceSystem.oclIsUndefined() or self.of.referenceSystem.oclIsUndefined() or (self.referenceSystem = self.of.referenceSystem or (self.referenceSystem.authority = self.of.referenceSystem.authority and (if self.referenceSystem.code.oclIsUndefined() then '' else self.referenceSystem.code.trim() endif) = (if self.of.referenceSystem.code.oclIsUndefined() then '' else self.of.referenceSystem.code.trim() endif) and (if self.referenceSystem.version.oclIsUndefined() or self.referenceSystem.version.trim() = '' then '0' else self.referenceSystem.version.trim() endif) = (if self.of.referenceSystem.version.oclIsUndefined() or self.of.referenceSystem.version.trim() = '' then '0' else self.of.referenceSystem.version.trim() endif)))"/>
      <details key="SP52" value="self.of.oclIsUndefined() or ((if self.derivation = GeometryDerivation::ENVELOPE then self.kind = GeometryKind::POLYGON else self.kind = GeometryKind::POINT endif) and self.multiplicity &lt;> GeometryMultiplicity::MULTI)"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.spatial/constraints">
      <details key="SP23.name" value="HeightNeedsThreeAxes"/>
      <details key="SP23.description" value="A geometry with a height has a reference system of three axes."/>
      <details key="SP23.level" value="error"/>
      <details key="SP24.name" value="EpochInADynamicSystem"/>
      <details key="SP24.description" value="A geometry feature in a dynamic reference system names the epoch its coordinates hold for."/>
      <details key="SP24.level" value="warning"/>
      <details key="SP28.name" value="GeoJsonEastFirst"/>
      <details key="SP28.description" value="A whole holding stored as GeoJSON holds its coordinates east first."/>
      <details key="SP28.level" value="error"/>
      <details key="SP29.name" value="GeoJsonInWgs84"/>
      <details key="SP29.description" value="A whole holding stored as GeoJSON holds longitude and latitude of WGS 84 (CRS84, CRS84h, EPSG 4326 or 4979)."/>
      <details key="SP29.level" value="warning"/>
      <details key="SP30.name" value="NamesItsReferenceSystem"/>
      <details key="SP30.description" value="A geometry feature names its reference system."/>
      <details key="SP30.level" value="error"/>
      <details key="SP31.name" value="AccuracyInMetres"/>
      <details key="SP31.description" value="The accuracy of a geometry feature is a decimal number of metres from zero up."/>
      <details key="SP31.level" value="error"/>
      <details key="SP32.name" value="EpochOnlyWhenDynamic"/>
      <details key="SP32.description" value="A geometry feature names a coordinate epoch only where its reference system is dynamic."/>
      <details key="SP32.level" value="error"/>
      <details key="SP33.name" value="EpochIsADecimalYear"/>
      <details key="SP33.description" value="A coordinate epoch is a decimal year."/>
      <details key="SP33.level" value="error"/>
      <details key="SP42.name" value="HeldAndNamed"/>
      <details key="SP42.description" value="A geometry feature has a holding, and each holding names its attributes."/>
      <details key="SP42.level" value="error"/>
      <details key="SP43.name" value="NumbersHoldAPointOrAnEnvelope"/>
      <details key="SP43.description" value="A geometry held as numbers is a single point, or the envelope of another geometry."/>
      <details key="SP43.level" value="error"/>
      <details key="SP44.name" value="EachRoleOnce"/>
      <details key="SP44.description" value="A holding of numbers names each role once."/>
      <details key="SP44.level" value="error"/>
      <details key="SP45.name" value="RolesFitTheShape"/>
      <details key="SP45.description" value="The roles fit the shape: a point has EAST and NORTH and no edge, an envelope its four edges and no axis of a point."/>
      <details key="SP45.level" value="error"/>
      <details key="SP46.name" value="HeightRolesExactlyWithAHeight"/>
      <details key="SP46.description" value="A geometry held as numbers has its height roles exactly where it has a height."/>
      <details key="SP46.level" value="error"/>
      <details key="SP48.name" value="PartsInOneClassifier"/>
      <details key="SP48.description" value="The attributes of a holding in parts belong to one classifier."/>
      <details key="SP48.level" value="error"/>
      <details key="SP50.name" value="NotDerivedFromItself"/>
      <details key="SP50.description" value="A geometry is not derived from itself, directly or through others."/>
      <details key="SP50.level" value="error"/>
      <details key="SP51.name" value="DerivedKeepsTheSystem"/>
      <details key="SP51.description" value="A derived geometry is in the reference system of the geometry it is derived from."/>
      <details key="SP51.level" value="error"/>
      <details key="SP52.name" value="KindFollowsDerivation"/>
      <details key="SP52.description" value="The kind follows the derivation: an envelope is a single polygon, a corner, a centroid or a point on the surface a single point."/>
      <details key="SP52.level" value="error"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What a geometry is: its kind, single or multi, with a height or without, the spatial reference system and the epoch of its coordinates, its accuracy, and whether it is a geometry of its own (the shape of a district) or derived from another one (the envelope of that shape, stored for a search by area). Where and how its values are held says each of its holdings, which it owns: the column shape of the table district (a WholeHolding), or the columns lon and lat of the table station (a PartsHolding). All holdings of one feature hold the same geometry, so that a reader takes any of them: the shape of a district in the tables district and district_archive, or the position of a station both in its geometry column and in its columns lon and lat. A feature states something about attributes, it is not one, as a units::Quantity states a unit."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="//GeometryKind">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The kind of the geometry. A derived geometry has the kind of its derivation: an envelope is a polygon, a corner, a centroid and a point on the surface are points. A geometry held as numbers is a point or an envelope."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="multiplicity" lowerBound="1" eType="//GeometryMultiplicity">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether a row holds a single geometry of the kind, a multi form, or either; a geometry held as numbers and a derived geometry are single."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hasHeight" lowerBound="1" defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the coordinates hold a height as a third value; that needs a reference system of three axes. Held as numbers, a point with a height has a HEIGHT number, an envelope with a height a MIN_HEIGHT and a MAX_HEIGHT; without a height they have none."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="referenceSystem" lowerBound="1" eType="//ReferenceSystem">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The coordinate reference system of the geometry, the same in every holding: OGC CRS84 for the longitude and latitude of weather stations, EPSG 25832 for the parcels of a land register. A derived geometry is in the system of the geometry it is derived from."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialGeometryFeatureInSystem"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialGeometryFeatureInSystem"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="coordinateEpoch">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The epoch the coordinates hold for, a decimal year such as 2010.5, stated where the reference system is dynamic and only there: with the system it is the coordinate metadata of the geometry (OGC Topic 2), so that two geometries of one dynamic system may hold two epochs."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accuracy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The positional accuracy in metres, a decimal number; for diagnostics only."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="derivation" eType="//GeometryDerivation"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the geometry is derived from the one of, and how: its ENVELOPE, a corner of the envelope, its CENTROID, a POINT_ON_SURFACE. Stated exactly where of is; unset, the geometry is one of its own, as the shape of a district is. The envelope of the shape in the column geom, stored in the columns min_x, min_y, max_x and max_y of the same table, is a feature of the derivation ENVELOPE of the shape's feature, held in parts."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="of" eType="//GeometryFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The geometry this one is derived from, as derivation says; stated exactly where derivation is. Another feature, never this one nor one derived from this one, in the same reference system: the feature of the shape of a district, of which this one is the envelope."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialDerivedGeometryFeature"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialDerivedGeometryFeature"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="holding" lowerBound="1" upperBound="-1"
        eType="//GeometryHolding" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Where and how the geometry is held, at least once: one attribute with the whole geometry, one number per attribute, or several numbers in one attribute. Several holdings hold the same geometry: the same meaning in two tables (the column shape of the tables district and district_archive), or one table that holds a point both in a geometry column and in two columns of numbers."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GeometryHolding" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Where and how a geometry is held: as a whole in one attribute (WholeHolding), as numbers one per attribute (PartsHolding), or as several numbers in one attribute (ListHolding). It is owned by the GeometryFeature that says what the geometry is; the feature may own several, each holding the same geometry. An attribute belongs to one holding only."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="WholeHolding" eSuperTypes="//GeometryHolding">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One attribute holds the whole geometry, in the form storage says: the column shape of type GEOMETRY of a PostGIS table district (NATIVE), a BLOB of well-known binary (WKB), a text of well-known text or GeoJSON, or a property of the data type Geometry of a logical model, such as a feature collection's (NATIVE). Any kind of geometry is held so. axisOrder says in which order the stored coordinates hold the first two axes."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attribute" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The attribute that holds the geometry: a relational column, a record field, or a property of a class (of the data type Geometry where the model is logical)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialWholeHolding"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialWholeHolding"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="storage" lowerBound="1" eType="//GeometryStorage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="How the attribute holds the geometry."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="axisOrder" lowerBound="1" eType="//AxisOrder">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The order in which the stored coordinates hold the first two axes: east (the longitude, the easting) first, as PostGIS, DuckDB and GeoJSON hold them, or north (the latitude, the northing) first. It may differ from the order the reference system defines (EPSG 4326 defines latitude first, a PostGIS column of it holds longitude first), and two holdings of one system may store their coordinates in two orders; GEOJSON storage holds east first always (RFC 7946)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PartsHolding" eSuperTypes="//GeometryHolding">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The geometry is held as numbers, one per attribute, each named by a CoordinatePart with its role: a table station with the columns lon and lat holds a point by the parts EAST lon and NORTH lat; the columns min_x, min_y, max_x, max_y hold the envelope of the geometry in geom by the parts MIN_EAST, MIN_NORTH, MAX_EAST and MAX_NORTH. Numbers hold a single point or the envelope of another geometry, nothing else, and the attributes of the parts belong to one classifier, so that one row holds one value. A resolver builds the geometry from them (ST_Point, ST_MakeEnvelope)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="part" lowerBound="1" upperBound="-1" eType="//CoordinatePart"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The numbers and the attributes that hold them, each role once: EAST and NORTH for a point, and HEIGHT where it has a height; MIN_EAST, MIN_NORTH, MAX_EAST and MAX_NORTH for an envelope, and MIN_HEIGHT and MAX_HEIGHT where it has a height. Their order carries no meaning: the role says which number a part is."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CoordinatePart">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One number of a geometry held in parts: its role (the axis, and for an envelope the edge) and the numeric attribute that holds it, such as the column lat of the table station for the role NORTH."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Element"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1" eType="//Ordinate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Which number the attribute holds: an axis of a point, an edge of an envelope."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attribute" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The attribute that holds the number, of a numeric type: the column lat of the table station."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialCoordinatePart"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialCoordinatePart"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ListHolding" eSuperTypes="//GeometryHolding">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The geometry is held as several numbers in one attribute, in the order of ordinate: a multi-valued attribute or an array (a column bbox of type DOUBLE[] with [west, south, east, north], as GeoJSON writes a bbox), or a text with a separator (a column position of type VARCHAR with 50.93,11.59, latitude first: the order NORTH, EAST and the separator ,). Numbers hold a single point or the envelope of another geometry, nothing else."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attribute" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The attribute that holds the numbers: a multi-valued attribute or one of an array type where there is no separator, one of a text type where there is one."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialListHolding"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialListHolding"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ordinate" unique="false" lowerBound="1"
        upperBound="-1" eType="//Ordinate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The roles of the numbers in the order they are held, each once: NORTH, EAST for the text 50.93,11.59; MIN_EAST, MIN_NORTH, MAX_EAST, MAX_NORTH for a GeoJSON bbox."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="separator">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The text between two numbers where the attribute is a text, such as , or a blank; unset where the attribute holds the numbers as several values. A number in the text is written as SQL and JSON write it: an optional sign, digits, a point before the fraction."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpatialRelation">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SP5 SP10 SP11 SP12 SP14 SP15 SP21 SP26"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SP5" value="self.parent.oclIsUndefined() or Set{SpatialPredicate::WITHIN, SpatialPredicate::COVERED_BY, SpatialPredicate::INTERSECTS, SpatialPredicate::CENTROID_WITHIN}->excludes(self.predicate) or Set{GeometryKind::POLYGON, GeometryKind::MIXED}->includes(self.parent.kind)"/>
      <details key="SP10" value="if self.predicate = SpatialPredicate::WITHIN_DISTANCE then not self.distance.oclIsUndefined() and self.distance.trim().matches('[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?') and self.distance.toReal() > 0 else self.distance.oclIsUndefined() endif"/>
      <details key="SP11" value="self.predicate &lt;> SpatialPredicate::NEAREST or self.assignment = SpatialAssignment::EXACTLY_ONE"/>
      <details key="SP12" value="not self.workingSystem.oclIsUndefined() or self.child.oclIsUndefined() or self.parent.oclIsUndefined() or self.child.referenceSystem.oclIsUndefined() or self.parent.referenceSystem.oclIsUndefined() or (self.child.referenceSystem = self.parent.referenceSystem or (self.child.referenceSystem.authority = self.parent.referenceSystem.authority and (if self.child.referenceSystem.code.oclIsUndefined() then '' else self.child.referenceSystem.code.trim() endif) = (if self.parent.referenceSystem.code.oclIsUndefined() then '' else self.parent.referenceSystem.code.trim() endif) and (if self.child.referenceSystem.version.oclIsUndefined() or self.child.referenceSystem.version.trim() = '' then '0' else self.child.referenceSystem.version.trim() endif) = (if self.parent.referenceSystem.version.oclIsUndefined() or self.parent.referenceSystem.version.trim() = '' then '0' else self.parent.referenceSystem.version.trim() endif)))"/>
      <details key="SP14" value="not self.child.oclIsUndefined() and not self.parent.oclIsUndefined() and not self.childKey.oclIsUndefined() and not self.parentKey.oclIsUndefined() and self.child.holding->collect(h | (if h.oclIsKindOf(WholeHolding) then h.oclAsType(WholeHolding).attribute->asSet() else if h.oclIsKindOf(ListHolding) then h.oclAsType(ListHolding).attribute->asSet() else h.oclAsType(PartsHolding).part->collect(p | p.attribute)->select(a | not a.oclIsUndefined())->asSet() endif endif))->collect(a | a.owner)->select(o | not o.oclIsUndefined())->asSet()->includes(self.childKey.owner) and self.parent.holding->collect(h | (if h.oclIsKindOf(WholeHolding) then h.oclAsType(WholeHolding).attribute->asSet() else if h.oclIsKindOf(ListHolding) then h.oclAsType(ListHolding).attribute->asSet() else h.oclAsType(PartsHolding).part->collect(p | p.attribute)->select(a | not a.oclIsUndefined())->asSet() endif endif))->collect(a | a.owner)->select(o | not o.oclIsUndefined())->asSet()->includes(self.parentKey.owner) and (self.explicitKey.oclIsUndefined() or self.child.holding->collect(h | (if h.oclIsKindOf(WholeHolding) then h.oclAsType(WholeHolding).attribute->asSet() else if h.oclIsKindOf(ListHolding) then h.oclAsType(ListHolding).attribute->asSet() else h.oclAsType(PartsHolding).part->collect(p | p.attribute)->select(a | not a.oclIsUndefined())->asSet() endif endif))->collect(a | a.owner)->select(o | not o.oclIsUndefined())->asSet()->includes(self.explicitKey.owner))"/>
      <details key="SP15" value="self.unmatched &lt;> UnmatchedPolicy::DROP"/>
      <details key="SP21" value="self.explicitKey.oclIsUndefined() or self.predicate &lt;> SpatialPredicate::NEAREST"/>
      <details key="SP26" value="self.resultForm &lt;> ResultForm::VIEW or (self.unmatched &lt;> UnmatchedPolicy::ERROR and (self.assignment &lt;> SpatialAssignment::EXACTLY_ONE or self.tieBreak = TieBreak::LOWEST_PARENT_KEY))"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.spatial/constraints">
      <details key="SP5.name" value="AnAreaParentForAnAreaPredicate"/>
      <details key="SP5.description" value="WITHIN, COVERED_BY, INTERSECTS and CENTROID_WITHIN have a parent of kind POLYGON or MIXED."/>
      <details key="SP5.level" value="error"/>
      <details key="SP10.name" value="DistanceOnlyForWithinDistance"/>
      <details key="SP10.description" value="A distance is given exactly with WITHIN_DISTANCE, and is above zero."/>
      <details key="SP10.level" value="error"/>
      <details key="SP11.name" value="TheNearestIsOne"/>
      <details key="SP11.description" value="NEAREST assigns EXACTLY_ONE."/>
      <details key="SP11.level" value="error"/>
      <details key="SP12.name" value="OneSystemOrAWorkingOne"/>
      <details key="SP12.description" value="Child and parent share a reference system, or a working one is named."/>
      <details key="SP12.level" value="error"/>
      <details key="SP14.name" value="KeysOfTheGeometryTables"/>
      <details key="SP14.description" value="A relation, a grid level or a band names its geometries and keys, and each key is a column of a table that holds its geometry."/>
      <details key="SP14.level" value="error"/>
      <details key="SP15.name" value="DropIsAWarning"/>
      <details key="SP15.description" value="A row without a parent, a cell or a class stays in the result; under DROP its facts vanish from the sums."/>
      <details key="SP15.level" value="warning"/>
      <details key="SP21.name" value="NoExplicitKeyForTheNearest"/>
      <details key="SP21.description" value="NEAREST takes no explicit key, which would decide the rows that carry it instead of the geometry."/>
      <details key="SP21.level" value="warning"/>
      <details key="SP26.name" value="AViewDoesNotStop"/>
      <details key="SP26.description" value="A result that has to be able to stop is a table, not a view."/>
      <details key="SP26.level" value="error"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A rule that assigns the rows of a child geometry to the rows of a parent geometry: when a parent matches (predicate), what happens when several match (assignment, weight, minimum share, tie break) or none (unmatched), in which reference system it is evaluated. A resolver evaluates it once and writes its result: a key pair (child key, parent key) for EXACTLY_ONE and LARGEST_SHARE, a bridge (child key, parent key, share) for ALL_WEIGHTED and ALL_EQUAL. It never alters a source table. The result holds no time: a territory that changes gets one result per state. Of a geometry with several holdings a resolver reads one in the table of the key, which hold the same value: a whole one where that table has one, else it builds the point or the envelope from the numbers."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="child" lowerBound="1" eType="//GeometryFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The geometry that is assigned."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialRelationAsChild"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialRelationAsChild"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" lowerBound="1" eType="//GeometryFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The geometry it is assigned to."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialRelationAsParent"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialRelationAsParent"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="childKey" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The key column of a table that holds the child geometry; the first column of the result. Where the table declares no unique key of this column alone, the rows of one key are the parts of one child and are united first (a postcode area held in four rows)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialRelationOfChildKey"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialRelationOfChildKey"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parentKey" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The key column of a table that holds the parent geometry; the second column of the result. Where the table declares no unique key of this column alone, the rows of one key are the parts of one parent and are united first."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialRelationOfParentKey"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialRelationOfParentKey"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="predicate" lowerBound="1" eType="//SpatialPredicate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="When a parent matches a child."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="distance">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The distance of WITHIN_DISTANCE in metres, a decimal number above zero, whatever the reference system it is measured in: in a geographic system it is measured on the spheroid."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="assignment" lowerBound="1" eType="//SpatialAssignment">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="What happens when more than one parent matches."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="weight" eType="//SpatialWeight" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="What is measured to compare or divide the matches of a child; in a geographic reference system areas and lengths are measured in metres on the spheroid."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unmatched" lowerBound="1" eType="//UnmatchedPolicy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="What happens when no parent matches a child."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minimumShare" defaultValueLiteral="0">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The smallest share of the child by weight that counts as a match, a decimal number from 0 below 1 (0.01 is 1 %); a smaller part is a remainder of digitising. A share, not a distance."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tieBreak" eType="//TieBreak">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Which parent wins an exact tie of EXACTLY_ONE."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="explicitKey">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A column of the child table that already holds a parent key; where it is not null it wins over the geometry (an exclave belongs where it is administered)."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialRelationOfExplicitKey"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialRelationOfExplicitKey"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workingSystem" eType="//ReferenceSystem">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The reference system in which predicate and measure are evaluated; needed where child and parent differ in their system. Where it (else the features' own system) is geographic, areas, lengths and distances are measured on the spheroid; a distance is metres in every system."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialRelationWorkingIn"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialRelationWorkingIn"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="result">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The table or view a resolver writes (a relational column set): child key, parent key and, for ALL_WEIGHTED and ALL_EQUAL, the share, in this order. Left out until a resolver has run, or declared in advance."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialRelationResult"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialRelationResult"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resultForm" lowerBound="1" eType="//ResultForm">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the result is a table or a view."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GridLevel">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SP14 SP15 SP22 SP26 SP38 SP41"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SP14" value="not self.source.oclIsUndefined() and not self.sourceKey.oclIsUndefined() and self.source.holding->collect(h | (if h.oclIsKindOf(WholeHolding) then h.oclAsType(WholeHolding).attribute->asSet() else if h.oclIsKindOf(ListHolding) then h.oclAsType(ListHolding).attribute->asSet() else h.oclAsType(PartsHolding).part->collect(p | p.attribute)->select(a | not a.oclIsUndefined())->asSet() endif endif))->collect(a | a.owner)->select(o | not o.oclIsUndefined())->asSet()->includes(self.sourceKey.owner)"/>
      <details key="SP15" value="self.unmatched &lt;> UnmatchedPolicy::DROP"/>
      <details key="SP22" value="self.source.oclIsUndefined() or self.source.kind &lt;> GeometryKind::POINT or self.source.multiplicity &lt;> GeometryMultiplicity::MULTI"/>
      <details key="SP26" value="self.resultForm &lt;> ResultForm::VIEW or self.unmatched &lt;> UnmatchedPolicy::ERROR"/>
      <details key="SP38" value="self.system.oclIsUndefined() or (self.resolution >= self.system.minResolution and self.resolution &lt;= self.system.maxResolution)"/>
      <details key="SP41" value="self.parent.oclIsUndefined() or self.system.oclIsUndefined() or self.parent.system.oclIsUndefined() or self.parent.system = self.system or (not self.system.name.oclIsUndefined() and not self.parent.system.name.oclIsUndefined() and self.parent.system.name.trim() = self.system.name.trim())"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.spatial/constraints">
      <details key="SP14.name" value="KeyOfThePointsTable"/>
      <details key="SP14.description" value="A relation, a grid level or a band names its geometries and keys, and each key is a column of a table that holds its geometry."/>
      <details key="SP14.level" value="error"/>
      <details key="SP15.name" value="DropIsAWarning"/>
      <details key="SP15.description" value="A row without a parent, a cell or a class stays in the result; under DROP its facts vanish from the sums."/>
      <details key="SP15.level" value="warning"/>
      <details key="SP22.name" value="SinglePoints"/>
      <details key="SP22.description" value="A grid level takes single points."/>
      <details key="SP22.level" value="error"/>
      <details key="SP26.name" value="AViewDoesNotStop"/>
      <details key="SP26.description" value="A result that has to be able to stop is a table, not a view."/>
      <details key="SP26.level" value="error"/>
      <details key="SP38.name" value="ResolutionInRange"/>
      <details key="SP38.description" value="The resolution of a grid level lies within the resolutions of its grid system."/>
      <details key="SP38.level" value="error"/>
      <details key="SP41.name" value="ParentOfTheSameSystem"/>
      <details key="SP41.description" value="A chain of grid levels stays within one grid system."/>
      <details key="SP41.level" value="error"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The key of the cell of a grid a point lies in, of one system and resolution; the cells of a coarser resolution are the level above. No geometric join: both the cell and its parent come from a function, and in a strictly nested grid the parent's key is the head of the cell's. A resolver writes its result, per point the source key and the cell key of each level from the top of its chain down to it; a point without a geometry gets no cell and goes as unmatched says. It never alters the table of the points. A point held as numbers (the columns lon and lat) is read as the point they make."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="//GeometryFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The points that are put into cells."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialGridLevel"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialGridLevel"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceKey" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The key column of the table that holds the points; the first column of the result. A point has one row: a key held in several rows has no one cell."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialGridLevelOfSourceKey"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialGridLevelOfSourceKey"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="system" lowerBound="1" eType="//GridSystem">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The system of the cells."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialGridLevelOfSystem"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialGridLevelOfSystem"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resolution" lowerBound="1" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The resolution, precision or zoom within the system, from its minResolution to its maxResolution; unset is none (0 is a resolution of H3)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="//GridLevel">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The coarser level above: the same system at a lower resolution, over the same points and key; a chain of levels stays within one system."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialGridLevelChild"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialGridLevelChild"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="result">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The table or view a resolver writes (a relational column set): the source key, then the cell key of each level from the top of the chain down to this one, in this order. Left out until a resolver has run, or declared in advance."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialGridLevelResult"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialGridLevelResult"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resultForm" lowerBound="1" eType="//ResultForm">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the result is a table or a view."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unmatched" lowerBound="1" eType="//UnmatchedPolicy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="What happens to a point that gets no cell (it has no geometry): it keeps a row with null cells (KEEP_NULL), a resolver stops and names it (ERROR), or it leaves the result (DROP)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DistanceBand">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SP12 SP14 SP15 SP19 SP26"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SP12" value="not self.workingSystem.oclIsUndefined() or self.source.oclIsUndefined() or self.reference.oclIsUndefined() or self.source.referenceSystem.oclIsUndefined() or self.reference.referenceSystem.oclIsUndefined() or (self.source.referenceSystem = self.reference.referenceSystem or (self.source.referenceSystem.authority = self.reference.referenceSystem.authority and (if self.source.referenceSystem.code.oclIsUndefined() then '' else self.source.referenceSystem.code.trim() endif) = (if self.reference.referenceSystem.code.oclIsUndefined() then '' else self.reference.referenceSystem.code.trim() endif) and (if self.source.referenceSystem.version.oclIsUndefined() or self.source.referenceSystem.version.trim() = '' then '0' else self.source.referenceSystem.version.trim() endif) = (if self.reference.referenceSystem.version.oclIsUndefined() or self.reference.referenceSystem.version.trim() = '' then '0' else self.reference.referenceSystem.version.trim() endif)))"/>
      <details key="SP14" value="not self.source.oclIsUndefined() and not self.reference.oclIsUndefined() and not self.sourceKey.oclIsUndefined() and self.source.holding->collect(h | (if h.oclIsKindOf(WholeHolding) then h.oclAsType(WholeHolding).attribute->asSet() else if h.oclIsKindOf(ListHolding) then h.oclAsType(ListHolding).attribute->asSet() else h.oclAsType(PartsHolding).part->collect(p | p.attribute)->select(a | not a.oclIsUndefined())->asSet() endif endif))->collect(a | a.owner)->select(o | not o.oclIsUndefined())->asSet()->includes(self.sourceKey.owner)"/>
      <details key="SP15" value="self.unmatched &lt;> UnmatchedPolicy::DROP"/>
      <details key="SP19" value="self.bound->notEmpty() and self.bound->forAll(b | b.trim().matches('[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?') and b.toReal() > 0) and Sequence{2..self.bound->size()}->forAll(i | self.bound->at(i - 1).toReal() &lt; self.bound->at(i).toReal())"/>
      <details key="SP26" value="self.resultForm &lt;> ResultForm::VIEW or self.unmatched &lt;> UnmatchedPolicy::ERROR"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.spatial/constraints">
      <details key="SP12.name" value="OneSystemOrAWorkingOne"/>
      <details key="SP12.description" value="Child and parent share a reference system, or a working one is named."/>
      <details key="SP12.level" value="error"/>
      <details key="SP14.name" value="KeyOfTheSourceTable"/>
      <details key="SP14.description" value="A relation, a grid level or a band names its geometries and keys, and each key is a column of a table that holds its geometry."/>
      <details key="SP14.level" value="error"/>
      <details key="SP15.name" value="DropIsAWarning"/>
      <details key="SP15.description" value="A row without a parent, a cell or a class stays in the result; under DROP its facts vanish from the sums."/>
      <details key="SP15.level" value="warning"/>
      <details key="SP19.name" value="BoundsAscend"/>
      <details key="SP19.description" value="The bounds of a distance band are decimal numbers above zero, strictly ascending."/>
      <details key="SP19.level" value="error"/>
      <details key="SP26.name" value="AViewDoesNotStop"/>
      <details key="SP26.description" value="A result that has to be able to stop is a table, not a view."/>
      <details key="SP26.level" value="error"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The distance of a geometry to the nearest row of a reference geometry, put into classes by upper bounds in metres (0 to 1 km, 1 to 5 km, above), like a discretization. A resolver writes its result, a pair (source key, class) per source row, the class 1 up to and including the first bound and one more above each bound; a row whose distance cannot be measured gets no class and goes as unmatched says. It never alters the source table. Each geometry is read from a holding in the table of its key, as for a relation."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="//GeometryFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The geometry whose distance is measured."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialDistanceBandAsSource"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialDistanceBandAsSource"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceKey" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The key column of the table that holds the source geometry; the first column of the result. The rows of one key are the parts of one source: the nearest of them counts."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialDistanceBandOfSourceKey"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialDistanceBandOfSourceKey"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Attribute"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reference" lowerBound="1" eType="//GeometryFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The geometry it is measured to; the nearest of its rows counts."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialDistanceBandAsReference"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialDistanceBandAsReference"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bound" unique="false" lowerBound="1" upperBound="-1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The upper bounds of the classes in metres, decimal numbers ascending, whatever the reference system the distance is measured in (in a geographic system on the spheroid). A class holds the distances up to and including its bound, a distance on a bound belongs to the class below it, and a last class above the last bound is added."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Float"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workingSystem" eType="//ReferenceSystem">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The reference system in which the distance is measured, as in a spatial relation."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialDistanceBandWorkingIn"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialDistanceBandWorkingIn"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="result">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The table or view a resolver writes (a relational column set): source key and class, in this order; the class is 1 up to and including the first bound, one more above each bound, none where no distance can be measured. Left out until a resolver has run, or declared in advance."/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml">
        <details key="Property.oppositeRoleName" value="spatialDistanceBandResult"/>
      </eAnnotations>
      <eAnnotations source="http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName">
        <details key="body" value="spatialDistanceBandResult"/>
      </eAnnotations>
      <eType xsi:type="ecore:EClass" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Class"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resultForm" lowerBound="1" eType="//ResultForm">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the result is a table or a view."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unmatched" lowerBound="1" eType="//UnmatchedPolicy">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="What happens to a source row that gets no class, because no distance can be measured (it has no geometry, or the reference has no row): it keeps a row with a null class (KEEP_NULL), a resolver stops and names it (ERROR), or it leaves the result (DROP)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ReferenceSystem">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SP34 SP35 SP36"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SP34" value="not self.code.oclIsUndefined() and self.code.trim() &lt;> ''"/>
      <details key="SP35" value="self.authority &lt;> ReferenceSystemAuthority::EPSG or self.code.oclIsUndefined() or self.code.trim() = '' or self.code.trim().matches('[+]?0*[1-9][0-9]*')"/>
      <details key="SP36" value="self.axes = 2 or self.axes = 3"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.spatial/constraints">
      <details key="SP34.name" value="HasACode"/>
      <details key="SP34.description" value="A reference system has a code."/>
      <details key="SP34.level" value="error"/>
      <details key="SP35.name" value="EpsgCodeIsAPositiveNumber"/>
      <details key="SP35.description" value="An EPSG code is a positive whole number."/>
      <details key="SP35.level" value="error"/>
      <details key="SP36.name" value="AxesTwoOrThree"/>
      <details key="SP36.description" value="A reference system has 2 or 3 axes."/>
      <details key="SP36.level" value="error"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A coordinate reference system, named as an OGC URI names it: http://www.opengis.net/def/crs/{authority}/{version}/{code}, EPSG 25832 or OGC CRS84. It holds what its register defines: its kind (degrees, a map projection, Cartesian metres), its axes and their order, and whether it is dynamic. How an attribute stores the coordinates is said by the holding (the stored order of a whole one, the roles of numbers), the epoch they hold for by the geometry feature. Owned by the model; the features and the working systems of relations and bands refer to it."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="authority" lowerBound="1" eType="//ReferenceSystemAuthority">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The register that defines the system."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="code" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The code of the system in its register, as text: 25832, 4326, CRS84, CRS84h."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version" defaultValueLiteral="0">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The version of the register's definition; none is 0, as the OGC URI writes it."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//String"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="//ReferenceSystemKind">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the coordinates are degrees, units of a map projection or Cartesian metres."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="axes" lowerBound="1" defaultValueLiteral="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The number of axes, 2 or 3 (a third for the height or, geocentric, for z)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="axisOrder" lowerBound="1" eType="//AxisOrder"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The order of the first two axes as the register defines them: east first (CRS84, EPSG 25832) or north first (EPSG 4326, EPSG 3035); the order of a request or an answer in this system. Required and stated explicitly: it has no default, since a default would copy the register wrongly for every system of the other order; unset is not stated. How an attribute stores the coordinates is said by its holding."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dynamic" lowerBound="1" defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the system moves with a tectonic plate, so that a coordinate holds for one epoch, which the geometry feature names."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GridSystem">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SP39"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
      <details key="SP39" value="self.minResolution >= 0 and self.minResolution &lt;= self.maxResolution"/>
    </eAnnotations>
    <eAnnotations source="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.spatial/constraints">
      <details key="SP39.name" value="ResolutionsInOrder"/>
      <details key="SP39.description" value="The resolutions of a grid system run from zero up, its minimum at most its maximum."/>
      <details key="SP39.level" value="error"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A system of grid cells, known to a resolver by its name, the identifier: geohash (Geohash rectangles, 1 to 12 characters), h3 (H3 hexagons, 0 to 15), quadkey (tiles of the web map, zoom 1 to 23) or a URI. It holds its resolutions and whether its cells nest. Owned by the model, once per identifier; the grid levels refer to it."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minResolution" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The coarsest resolution of the system: 1 for geohash and quadkey, 0 for h3."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxResolution" lowerBound="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The finest resolution of the system: 12 for geohash, 15 for h3, 23 for quadkey."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Integer"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nested" lowerBound="1" defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the coarser cell holds its finer cells strictly, so that the parent's key is the head of the cell's (geohash, quadkey); false where the parent is a function of the cell, which holds its finer cells only approximately (h3)."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Boolean"/>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GeometryType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The logical data type of a property that holds a whole geometry, as the SQL types of a catalog are its elements; named Geometry by convention. A property location of a feature collection is of this type and named by a WholeHolding of storage NATIVE. What the geometry is (kind, multiplicity, height, reference system) is said by the geometry feature that owns the holding, not by the type; the type says nothing of how a database stores a value: the SQL type of a column (GEOMETRY, GEOGRAPHY, a text) is no GeometryType. Numbers that hold a geometry keep their numeric types."/>
    </eAnnotations>
    <eSuperTypes href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//DataType"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GeometryKind">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The dimension of a geometry; a multi form belongs to its kind, the multiplicity says whether rows hold one."/>
    </eAnnotations>
    <eLiterals name="POINT">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A point, or several as a multi-point: a weather station, a tree, the centroid of a district, a corner of an envelope."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="LINE" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A line string, or several as a multi-line string: a river, a road, a bus route."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="POLYGON" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A polygon with its holes, or several as a multi-polygon: a district, a lake, a parcel. An envelope is a polygon."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MIXED" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Any kind, row by row: a column of geometry collections or of mixed kinds; a resolver takes each row by its own kind."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GeometryMultiplicity">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Whether a row holds one geometry of its kind (a point, a line, a polygon) or several as one (a multi-point, a multi-line, a multi-polygon), or either of the two."/>
    </eAnnotations>
    <eLiterals name="EITHER">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Some rows hold one geometry, others a multi form; the first literal, what an unset value reads."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SINGLE" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Every row holds one point, line or polygon. A geometry held as numbers and a derived geometry are single."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MULTI" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Every row holds a multi form: a multi-polygon for a commune with an exclave."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ReferenceSystemAuthority">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The register that defines a reference system: the EPSG geodetic parameter dataset, or the OGC (CRS84, CRS84h: WGS 84 with longitude first)."/>
    </eAnnotations>
    <eLiterals name="EPSG">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The EPSG geodetic parameter dataset; a code is a positive whole number, 25832 for ETRS89 / UTM zone 32N, 4326 for WGS 84."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="OGC" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Open Geospatial Consortium: CRS84 (WGS 84, longitude first) and CRS84h (with the ellipsoidal height), the defaults of OGC API Features."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ReferenceSystemKind">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What the coordinates of a reference system are: longitude and latitude in degrees (GEOGRAPHIC), easting and northing on a map projection in the unit of its axes, metres for most and feet for some (PROJECTED), or Cartesian metres from the earth's centre (GEOCENTRIC)."/>
    </eAnnotations>
    <eLiterals name="GEOGRAPHIC">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Longitude and latitude in degrees on an ellipsoid, WGS 84 or ETRS89; areas, lengths and distances are measured on the spheroid."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="PROJECTED" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Easting and northing on a map projection in the unit of its axes, metres for UTM and LAEA; areas, lengths and distances are measured in its plane."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="GEOCENTRIC" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cartesian x, y and z in metres from the earth's centre, EPSG 4978; the planar functions read x and y only."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="AxisOrder">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The order of the first two axes: east (x: the longitude, the easting) first, or north (y: the latitude, the northing) first. A reference system states the order its register defines; a whole holding the order its stored coordinates hold. Numbers have no order of axes: their roles say which number is which."/>
    </eAnnotations>
    <eLiterals name="EAST_NORTH">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="East first: x then y, longitude then latitude; the order CRS84 and EPSG 25832 define, and the order in which PostGIS, DuckDB and GeoJSON store coordinates."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NORTH_EAST" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="North first: y then x, latitude then longitude; the order EPSG 4326 and EPSG 3035 define."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GeometryStorage">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How the attribute of a whole holding holds the geometry: in a geometry type, or as well-known binary, well-known text or GeoJSON, which a resolver converts first. A geometry held as numbers has no storage; its holding is a PartsHolding or a ListHolding."/>
    </eAnnotations>
    <eLiterals name="NATIVE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A geometry type: the database's own (GEOMETRY or GEOGRAPHY of PostGIS, GEOMETRY of DuckDB spatial, SDO_GEOMETRY of Oracle), or the data type Geometry of a property of a logical model."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="WKB" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Well-known binary of OGC Simple Features, or its extended form EWKB, in a binary column."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="WKT" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Well-known text in a text column: POINT (11.59 50.93)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="GEOJSON" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A GeoJSON geometry object in a text or JSON column: {&quot;type&quot;: &quot;Point&quot;, &quot;coordinates&quot;: [11.59, 50.93]}; longitude and latitude of WGS 84, east first (RFC 7946)."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Ordinate">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The role of one number of a geometry held as numbers: the axis it lies on and, for an envelope, the edge. The axes are named by direction, whatever the reference system calls them: east is the longitude in a geographic system (WGS 84, ETRS89) and the easting in a projected one (UTM); north is the latitude or the northing. The roles say which number is which axis, so that a holding of numbers has no stored axis order."/>
    </eAnnotations>
    <eLiterals name="EAST">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="East of a point: the longitude in a geographic system (11.59 for Jena in WGS 84), the easting in metres in a projected one (ETRS89 / UTM zone 32N)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NORTH" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="North of a point: the latitude in a geographic system (50.93 for Jena in WGS 84), the northing in metres in a projected one."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="HEIGHT" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The height of a point, the third axis of a system of three axes: the ellipsoidal height in metres of CRS84h. Held exactly where the geometry has a height."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MIN_EAST" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The west edge of an envelope (minx of a bounding box): its least longitude in a geographic system, its least easting in a projected one. An envelope across the antimeridian has its west edge east of its east edge, as a GeoJSON bbox writes it."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MIN_NORTH" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The south edge of an envelope (miny): its least latitude or northing."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MAX_EAST" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The east edge of an envelope (maxx): its greatest longitude or easting."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MAX_NORTH" value="6">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The north edge of an envelope (maxy): its greatest latitude or northing."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MIN_HEIGHT" value="7">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The lowest height of an envelope with a height (minz)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MAX_HEIGHT" value="8">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The highest height of an envelope with a height (maxz)."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GeometryDerivation">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How a geometry is derived from another one, the one its feature names as of. A derived geometry is stored beside the one it comes from so that a reader need not compute it: a bounding box in four columns for a search by area, a centroid to place a label. A feature without a derivation is a geometry of its own."/>
    </eAnnotations>
    <eLiterals name="ENVELOPE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The envelope: the least rectangle along the axes that holds the geometry, its bounding box, a single POLYGON. The four columns min_x, min_y, max_x, max_y of the geometry in geom; a GeoJSON bbox; a polygon in a column extent."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CORNER_SOUTH_WEST" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The south-west corner of the envelope, its least east and least north, a single POINT; with CORNER_NORTH_EAST it gives the envelope as its least and its greatest corner."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CORNER_NORTH_EAST" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The north-east corner of the envelope, its greatest east and greatest north, a single POINT; the opposite of CORNER_SOUTH_WEST."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CORNER_NORTH_WEST" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The north-west corner of the envelope, its least east and greatest north, a single POINT: the upper left of a map; with CORNER_SOUTH_EAST it gives the envelope as its upper left and its lower right corner."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CORNER_SOUTH_EAST" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The south-east corner of the envelope, its greatest east and least north, a single POINT: the lower right of a map; the opposite of CORNER_NORTH_WEST."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CENTROID" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The centroid, the centre of mass of the geometry, a single POINT; it may lie outside the geometry, as the centroid of a crescent does."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="POINT_ON_SURFACE" value="6">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A point that lies on the geometry for certain, as ST_PointOnSurface gives it, a single POINT: where a label is placed, or by which an area is assigned."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SpatialPredicate">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="When a parent matches a child: the child lies within the parent (Within of OGC Simple Features), no point of the child lies outside the parent (CoveredBy as JTS, GEOS and PostGIS define it; unlike Within, a point on a border meets it), the two share a point (Intersects of OGC Simple Features), one point of the child lies within the parent (CENTROID_WITHIN: the child's centroid where it lies on the child, else a point on the child's surface, so that a crescent is placed by a point of its own), the parent is the nearest, or it lies within a distance."/>
    </eAnnotations>
    <eLiterals name="WITHIN">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The child lies within the parent: Within of OGC Simple Features; a point on the parent's border does not match."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="COVERED_BY" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="No point of the child lies outside the parent: CoveredBy as JTS, GEOS and PostGIS define it; the only predicate a point on a border meets."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="INTERSECTS" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The child and the parent share a point: Intersects of OGC Simple Features; a river matches every country it touches."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="CENTROID_WITHIN" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="One point of the child lies within the parent: its centroid where that lies on the child, else a point on its surface; a commune is placed in one county."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NEAREST" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent is the nearest one; it assigns EXACTLY_ONE."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="WITHIN_DISTANCE" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent lies within the distance of the relation, in metres."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SpatialAssignment">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What happens when several parents match: at most one may (EXACTLY_ONE), the one with the largest part wins (LARGEST_SHARE), all stay with their parts divided by their sum (ALL_WEIGHTED), or all stay with equal shares (ALL_EQUAL)."/>
    </eAnnotations>
    <eLiterals name="EXACTLY_ONE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="At most one parent may match; a second is an error, or broken by the tie break. The result is a foreign key."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="LARGEST_SHARE" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent with the largest part of the child by weight wins. The result is a foreign key."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ALL_WEIGHTED" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="All matching parents stay, each with its part by weight divided by their sum. The result is a bridge with a share."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ALL_EQUAL" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="All matching parents stay with equal shares, 1/n each. The result is a bridge with a share."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SpatialWeight">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What is measured to compare or divide the matches of a child: the area of the intersection relative to the child's area, or the length relative to the child's length."/>
    </eAnnotations>
    <eLiterals name="AREA">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The area of the intersection relative to the area of the child, for a polygon."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="LENGTH" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The length of the intersection relative to the length of the child, for a line."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="UnmatchedPolicy">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="What happens to a row a rule cannot place (a child no parent matches, a point without a cell, a source whose distance cannot be measured): it stays with a null parent key, cell or class (KEEP_NULL; how that shows is the policy of the model that reads the result), a resolver stops and names it (ERROR), or it leaves the result (DROP)."/>
    </eAnnotations>
    <eLiterals name="KEEP_NULL">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The row stays with a null parent key, cell or class; the first literal, what an unset value reads."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ERROR" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A resolver stops and names the rows it cannot place."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DROP" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The row leaves the result; facts that reach the parent through it vanish from the sums."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="TieBreak">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Which parent wins an exact tie of EXACTLY_ONE: none, the tie is an error (as without a tie break), or the parent with the lowest key."/>
    </eAnnotations>
    <eLiterals name="ERROR">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="No parent wins: the tie is an error, as without a tie break."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="LOWEST_PARENT_KEY" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The parent with the lowest key wins, so that a view need not stop."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ResultForm">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How a resolver leaves its result: a table written once, which any database reads, or a view recomputed whenever read, which needs the spatial functions in the database."/>
    </eAnnotations>
    <eLiterals name="TABLE">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A table written once; any database reads it, and a rule that has to stop can."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="VIEW" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A view recomputed whenever it is read; it needs the spatial functions and cannot stop."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
</ecore:EPackage>
