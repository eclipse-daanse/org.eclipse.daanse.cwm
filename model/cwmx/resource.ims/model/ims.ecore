    <eClassifiers xsi:type="ecore:EEnum" name="AlgorithmType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="LPointer types"/>
      </eAnnotations>
      <eLiterals name="imsat_0">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Specifies that IMS chooses which HD space search algorithm to use.  Maps to a value of SEARCHA=0."/>
        </eAnnotations>
      </eLiterals>
      <eLiterals name="imsat_1" value="1">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Specifies that IMS uses the HD space search algorithm that does not search for space in the second-most desirable block or CI. Maps to SEARCHA=1"/>
        </eAnnotations>
      </eLiterals>
      <eLiterals name="imsat_2" value="2">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Specifies that IMS uses the HD space search algorithm that includes a search for space in the second-most desirable block or CI. Maps to SEARCHA=2"/>
        </eAnnotations>
      </eLiterals>
    </eClassifiers>
