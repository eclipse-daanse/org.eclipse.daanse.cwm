<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.daanse</groupId>
    <artifactId>org.eclipse.daanse.cwm.resource.relational</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>org.eclipse.daanse.cwm.resource.relational.jdbc.standalone</artifactId>
  <name>Daanse CWM Relational JDBC without OSGi</name>
  <description>A live database and a CWM relational model, both ways, without OSGi. CwmJdbcImport
    connects (by URL, DataSource or connection), takes one JDBC metadata snapshot with the metadata
    provider of the database product, and runs on it the CwmLoader (structure) with the
    PrivilegeLoader as its part (roles, users and their privileges), cut to a selection.
    CwmJdbcExport cuts a model to a selection, writes its DDL in the dialect of the database
    (ddl.render) and runs it, with dropFirst idempotently and in one transaction where the database
    runs DDL in transactions. Wired by hand where OSGi wires the services. The core of the Maven goals
    cwm-jdbc:import and cwm-jdbc:export (maven/jdbc); brings emf/standalone for reading and writing
    the XMI.</description>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.resource.relational.load.jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.resource.relational.load.privilege</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the snapshot: DatabaseService implementation and the metadata providers per database -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.sql.jdbc.impl</artifactId>
      <version>${jdbc-db.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.sql.jdbc.metadata</artifactId>
      <version>${jdbc-db.version}</version>
    </dependency>
    <!-- the DDL of a model per dialect, and the dialect of a connection -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.resource.relational.ddl.render</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- reading and writing CWM XMI outside OSGi -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.emf.standalone</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- test: PostgreSQL in a container, whose metadata report privileges -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.jdbc.datasource.testkit.postgresql</artifactId>
      <version>0.0.1-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.14</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <!-- test: MySQL in a container, which has no IF EXISTS for DROP CONSTRAINT and DROP INDEX -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.jdbc.datasource.testkit.mysql</artifactId>
      <version>0.0.1-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>9.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <version>1.21.4</version>
      <scope>test</scope>
    </dependency>
    <!-- test: in-process databases to import from and export into -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.5.252</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <version>2.0.0.1</version>
      <scope>test</scope>
    </dependency>
    <!-- test: what was written compared with what is read back -->
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.cwm.resource.relational.diff</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
