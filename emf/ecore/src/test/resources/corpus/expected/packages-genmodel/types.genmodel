  </genPackages>
  <genPackages prefix="Classes" basePackage="org.example" disposableProviderFactory="true">
    <ecorePackage href="classes.ecore#/"/>
    <genClasses>
      <ecoreClass href="classes.ecore#//Customer"/>
      <genFeatures createChild="false">
        <ecoreFeature xsi:type="ecore:EAttribute" href="classes.ecore#//Customer/number"/>
      </genFeatures>
      <genFeatures createChild="false">
        <ecoreFeature xsi:type="ecore:EAttribute" href="classes.ecore#//Customer/status"/>
      </genFeatures>
    </genClasses>
    <nestedGenPackages prefix="Enumerations" disposableProviderFactory="true">
      <ecorePackage href="classes.ecore#//enumerations"/>
      <genEnums typeSafeEnumCompatible="false">
        <ecoreEnum href="classes.ecore#//enumerations/Status"/>
        <genEnumLiterals>
          <ecoreEnumLiteral href="classes.ecore#//enumerations/Status/OPEN"/>
        </genEnumLiterals>
        <genEnumLiterals>
          <ecoreEnumLiteral href="classes.ecore#//enumerations/Status/CLOSED"/>
        </genEnumLiterals>
      </genEnums>
    </nestedGenPackages>
    <nestedGenPackages prefix="Pricing" disposableProviderFactory="true">
      <ecorePackage href="classes.ecore#//pricing"/>
      <genClasses>
        <ecoreClass href="classes.ecore#//pricing/Price"/>
        <genFeatures createChild="false">
          <ecoreFeature xsi:type="ecore:EAttribute" href="classes.ecore#//pricing/Price/amount"/>
