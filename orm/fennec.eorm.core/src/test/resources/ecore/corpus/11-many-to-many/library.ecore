<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="library" nsURI="http://daanse.eclipse.org/cwm/ecore/library" nsPrefix="library">
  <eClassifiers xsi:type="ecore:EClass" name="Book">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="#//long"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authors" ordered="false" upperBound="-1" eType="#//Author" eOpposite="#//Author/books"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="long" instanceClassName="long"/>
  <eClassifiers xsi:type="ecore:EClass" name="Author">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="#//long"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="books" ordered="false" upperBound="-1" eType="#//Book" eOpposite="#//Book/authors"/>
  </eClassifiers>
</ecore:EPackage>
