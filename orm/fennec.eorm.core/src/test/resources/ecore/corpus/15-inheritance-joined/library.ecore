<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="library" nsURI="http://daanse.eclipse.org/cwm/ecore/library" nsPrefix="library">
  <eClassifiers xsi:type="ecore:EClass" name="Media" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="#//long"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="#//String"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="long" instanceClassName="long"/>
  <eClassifiers xsi:type="ecore:EDataType" name="String" instanceClassName="java.lang.String"/>
  <eClassifiers xsi:type="ecore:EClass" name="Book" eSuperTypes="#//Media">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pages" eType="#//int"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="int" instanceClassName="int"/>
  <eClassifiers xsi:type="ecore:EClass" name="Dvd" eSuperTypes="#//Media">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minutes" eType="#//int"/>
  </eClassifiers>
</ecore:EPackage>
