<?xml version="1.0" encoding="UTF-8"?>
<relational:Catalog xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:businessinformation="http://www.omg.org/spec/CWM/1.1/foundation/businessinformation" xmlns:relational="http://www.omg.org/spec/CWM/1.1/resource/relational" xmi:id="Catalog_LIBRARYDB" name="LIBRARYDB">
  <ownedElement xsi:type="relational:Schema" xmi:id="Schema_LIBRARYDB.LIB" name="LIB">
    <ownedElement xsi:type="relational:Table" xmi:id="Table_LIBRARYDB.LIB.BOOK" name="BOOK">
      <ownedElement xsi:type="relational:PrimaryKey" xmi:id="PrimaryKey_LIBRARYDB.LIB.BOOK.PK_BOOK" name="PK_BOOK" feature="Column_LIBRARYDB.LIB.BOOK.ID" keyRelationship="ForeignKey_LIBRARYDB.LIB.LOAN.FK_LOAN_BOOK"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.BOOK.ID" name="ID" type="SQLSimpleType_LIBRARYDB.BIGINT"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.BOOK.TITLE" name="TITLE" type="SQLSimpleType_LIBRARYDB.VARCHAR"/>
    </ownedElement>
    <ownedElement xsi:type="relational:Table" xmi:id="Table_LIBRARYDB.LIB.LOAN" name="LOAN">
      <ownedElement xsi:type="relational:PrimaryKey" xmi:id="PrimaryKey_LIBRARYDB.LIB.LOAN.PK_LOAN" name="PK_LOAN" feature="Column_LIBRARYDB.LIB.LOAN.ID"/>
      <ownedElement xsi:type="relational:ForeignKey" xmi:id="ForeignKey_LIBRARYDB.LIB.LOAN.FK_LOAN_BOOK" name="FK_LOAN_BOOK" feature="Column_LIBRARYDB.LIB.LOAN.BOOK_ID" uniqueKey="PrimaryKey_LIBRARYDB.LIB.BOOK.PK_BOOK"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.LOAN.ID" name="ID" type="SQLSimpleType_LIBRARYDB.BIGINT"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.LOAN.BOOK_ID" name="BOOK_ID" type="SQLSimpleType_LIBRARYDB.BIGINT"/>
    </ownedElement>
    <ownedElement xsi:type="relational:QueryColumnSet" xmi:id="QueryColumnSet_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS" name="BOOK_LOAN_STATISTICS">
      <ownedElement xsi:type="businessinformation:Description" xmi:id="Description_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS.Doc_BOOK_LOAN_STATISTICS" name="Doc_BOOK_LOAN_STATISTICS" body="The report as a stored query of the schema: the SQL text is its query expression, the result columns are its columns — including the computed ones." language="en" type="text/plain" modelElement="QueryColumnSet_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS.ID" name="ID" type="SQLSimpleType_LIBRARYDB.BIGINT"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS.B_TITLE" name="B_TITLE" type="SQLSimpleType_LIBRARYDB.VARCHAR"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS.BOOK_ID" name="BOOK_ID" type="SQLSimpleType_LIBRARYDB.BIGINT"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS.LOAN_COUNT" name="LOAN_COUNT" type="SQLSimpleType_LIBRARYDB.BIGINT"/>
      <feature xsi:type="relational:Column" xmi:id="Column_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS.TOTAL" name="TOTAL" type="SQLSimpleType_LIBRARYDB.BIGINT"/>
      <query xmi:id="QueryExpression_LIBRARYDB.LIB.BOOK_LOAN_STATISTICS.query" body="SELECT b.ID, b.TITLE AS B_TITLE, l.BOOK_ID, COUNT(l.ID) AS LOAN_COUNT, SUM(COUNT(l.ID)) OVER () AS TOTAL FROM BOOK b LEFT JOIN LOAN l ON l.BOOK_ID = b.ID GROUP BY b.ID, b.TITLE, l.BOOK_ID" language="SQL"/>
    </ownedElement>
  </ownedElement>
  <ownedElement xsi:type="relational:SQLSimpleType" xmi:id="SQLSimpleType_LIBRARYDB.BIGINT" name="BIGINT"/>
  <ownedElement xsi:type="relational:SQLSimpleType" xmi:id="SQLSimpleType_LIBRARYDB.VARCHAR" name="VARCHAR"/>
