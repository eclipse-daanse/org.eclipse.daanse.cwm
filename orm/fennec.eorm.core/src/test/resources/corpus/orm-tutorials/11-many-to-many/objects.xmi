<?xml version="1.0" encoding="UTF-8"?>
<core:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:businessinformation="http://www.omg.org/spec/CWM/1.1/foundation/businessinformation" xmlns:core="http://www.omg.org/spec/CWM/1.1/objectmodel/core" xmlns:relationships="http://www.omg.org/spec/CWM/1.1/objectmodel/relationships" xmi:id="Package_library" name="library">
  <ownedElement xsi:type="core:Class" xmi:id="Class_library.Book" name="Book">
    <feature xsi:type="core:Attribute" xmi:id="Attribute_library.Book.id" name="id" type="DataType_library.long"/>
  </ownedElement>
  <ownedElement xsi:type="core:DataType" xmi:id="DataType_library.long" name="long"/>
  <ownedElement xsi:type="core:Class" xmi:id="Class_library.Author" name="Author">
    <feature xsi:type="core:Attribute" xmi:id="Attribute_library.Author.id" name="id" type="DataType_library.long"/>
  </ownedElement>
  <ownedElement xsi:type="relationships:Association" xmi:id="Association_library.BookAuthor" name="BookAuthor">
    <ownedElement xsi:type="businessinformation:Description" xmi:id="Description_library.BookAuthor.Doc_BookAuthor" name="Doc_BookAuthor" body="m:n — a book has several authors, an author writes several books. On the object side ONE association; the intersection table is a purely relational artifact." language="en" type="text/plain" modelElement="Association_library.BookAuthor"/>
    <feature xsi:type="relationships:AssociationEnd" xmi:id="AssociationEnd_library.BookAuthor.books" name="books" type="Class_library.Book" isNavigable="true">
      <multiplicity xmi:id="Multiplicity_library.BookAuthor.books.multiplicity">
        <range xmi:id="MultiplicityRange_library.BookAuthor.books.multiplicity.range" upper="-1"/>
      </multiplicity>
    </feature>
    <feature xsi:type="relationships:AssociationEnd" xmi:id="AssociationEnd_library.BookAuthor.authors" name="authors" type="Class_library.Author" isNavigable="true">
      <multiplicity xmi:id="Multiplicity_library.BookAuthor.authors.multiplicity">
        <range xmi:id="MultiplicityRange_library.BookAuthor.authors.multiplicity.range" upper="-1"/>
      </multiplicity>
    </feature>
  </ownedElement>
</core:Package>
