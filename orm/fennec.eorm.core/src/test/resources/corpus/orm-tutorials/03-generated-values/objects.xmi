    <ownedElement xsi:type="businessinformation:Description" xmi:id="Description_library.Loan.Doc_Loan" name="Doc_Loan" body="Loan — number from the database sequence SEQ_LOAN (SEQUENCE)." language="en" type="text/plain" modelElement="Class_library.Loan"/>
    <feature xsi:type="core:Attribute" xmi:id="Attribute_library.Loan.id" name="id" type="DataType_library.long"/>
  </ownedElement>
  <ownedElement xsi:type="core:Class" xmi:id="Class_library.Reservation" name="Reservation">
    <ownedElement xsi:type="businessinformation:Description" xmi:id="Description_library.Reservation.Doc_Reservation" name="Doc_Reservation" body="Reservation — number from the generator table ID_GEN (TABLE)." language="en" type="text/plain" modelElement="Class_library.Reservation"/>
    <feature xsi:type="core:Attribute" xmi:id="Attribute_library.Reservation.id" name="id" type="DataType_library.long"/>
  </ownedElement>
  <ownedElement xsi:type="core:Class" xmi:id="Class_library.Note" name="Note">
    <ownedElement xsi:type="businessinformation:Description" xmi:id="Description_library.Note.Doc_Note" name="Doc_Note" body="Note — UUID key, generated by the provider (UUID)." language="en" type="text/plain" modelElement="Class_library.Note"/>
