  <ownedElement xsi:type="core:Class" xmi:id="Class_library.Member" name="Member">
    <ownedElement xsi:type="businessinformation:Description" xmi:id="Description_library.Member.Doc_Member" name="Doc_Member" body="Member — the card number comes from the database (IDENTITY)." language="en" type="text/plain" modelElement="Class_library.Member"/>
    <feature xsi:type="core:Attribute" xmi:id="Attribute_library.Member.id" name="id" type="DataType_library.long"/>
  </ownedElement>
  <ownedElement xsi:type="core:DataType" xmi:id="DataType_library.long" name="long"/>
