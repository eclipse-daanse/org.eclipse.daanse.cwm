    <feature xsi:type="core:Attribute" xmi:id="Attribute_library.Media.title" name="title" type="DataType_library.String"/>
  </ownedElement>
  <ownedElement xsi:type="core:DataType" xmi:id="DataType_library.long" name="long"/>
