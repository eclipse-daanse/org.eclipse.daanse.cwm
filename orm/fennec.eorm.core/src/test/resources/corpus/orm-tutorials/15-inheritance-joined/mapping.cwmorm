<?xml version="1.0" encoding="UTF-8"?>
<orm:EntityMappings xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:orm="https://www.daanse.org/spec/org.eclipse.daanse.cwm.model.daanse.orm" xmi:id="EntityMappings_library" name="library" description="JOINED hierarchy.">
  <entity xmi:id="Entity_library.Media" name="Media" description="Root with its own table and strategy JOINED." inheritanceStrategy="JOINED">
    <cwmClass href="objects.xmi#Class_library.Media"/>
    <basic xmi:id="Basic_library.Media.title" name="title">
      <cwmAttribute href="objects.xmi#Attribute_library.Media.title"/>
      <column xmi:id="Column_library.Media.title.TITLE" name="TITLE">
        <cwmColumn href="catalog.xmi#Column_LIBRARYDB.LIB.MEDIA.TITLE"/>
      </column>
    </basic>
    <id xmi:id="Id_library.Media.id" name="id">
      <cwmAttribute href="objects.xmi#Attribute_library.Media.id"/>
      <column xmi:id="Column_library.Media.id.ID" name="ID">
        <cwmColumn href="catalog.xmi#Column_LIBRARYDB.LIB.MEDIA.ID"/>
      </column>
    </id>
    <cwmTable href="catalog.xmi#Table_LIBRARYDB.LIB.MEDIA"/>
    <cwmDiscriminatorColumn href="catalog.xmi#Column_LIBRARYDB.LIB.MEDIA.MEDIA_TYPE"/>
  </entity>
  <entity xmi:id="Entity_library.Book" name="Book" description="Subclass entity with a table of its OWN; its primaryKeyJoin follows the catalog constraint FK_BOOK_MEDIA (BOOK.ID -> MEDIA.ID)." discriminatorValue="BOOK">
    <cwmClass href="objects.xmi#Class_library.Book"/>
    <basic xmi:id="Basic_library.Book.pages" name="pages">
      <cwmAttribute href="objects.xmi#Attribute_library.Book.pages"/>
      <column xmi:id="Column_library.Book.pages.PAGES" name="PAGES">
        <cwmColumn href="catalog.xmi#Column_LIBRARYDB.LIB.BOOK.PAGES"/>
      </column>
    </basic>
    <cwmTable href="catalog.xmi#Table_LIBRARYDB.LIB.BOOK"/>
    <primaryKeyJoin xmi:id="Join_library.Book.FK_BOOK_MEDIA" name="FK_BOOK_MEDIA">
      <cwmForeignKey href="catalog.xmi#ForeignKey_LIBRARYDB.LIB.BOOK.FK_BOOK_MEDIA"/>
    </primaryKeyJoin>
  </entity>
  <entity xmi:id="Entity_library.Dvd" name="Dvd" description="Subclass entity with a table of its OWN; its primaryKeyJoin follows the catalog constraint FK_DVD_MEDIA (DVD.ID -> MEDIA.ID)." discriminatorValue="DVD">
    <cwmClass href="objects.xmi#Class_library.Dvd"/>
    <basic xmi:id="Basic_library.Dvd.minutes" name="minutes">
      <cwmAttribute href="objects.xmi#Attribute_library.Dvd.minutes"/>
      <column xmi:id="Column_library.Dvd.minutes.MINUTES" name="MINUTES">
        <cwmColumn href="catalog.xmi#Column_LIBRARYDB.LIB.DVD.MINUTES"/>
      </column>
    </basic>
    <cwmTable href="catalog.xmi#Table_LIBRARYDB.LIB.DVD"/>
    <primaryKeyJoin xmi:id="Join_library.Dvd.FK_DVD_MEDIA" name="FK_DVD_MEDIA">
      <cwmForeignKey href="catalog.xmi#ForeignKey_LIBRARYDB.LIB.DVD.FK_DVD_MEDIA"/>
    </primaryKeyJoin>
  </entity>
</orm:EntityMappings>
