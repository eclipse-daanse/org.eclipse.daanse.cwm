<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.daanse</groupId>
    <artifactId>org.eclipse.daanse.cwm</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>org.eclipse.daanse.cwm.orm</artifactId>
  <packaging>pom</packaging>
  <name>Daanse CWM ORM (aggregator)</name>
  <description>Object/Relational mapping tooling: fennec.eorm.core converts a CWM-ORM mapping
    into the Fennec Persistence EORM model (.eorm); its Maven goal fennec-eorm:generate lives in
    maven/eorm.</description>

  <properties>
    <!-- Fennec Persistence is published as snapshot only (Sonatype Central snapshots) -->
    <fennec.persistence.version>0.1.0-SNAPSHOT</fennec.persistence.version>
  </properties>

  <modules>
    <module>fennec.eorm.core</module>
  </modules>
</project>
