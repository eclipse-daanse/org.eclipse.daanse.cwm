<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.daanse</groupId>
    <artifactId>org.eclipse.daanse.cwm</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>org.eclipse.daanse.cwm.examples</artifactId>
  <packaging>pom</packaging>
  <name>Daanse CWM Examples (aggregator)</name>
  <description>Plain Java programs that show the CWM tooling end to end, without OSGi and without a
    Maven plugin, started from the IDE: jdbc.roundtrip writes a CWM model held in Java code into
    PostgreSQL and, a part chosen by rules, into DuckDB, reads it back and compares.</description>
  <modules>
    <module>jdbc.roundtrip</module>
  </modules>
</project>
