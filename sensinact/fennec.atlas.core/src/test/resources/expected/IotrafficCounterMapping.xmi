<?xml version="1.0" encoding="UTF-8"?>
<mapping:ProviderMapping
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:mapping="https://fennec.eclipse.org/event.atlas/mapping/1.0"
    mid="iotraffic-counter">
  <timestamp>
    <featurePath xsi:type="ecore:EAttribute" href="https://eclipse.org/fennec/lorawan/iotraffic#//IotrafficUplink/time"/>
  </timestamp>
  <name>
    <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//IotrafficUplink/deviceInfo"/>
    <featurePath xsi:type="ecore:EAttribute" href="https://eclipse.org/fennec/lorawan/iotraffic#//DeviceInfo/devEui"/>
  </name>
  <providerClasses href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterUplink"/>
  <profile href="iotraffic-camera-profile.xmi#iotraffic-camera"/>
  <services mid="window">
    <name name="Reporting window"/>
    <resources name="From" mid="from" timestamp="//@timestamp">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <valueFeature xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterUplink/object"/>
      <valueFeature xsi:type="ecore:EAttribute" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterData/from_time_text"/>
    </resources>
    <resources name="To" mid="to" timestamp="//@timestamp">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <valueFeature xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterUplink/object"/>
      <valueFeature xsi:type="ecore:EAttribute" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterData/to_time_text"/>
    </resources>
  </services>
  <!-- One service per configured line. The filter, not a position, is what picks it:
       the camera writes its lines in no fixed order and splits them over several uplinks,
       so a service whose line this uplink does not carry is simply skipped. -->
  <services mid="line1">
    <name name="Line 1"/>
    <referencedResource xsi:type="mapping:ReferenceMapping" collectionFilter="key=line_1">
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterUplink/object"/>
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterData/lines"/>
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//LineEntry/value"/>
    </referencedResource>
  </services>
  <!-- One service per configured line. The filter, not a position, is what picks it:
       the camera writes its lines in no fixed order and splits them over several uplinks,
       so a service whose line this uplink does not carry is simply skipped. -->
  <services mid="line2">
    <name name="Line 2"/>
    <referencedResource xsi:type="mapping:ReferenceMapping" collectionFilter="key=line_2">
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterUplink/object"/>
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterData/lines"/>
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//LineEntry/value"/>
    </referencedResource>
  </services>
  <!-- One service per configured line. The filter, not a position, is what picks it:
       the camera writes its lines in no fixed order and splits them over several uplinks,
       so a service whose line this uplink does not carry is simply skipped. -->
  <services mid="line3">
    <name name="Line 3"/>
    <referencedResource xsi:type="mapping:ReferenceMapping" collectionFilter="key=line_3">
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterUplink/object"/>
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//CounterData/lines"/>
      <featurePath xsi:type="ecore:EReference" href="https://eclipse.org/fennec/lorawan/iotraffic#//LineEntry/value"/>
    </referencedResource>
  </services>
  <!-- One service per configured line. The filter, not a position, is what picks it:
       the camera writes its lines in no fixed order and splits them over several uplinks,
       so a service whose line this uplink does not carry is simply skipped. -->
  <services mid="line4">
